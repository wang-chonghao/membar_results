#define __aicore__ [aicore]

__attribute__((always_inline)) inline [aicore] void gelu_grad_vf(
    __ubuf__ float *dy, __ubuf__ float *x, __ubuf__ float *out,
    __ubuf__ float *scratch_e, __ubuf__ float *scratch_d, __ubuf__ float *scratch_resp,
    __ubuf__ float *x_second, __ubuf__ float *scratch_e_read, __ubuf__ float *scratch_d_read,
    __ubuf__ float *scratch_resp_read, __ubuf__ float *scratch_d_tail) {
    __VEC_SCOPE__ {
        vector_bool p1 = pset_b32(PAT_ALL);
        vector_bool p2;
        vector_f32 v0, v1, v2, v3, v4;
        vdup(v0, 1.0f, p1, MODE_ZEROING);
        vdup(v1, -1.595769121605730711759f, p1, MODE_ZEROING);
        #pragma unroll(1)
        for (int i = 0; i < 64; ++i) {
            // Original loop body PCs: 0x13b3a21c..0x13b3a240.
            vlds(v2, x, 64, NORM, POST_UPDATE);
            vmul(v3, v2, v2, p1, MODE_ZEROING);
            vmov(v4, v1);
            vaxpy(v4, v3, -0.0713548162726002527220f, p1, MODE_ZEROING);
            vmul(v2, v4, v2, p1, MODE_ZEROING);
            vexp(v2, v2, p1, MODE_ZEROING);
            vadds(v3, v2, 1.0f, p1, MODE_ZEROING);
            vdiv(v3, v0, v3, p1, MODE_ZEROING);
            vsts(v2, scratch_e, 64, NORM_B32, p1, POST_UPDATE);
            vsts(v3, scratch_d, 64, NORM_B32, p1, POST_UPDATE);
        }
        mem_bar(VST_VLD);
        vdup(v0, 1.595769121605730711759f, p1, MODE_ZEROING);
        #pragma unroll(1)
        for (int j = 0; j < 64; ++j) {
            // Original loop body PCs: 0x13b3a260..0x13b3a288.
            vlds(v1, x_second, 64, NORM, POST_UPDATE);
            vmul(v2, v1, v1, p1, MODE_ZEROING);
            vmov(v3, v0);
            vaxpy(v3, v2, 0.2140644488178007f, p1, MODE_ZEROING);
            vmul(v1, v3, v1, p1, MODE_ZEROING);
            vlds(v2, scratch_e_read, 64, NORM, POST_UPDATE);
            vlds(v3, scratch_d_read, 64, NORM, POST_UPDATE);
            vmul(v2, v2, v3, p1, MODE_ZEROING);
            vmul(v1, v2, v1, p1, MODE_ZEROING);
            vmul(v1, v1, v3, p1, MODE_ZEROING);
            vsts(v1, scratch_resp, 64, NORM_B32, p1, POST_UPDATE);
        }
        mem_bar(VST_VLD);
        vdup(v0, 0.0f, p1, MODE_ZEROING);
        #pragma unroll(1)
        for (int k = 0; k < 64; ++k) {
            // Original loop body PCs: 0x13b3a2a8..0x13b3a2c4.
            vlds(v1, scratch_resp_read, 64, NORM, POST_UPDATE);
            vcmp_eq(p2, v1, v1, p1);
            vsel(v1, v1, v0, p2);
            vlds(v2, scratch_d_tail, 64, NORM, POST_UPDATE);
            vadd(v1, v1, v2, p1, MODE_ZEROING);
            vlds(v2, dy, 64, NORM, POST_UPDATE);
            vmul(v1, v2, v1, p1, MODE_ZEROING);
            vsts(v1, out, 64, NORM_B32, p1, POST_UPDATE);
        }
    }
}

extern "C" __global__ __aicore__ void gelu_grad_fp32(
    __gm__ float *input, __gm__ float *output) {
    __ubuf__ float *dy = (__ubuf__ float *)get_imm(0);
    __ubuf__ float *x = (__ubuf__ float *)get_imm(0x4000);
    __ubuf__ float *out = (__ubuf__ float *)get_imm(0x8000);
    copy_gm_to_ubuf_align_v2(dy, input, 0, 1, 32768, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    gelu_grad_vf(dy, x, out, (__ubuf__ float *)get_imm(0xc000),
                (__ubuf__ float *)get_imm(0x10000), (__ubuf__ float *)get_imm(0x14000),
                x, (__ubuf__ float *)get_imm(0xc000), (__ubuf__ float *)get_imm(0x10000),
                (__ubuf__ float *)get_imm(0x14000), (__ubuf__ float *)get_imm(0x10000));
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output, out, 0, 1, 16384, 0, 0, 0);
}
