__aicore__ inline void candidate_vf(__ubuf__ float* src0Addr, __ubuf__ float* src1Addr,
                                    __ubuf__ float* dstAddr) {
    __ubuf__ uint8_t* arena = (__ubuf__ uint8_t*)get_imm(0);
    __VEC_SCOPE__ {
        vector_bool r0;
        vector_f32 r1;
        vector_f32 r2;
        vector_bool r3;
        vector_bool r4;
        vector_bool r5;
        vector_bool r6;
        vector_f32 r7;
        vector_f32 r8;
        vector_f32 r9;
        vector_f32 r10;
        vector_f32 r11;
