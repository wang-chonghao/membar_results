        vector_f32 r42;
        vector_f32 r43;
        vector_f32 r44;
        vector_f32 r45;
        vector_f32 r46;
        r0 = pset_b32(PAT_ALL);
        vdup(r1, 0x1.0000000000000p+0f, r0, MODE_ZEROING);
        vdup(r2, 0x0.0p+0f, r0, MODE_ZEROING);
        uint32_t mask_remaining_s0_0 = 3072;
#pragma unroll 1
        for (uint16_t iter_s0_0 = 0; iter_s0_0 < 12; ++iter_s0_0) {
            r3 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r4 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r5 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r6 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            vlds(r7, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 0))), 0, NORM);
            vlds(r8, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 1))), 0, NORM);
            vlds(r9, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 2))), 0, NORM);
            vlds(r10, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 3))), 0, NORM);
            vlds(r11, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 0))), 0, NORM);
            vlds(r12, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 1))), 0, NORM);
            vlds(r13, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 2))), 0, NORM);
            vlds(r14, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 3))), 0, NORM);
            vabs(r15, r11, r3, MODE_ZEROING);
            vabs(r16, r12, r4, MODE_ZEROING);
            vabs(r17, r13, r5, MODE_ZEROING);
            vabs(r18, r14, r6, MODE_ZEROING);
            vmuls(r19, r15, -0x1.0000000000000p+0f, r3, MODE_ZEROING);
            vmuls(r20, r16, -0x1.0000000000000p+0f, r4, MODE_ZEROING);
            vmuls(r21, r17, -0x1.0000000000000p+0f, r5, MODE_ZEROING);
            vmuls(r22, r18, -0x1.0000000000000p+0f, r6, MODE_ZEROING);
            vexp(r23, r19, r3, MODE_ZEROING);
            vexp(r24, r20, r4, MODE_ZEROING);
            vexp(r25, r21, r5, MODE_ZEROING);
            vexp(r26, r22, r6, MODE_ZEROING);
            vadds(r27, r23, 0x1.0000000000000p+0f, r3, MODE_ZEROING);
            vadds(r28, r24, 0x1.0000000000000p+0f, r4, MODE_ZEROING);
            vadds(r29, r25, 0x1.0000000000000p+0f, r5, MODE_ZEROING);
            vadds(r30, r26, 0x1.0000000000000p+0f, r6, MODE_ZEROING);
            vcmp_lt(r31, r11, r2, r3);
            vcmp_lt(r32, r12, r2, r4);
            vcmp_lt(r33, r13, r2, r5);
            vcmp_lt(r34, r14, r2, r6);
            vsel(r35, r1, r23, r31);
            vsel(r36, r1, r24, r32);
            vsel(r37, r1, r25, r33);
            vsel(r38, r1, r26, r34);
            vdiv(r39, r35, r27, r3, MODE_ZEROING);
            vdiv(r40, r36, r28, r4, MODE_ZEROING);
            vdiv(r41, r37, r29, r5, MODE_ZEROING);
            vdiv(r42, r38, r30, r6, MODE_ZEROING);
            vmul(r43, r39, r7, r3, MODE_ZEROING);
            vmul(r44, r40, r8, r4, MODE_ZEROING);
            vmul(r45, r41, r9, r5, MODE_ZEROING);
            vmul(r46, r42, r10, r6, MODE_ZEROING);
            vsts(r43, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 0))), 0,
                 NORM_B32, r3);
            vsts(r44, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 1))), 0,
                 NORM_B32, r4);
            vsts(r45, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 2))), 0,
                 NORM_B32, r5);
            vsts(r46, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 3))), 0,
                 NORM_B32, r6);
        }
    }
}

extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* src0Addr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* src1Addr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dstAddr = (__ubuf__ float*)get_imm(24576);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 24576, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(src0Addr, src1Addr, dstAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dstAddr, 0, 1, 12288, 0, 0, 0);
}
