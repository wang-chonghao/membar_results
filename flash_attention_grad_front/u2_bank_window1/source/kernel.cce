#define __aicore__ [aicore]
// CastAligned768F32VF768: eight independent rows, preserve its add tree.
__attribute__((always_inline)) inline [aicore] void candidate_vf(
    __ubuf__ float *src, __ubuf__ float *grad, __ubuf__ float *dst) {
    __ubuf__ float *s0 = src + 0;
    __ubuf__ float *g0 = grad + 0;
    __ubuf__ float *s1 = src + 64;
    __ubuf__ float *g1 = grad + 64;
    __ubuf__ float *s2 = src + 128;
    __ubuf__ float *g2 = grad + 128;
    __ubuf__ float *s3 = src + 192;
    __ubuf__ float *g3 = grad + 192;
    __ubuf__ float *s4 = src + 256;
    __ubuf__ float *g4 = grad + 256;
    __ubuf__ float *s5 = src + 320;
    __ubuf__ float *g5 = grad + 320;
    __ubuf__ float *s6 = src + 384;
    __ubuf__ float *g6 = grad + 384;
    __ubuf__ float *s7 = src + 448;
    __ubuf__ float *g7 = grad + 448;
    __ubuf__ float *s8 = src + 512;
    __ubuf__ float *g8 = grad + 512;
    __ubuf__ float *s9 = src + 576;
    __ubuf__ float *g9 = grad + 576;
    __ubuf__ float *s10 = src + 640;
    __ubuf__ float *g10 = grad + 640;
    __ubuf__ float *s11 = src + 704;
    __ubuf__ float *g11 = grad + 704;
    __VEC_SCOPE__ {
        vector_bool all = pset_b32(PAT_ALL);
        vector_align state;
        vector_f32 vs0_lane0, vs1_lane0, vs2_lane0, vs3_lane0, vs4_lane0, vs5_lane0, vs6_lane0, vs7_lane0, vs8_lane0, vs9_lane0, vs10_lane0, vs11_lane0, vg0_lane0, vg1_lane0, vg2_lane0, vg3_lane0, vg4_lane0, vg5_lane0, vg6_lane0, vg7_lane0, vg8_lane0, vg9_lane0, vg10_lane0, vg11_lane0, mul0_lane0, mul1_lane0, mul2_lane0, mul3_lane0, mul4_lane0, mul5_lane0, mul6_lane0, mul7_lane0, mul8_lane0, mul9_lane0, mul10_lane0, mul11_lane0, add0_lane0, add1_lane0, add2_lane0, add3_lane0, add4_lane0, add5_lane0, add6_lane0, add7_lane0, add8_lane0, add9_lane0, add10_lane0, sum_lane0, vs0_lane1, vs1_lane1, vs2_lane1, vs3_lane1, vs4_lane1, vs5_lane1, vs6_lane1, vs7_lane1, vs8_lane1, vs9_lane1, vs10_lane1, vs11_lane1, vg0_lane1, vg1_lane1, vg2_lane1, vg3_lane1, vg4_lane1, vg5_lane1, vg6_lane1, vg7_lane1, vg8_lane1, vg9_lane1, vg10_lane1, vg11_lane1, mul0_lane1, mul1_lane1, mul2_lane1, mul3_lane1, mul4_lane1, mul5_lane1, mul6_lane1, mul7_lane1, mul8_lane1, mul9_lane1, mul10_lane1, mul11_lane1, add0_lane1, add1_lane1, add2_lane1, add3_lane1, add4_lane1, add5_lane1, add6_lane1, add7_lane1, add8_lane1, add9_lane1, add10_lane1, sum_lane1;
        #pragma unroll(1)
        for (int row = 0; row < 4; ++row) {
            vlds(vs0_lane0, s0, 768, NORM, POST_UPDATE);
            vlds(vs11_lane0, s11, 768, NORM, POST_UPDATE);
            vlds(vg0_lane0, g0, 768, NORM, POST_UPDATE);
            vlds(vg11_lane0, g11, 768, NORM, POST_UPDATE);
            vlds(vs0_lane1, s0, 768, NORM, POST_UPDATE);
            vlds(vs11_lane1, s11, 768, NORM, POST_UPDATE);
            vlds(vg0_lane1, g0, 768, NORM, POST_UPDATE);
            vlds(vg11_lane1, g11, 768, NORM, POST_UPDATE);
            vmul(mul0_lane0, vg0_lane0, vs0_lane0, all, MODE_ZEROING);
            vmul(mul11_lane0, vg11_lane0, vs11_lane0, all, MODE_ZEROING);
            vadd(add0_lane0, mul0_lane0, mul11_lane0, all, MODE_ZEROING);
            vmul(mul0_lane1, vg0_lane1, vs0_lane1, all, MODE_ZEROING);
            vmul(mul11_lane1, vg11_lane1, vs11_lane1, all, MODE_ZEROING);
            vadd(add0_lane1, mul0_lane1, mul11_lane1, all, MODE_ZEROING);
            vlds(vs6_lane0, s6, 768, NORM, POST_UPDATE);
            vlds(vs5_lane0, s5, 768, NORM, POST_UPDATE);
            vlds(vg6_lane0, g6, 768, NORM, POST_UPDATE);
            vlds(vg5_lane0, g5, 768, NORM, POST_UPDATE);
            vlds(vs6_lane1, s6, 768, NORM, POST_UPDATE);
            vlds(vs5_lane1, s5, 768, NORM, POST_UPDATE);
            vlds(vg6_lane1, g6, 768, NORM, POST_UPDATE);
            vlds(vg5_lane1, g5, 768, NORM, POST_UPDATE);
            vmul(mul5_lane0, vg5_lane0, vs5_lane0, all, MODE_ZEROING);
            vmul(mul6_lane0, vg6_lane0, vs6_lane0, all, MODE_ZEROING);
            vadd(add5_lane0, mul5_lane0, mul6_lane0, all, MODE_ZEROING);
            vmul(mul5_lane1, vg5_lane1, vs5_lane1, all, MODE_ZEROING);
            vmul(mul6_lane1, vg6_lane1, vs6_lane1, all, MODE_ZEROING);
            vadd(add5_lane1, mul5_lane1, mul6_lane1, all, MODE_ZEROING);
            vadd(add6_lane0, add0_lane0, add5_lane0, all, MODE_ZEROING);
            vadd(add6_lane1, add0_lane1, add5_lane1, all, MODE_ZEROING);
            vlds(vs2_lane0, s2, 768, NORM, POST_UPDATE);
            vlds(vs9_lane0, s9, 768, NORM, POST_UPDATE);
            vlds(vg2_lane0, g2, 768, NORM, POST_UPDATE);
            vlds(vg9_lane0, g9, 768, NORM, POST_UPDATE);
            vlds(vs2_lane1, s2, 768, NORM, POST_UPDATE);
            vlds(vs9_lane1, s9, 768, NORM, POST_UPDATE);
            vlds(vg2_lane1, g2, 768, NORM, POST_UPDATE);
            vlds(vg9_lane1, g9, 768, NORM, POST_UPDATE);
            vmul(mul2_lane0, vg2_lane0, vs2_lane0, all, MODE_ZEROING);
            vmul(mul9_lane0, vg9_lane0, vs9_lane0, all, MODE_ZEROING);
            vadd(add2_lane0, mul2_lane0, mul9_lane0, all, MODE_ZEROING);
            vmul(mul2_lane1, vg2_lane1, vs2_lane1, all, MODE_ZEROING);
            vmul(mul9_lane1, vg9_lane1, vs9_lane1, all, MODE_ZEROING);
            vadd(add2_lane1, mul2_lane1, mul9_lane1, all, MODE_ZEROING);
            vlds(vs8_lane0, s8, 768, NORM, POST_UPDATE);
            vlds(vs3_lane0, s3, 768, NORM, POST_UPDATE);
            vlds(vg8_lane0, g8, 768, NORM, POST_UPDATE);
            vlds(vg3_lane0, g3, 768, NORM, POST_UPDATE);
            vlds(vs8_lane1, s8, 768, NORM, POST_UPDATE);
            vlds(vs3_lane1, s3, 768, NORM, POST_UPDATE);
            vlds(vg8_lane1, g8, 768, NORM, POST_UPDATE);
            vlds(vg3_lane1, g3, 768, NORM, POST_UPDATE);
            vmul(mul3_lane0, vg3_lane0, vs3_lane0, all, MODE_ZEROING);
            vmul(mul8_lane0, vg8_lane0, vs8_lane0, all, MODE_ZEROING);
            vadd(add3_lane0, mul3_lane0, mul8_lane0, all, MODE_ZEROING);
            vmul(mul3_lane1, vg3_lane1, vs3_lane1, all, MODE_ZEROING);
            vmul(mul8_lane1, vg8_lane1, vs8_lane1, all, MODE_ZEROING);
            vadd(add3_lane1, mul3_lane1, mul8_lane1, all, MODE_ZEROING);
            vadd(add8_lane0, add2_lane0, add3_lane0, all, MODE_ZEROING);
            vadd(add8_lane1, add2_lane1, add3_lane1, all, MODE_ZEROING);
            vadd(add9_lane0, add6_lane0, add8_lane0, all, MODE_ZEROING);
            vadd(add9_lane1, add6_lane1, add8_lane1, all, MODE_ZEROING);
            vlds(vs10_lane0, s10, 768, NORM, POST_UPDATE);
            vlds(vs1_lane0, s1, 768, NORM, POST_UPDATE);
            vlds(vg10_lane0, g10, 768, NORM, POST_UPDATE);
            vlds(vg1_lane0, g1, 768, NORM, POST_UPDATE);
            vlds(vs10_lane1, s10, 768, NORM, POST_UPDATE);
            vlds(vs1_lane1, s1, 768, NORM, POST_UPDATE);
            vlds(vg10_lane1, g10, 768, NORM, POST_UPDATE);
            vlds(vg1_lane1, g1, 768, NORM, POST_UPDATE);
            vmul(mul1_lane0, vg1_lane0, vs1_lane0, all, MODE_ZEROING);
            vmul(mul10_lane0, vg10_lane0, vs10_lane0, all, MODE_ZEROING);
            vadd(add1_lane0, mul1_lane0, mul10_lane0, all, MODE_ZEROING);
            vmul(mul1_lane1, vg1_lane1, vs1_lane1, all, MODE_ZEROING);
            vmul(mul10_lane1, vg10_lane1, vs10_lane1, all, MODE_ZEROING);
            vadd(add1_lane1, mul1_lane1, mul10_lane1, all, MODE_ZEROING);
            vlds(vs4_lane0, s4, 768, NORM, POST_UPDATE);
            vlds(vs7_lane0, s7, 768, NORM, POST_UPDATE);
            vlds(vg4_lane0, g4, 768, NORM, POST_UPDATE);
            vlds(vg7_lane0, g7, 768, NORM, POST_UPDATE);
            vlds(vs4_lane1, s4, 768, NORM, POST_UPDATE);
            vlds(vs7_lane1, s7, 768, NORM, POST_UPDATE);
            vlds(vg4_lane1, g4, 768, NORM, POST_UPDATE);
            vlds(vg7_lane1, g7, 768, NORM, POST_UPDATE);
            vmul(mul4_lane0, vg4_lane0, vs4_lane0, all, MODE_ZEROING);
            vmul(mul7_lane0, vg7_lane0, vs7_lane0, all, MODE_ZEROING);
            vadd(add4_lane0, mul4_lane0, mul7_lane0, all, MODE_ZEROING);
            vmul(mul4_lane1, vg4_lane1, vs4_lane1, all, MODE_ZEROING);
            vmul(mul7_lane1, vg7_lane1, vs7_lane1, all, MODE_ZEROING);
            vadd(add4_lane1, mul4_lane1, mul7_lane1, all, MODE_ZEROING);
            vadd(add7_lane0, add1_lane0, add4_lane0, all, MODE_ZEROING);
            vadd(add7_lane1, add1_lane1, add4_lane1, all, MODE_ZEROING);
            vadd(add10_lane0, add9_lane0, add7_lane0, all, MODE_ZEROING);
            vadd(add10_lane1, add9_lane1, add7_lane1, all, MODE_ZEROING);
            vcadd(sum_lane0, add10_lane0, all, MODE_ZEROING);
            vcadd(sum_lane1, add10_lane1, all, MODE_ZEROING);
            vstus(state, 1, sum_lane0, dst, POST_UPDATE);
            vstus(state, 1, sum_lane1, dst, POST_UPDATE);
        }
        vstas(state, dst, 0, POST_UPDATE);
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ float *input, __gm__ float *output) {
    __ubuf__ float *src = (__ubuf__ float *)get_imm(0);
    __ubuf__ float *grad = (__ubuf__ float *)get_imm(0x8000);
    __ubuf__ float *dst = (__ubuf__ float *)get_imm(0x10000);
    copy_gm_to_ubuf_align_v2(src, input, 0, 1, 24576, 0, 0, 0, 0, 0, 0);
    copy_gm_to_ubuf_align_v2(grad, input + 6144, 0, 1, 24576, 0, 0, 0, 0, 0, 0);
    copy_gm_to_ubuf_align_v2(dst, input + 12288, 0, 1, 64, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(src, grad, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output, dst, 0, 1, 64, 0, 0, 0);
}
