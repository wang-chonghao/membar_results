/*
 * MHC VF 通用矩阵数测试：hc_mult 固定为 4，matrix_count 从 host 运行参数传入。
 * 总计 20 轮：初始化 softmax(0.5*mix+bias,行)+eps，再做列归一化；
 * 后续 19 轮依次做行除法、列除法，分母为对应和+eps，eps=1e-6。
 * element_major 额外先用 rms 做输入归一化；其结果原地紧凑写回 mix。
 * 输入记录步长 24 个 float，逐行输入行距 4 个 float，结果行距 8 个 float。
 * UB 缓冲区按矩阵数计算，只在缓冲区末尾留安全余量，不增加矩阵行填充。
 * element_major 外层 batch 手动展开系数为 2；仅支持矩阵数为 128 的整数倍。
 */
#include <type_traits>
#define __aicore__ [aicore]
inline [aicore] void candidate_vf(
    __ubuf__ float *mix,__ubuf__ float *rms,__ubuf__ float *base,
    float scale,float eps,float norm_eps,uint16_t iters,uint16_t rows) {
    if (rows == 0 || rows%128 != 0) return;
    uint16_t loops=rows/64;
    __VEC_SCOPE__ {
        vector_bool full_mask=pset_b32(PAT_ALL);
        vector_u32 lane,input_index,output_index;
        vci((vector_s32 &)lane,0,std::integral_constant<Order,static_cast<Order>(0)>());
        vmuls(input_index,lane,(uint32_t)24,full_mask,MODE_ZEROING);
        vmuls(output_index,lane,(uint32_t)16,full_mask,MODE_ZEROING);
        uint32_t remaining=rows;
        for (uint16_t batch=0;batch<loops;batch+=2) {
            vector_bool mask_a=plt_b32(remaining,POST_UPDATE);
            vector_f32 inv_rms_a,one_a,bias_a,maximum_a,tail_a,sum_a;
            vector_f32 a00,a01,a02,a03,a10,a11,a12,a13,a20,a21,a22,a23,a30,a31,a32,a33;
            __ubuf__ float *input_a=mix+(batch+0)*64*24;
            vector_bool mask_b=plt_b32(remaining,POST_UPDATE);
            vector_f32 inv_rms_b,one_b,bias_b,maximum_b,tail_b,sum_b;
            vector_f32 b00,b01,b02,b03,b10,b11,b12,b13,b20,b21,b22,b23,b30,b31,b32,b33;
            __ubuf__ float *input_b=mix+(batch+1)*64*24;
            vgather2((vector_s32 &)inv_rms_a,(__ubuf__ int32_t *)(rms+(batch+0)*64),lane,mask_a);
            vgather2((vector_s32 &)inv_rms_b,(__ubuf__ int32_t *)(rms+(batch+1)*64),lane,mask_b);
            vadds(inv_rms_a,inv_rms_a,norm_eps,mask_a,MODE_ZEROING);
            vadds(inv_rms_b,inv_rms_b,norm_eps,mask_b,MODE_ZEROING);
            vsqrt(inv_rms_a,inv_rms_a,mask_a,MODE_ZEROING);
            vsqrt(inv_rms_b,inv_rms_b,mask_b,MODE_ZEROING);
            vdup(one_a,1.0f,mask_a,MODE_ZEROING);
            vdup(one_b,1.0f,mask_b,MODE_ZEROING);
            vdiv(inv_rms_a,one_a,inv_rms_a,mask_a,MODE_ZEROING);
            vdiv(inv_rms_b,one_b,inv_rms_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a00,(__ubuf__ int32_t *)(input_a+8),input_index,mask_a);
            vgather2((vector_s32 &)b00,(__ubuf__ int32_t *)(input_b+8),input_index,mask_b);
            vlds(bias_a,base,0,BRC_B32);
            vlds(bias_b,base,0,BRC_B32);
            vmul(a00,a00,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b00,b00,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a00,a00,scale,mask_a,MODE_ZEROING);
            vmuls(b00,b00,scale,mask_b,MODE_ZEROING);
            vadd(a00,a00,bias_a,mask_a,MODE_ZEROING);
            vadd(b00,b00,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a01,(__ubuf__ int32_t *)(input_a+9),input_index,mask_a);
            vgather2((vector_s32 &)b01,(__ubuf__ int32_t *)(input_b+9),input_index,mask_b);
            vlds(bias_a,base,1,BRC_B32);
            vlds(bias_b,base,1,BRC_B32);
            vmul(a01,a01,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b01,b01,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a01,a01,scale,mask_a,MODE_ZEROING);
            vmuls(b01,b01,scale,mask_b,MODE_ZEROING);
            vadd(a01,a01,bias_a,mask_a,MODE_ZEROING);
            vadd(b01,b01,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a02,(__ubuf__ int32_t *)(input_a+10),input_index,mask_a);
            vgather2((vector_s32 &)b02,(__ubuf__ int32_t *)(input_b+10),input_index,mask_b);
            vlds(bias_a,base,2,BRC_B32);
            vlds(bias_b,base,2,BRC_B32);
            vmul(a02,a02,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b02,b02,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a02,a02,scale,mask_a,MODE_ZEROING);
            vmuls(b02,b02,scale,mask_b,MODE_ZEROING);
            vadd(a02,a02,bias_a,mask_a,MODE_ZEROING);
            vadd(b02,b02,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a03,(__ubuf__ int32_t *)(input_a+11),input_index,mask_a);
            vgather2((vector_s32 &)b03,(__ubuf__ int32_t *)(input_b+11),input_index,mask_b);
            vlds(bias_a,base,3,BRC_B32);
            vlds(bias_b,base,3,BRC_B32);
            vmul(a03,a03,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b03,b03,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a03,a03,scale,mask_a,MODE_ZEROING);
            vmuls(b03,b03,scale,mask_b,MODE_ZEROING);
            vadd(a03,a03,bias_a,mask_a,MODE_ZEROING);
            vadd(b03,b03,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a10,(__ubuf__ int32_t *)(input_a+12),input_index,mask_a);
            vgather2((vector_s32 &)b10,(__ubuf__ int32_t *)(input_b+12),input_index,mask_b);
            vlds(bias_a,base,8,BRC_B32);
            vlds(bias_b,base,8,BRC_B32);
            vmul(a10,a10,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b10,b10,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a10,a10,scale,mask_a,MODE_ZEROING);
            vmuls(b10,b10,scale,mask_b,MODE_ZEROING);
            vadd(a10,a10,bias_a,mask_a,MODE_ZEROING);
            vadd(b10,b10,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a11,(__ubuf__ int32_t *)(input_a+13),input_index,mask_a);
            vgather2((vector_s32 &)b11,(__ubuf__ int32_t *)(input_b+13),input_index,mask_b);
            vlds(bias_a,base,9,BRC_B32);
            vlds(bias_b,base,9,BRC_B32);
            vmul(a11,a11,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b11,b11,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a11,a11,scale,mask_a,MODE_ZEROING);
            vmuls(b11,b11,scale,mask_b,MODE_ZEROING);
            vadd(a11,a11,bias_a,mask_a,MODE_ZEROING);
            vadd(b11,b11,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a12,(__ubuf__ int32_t *)(input_a+14),input_index,mask_a);
            vgather2((vector_s32 &)b12,(__ubuf__ int32_t *)(input_b+14),input_index,mask_b);
            vlds(bias_a,base,10,BRC_B32);
            vlds(bias_b,base,10,BRC_B32);
            vmul(a12,a12,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b12,b12,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a12,a12,scale,mask_a,MODE_ZEROING);
            vmuls(b12,b12,scale,mask_b,MODE_ZEROING);
            vadd(a12,a12,bias_a,mask_a,MODE_ZEROING);
            vadd(b12,b12,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a13,(__ubuf__ int32_t *)(input_a+15),input_index,mask_a);
            vgather2((vector_s32 &)b13,(__ubuf__ int32_t *)(input_b+15),input_index,mask_b);
            vlds(bias_a,base,11,BRC_B32);
            vlds(bias_b,base,11,BRC_B32);
            vmul(a13,a13,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b13,b13,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a13,a13,scale,mask_a,MODE_ZEROING);
            vmuls(b13,b13,scale,mask_b,MODE_ZEROING);
            vadd(a13,a13,bias_a,mask_a,MODE_ZEROING);
            vadd(b13,b13,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a20,(__ubuf__ int32_t *)(input_a+16),input_index,mask_a);
            vgather2((vector_s32 &)b20,(__ubuf__ int32_t *)(input_b+16),input_index,mask_b);
            vlds(bias_a,base,16,BRC_B32);
            vlds(bias_b,base,16,BRC_B32);
            vmul(a20,a20,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b20,b20,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a20,a20,scale,mask_a,MODE_ZEROING);
            vmuls(b20,b20,scale,mask_b,MODE_ZEROING);
            vadd(a20,a20,bias_a,mask_a,MODE_ZEROING);
            vadd(b20,b20,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a21,(__ubuf__ int32_t *)(input_a+17),input_index,mask_a);
            vgather2((vector_s32 &)b21,(__ubuf__ int32_t *)(input_b+17),input_index,mask_b);
            vlds(bias_a,base,17,BRC_B32);
            vlds(bias_b,base,17,BRC_B32);
            vmul(a21,a21,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b21,b21,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a21,a21,scale,mask_a,MODE_ZEROING);
            vmuls(b21,b21,scale,mask_b,MODE_ZEROING);
            vadd(a21,a21,bias_a,mask_a,MODE_ZEROING);
            vadd(b21,b21,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a22,(__ubuf__ int32_t *)(input_a+18),input_index,mask_a);
            vgather2((vector_s32 &)b22,(__ubuf__ int32_t *)(input_b+18),input_index,mask_b);
            vlds(bias_a,base,18,BRC_B32);
            vlds(bias_b,base,18,BRC_B32);
            vmul(a22,a22,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b22,b22,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a22,a22,scale,mask_a,MODE_ZEROING);
            vmuls(b22,b22,scale,mask_b,MODE_ZEROING);
            vadd(a22,a22,bias_a,mask_a,MODE_ZEROING);
            vadd(b22,b22,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a23,(__ubuf__ int32_t *)(input_a+19),input_index,mask_a);
            vgather2((vector_s32 &)b23,(__ubuf__ int32_t *)(input_b+19),input_index,mask_b);
            vlds(bias_a,base,19,BRC_B32);
            vlds(bias_b,base,19,BRC_B32);
            vmul(a23,a23,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b23,b23,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a23,a23,scale,mask_a,MODE_ZEROING);
            vmuls(b23,b23,scale,mask_b,MODE_ZEROING);
            vadd(a23,a23,bias_a,mask_a,MODE_ZEROING);
            vadd(b23,b23,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a30,(__ubuf__ int32_t *)(input_a+20),input_index,mask_a);
            vgather2((vector_s32 &)b30,(__ubuf__ int32_t *)(input_b+20),input_index,mask_b);
            vlds(bias_a,base,24,BRC_B32);
            vlds(bias_b,base,24,BRC_B32);
            vmul(a30,a30,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b30,b30,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a30,a30,scale,mask_a,MODE_ZEROING);
            vmuls(b30,b30,scale,mask_b,MODE_ZEROING);
            vadd(a30,a30,bias_a,mask_a,MODE_ZEROING);
            vadd(b30,b30,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a31,(__ubuf__ int32_t *)(input_a+21),input_index,mask_a);
            vgather2((vector_s32 &)b31,(__ubuf__ int32_t *)(input_b+21),input_index,mask_b);
            vlds(bias_a,base,25,BRC_B32);
            vlds(bias_b,base,25,BRC_B32);
            vmul(a31,a31,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b31,b31,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a31,a31,scale,mask_a,MODE_ZEROING);
            vmuls(b31,b31,scale,mask_b,MODE_ZEROING);
            vadd(a31,a31,bias_a,mask_a,MODE_ZEROING);
            vadd(b31,b31,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a32,(__ubuf__ int32_t *)(input_a+22),input_index,mask_a);
            vgather2((vector_s32 &)b32,(__ubuf__ int32_t *)(input_b+22),input_index,mask_b);
            vlds(bias_a,base,26,BRC_B32);
            vlds(bias_b,base,26,BRC_B32);
            vmul(a32,a32,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b32,b32,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a32,a32,scale,mask_a,MODE_ZEROING);
            vmuls(b32,b32,scale,mask_b,MODE_ZEROING);
            vadd(a32,a32,bias_a,mask_a,MODE_ZEROING);
            vadd(b32,b32,bias_b,mask_b,MODE_ZEROING);
            vgather2((vector_s32 &)a33,(__ubuf__ int32_t *)(input_a+23),input_index,mask_a);
            vgather2((vector_s32 &)b33,(__ubuf__ int32_t *)(input_b+23),input_index,mask_b);
            vlds(bias_a,base,27,BRC_B32);
            vlds(bias_b,base,27,BRC_B32);
            vmul(a33,a33,inv_rms_a,mask_a,MODE_ZEROING);
            vmul(b33,b33,inv_rms_b,mask_b,MODE_ZEROING);
            vmuls(a33,a33,scale,mask_a,MODE_ZEROING);
            vmuls(b33,b33,scale,mask_b,MODE_ZEROING);
            vadd(a33,a33,bias_a,mask_a,MODE_ZEROING);
            vadd(b33,b33,bias_b,mask_b,MODE_ZEROING);
            vmax(maximum_a,a00,a01,mask_a,MODE_ZEROING);
            vmax(maximum_b,b00,b01,mask_b,MODE_ZEROING);
            vmax(tail_a,a02,a03,mask_a,MODE_ZEROING);
            vmax(tail_b,b02,b03,mask_b,MODE_ZEROING);
            vmax(maximum_a,maximum_a,tail_a,mask_a,MODE_ZEROING);
            vmax(maximum_b,maximum_b,tail_b,mask_b,MODE_ZEROING);
            vsub(a00,a00,maximum_a,mask_a,MODE_ZEROING);
            vsub(b00,b00,maximum_b,mask_b,MODE_ZEROING);
            vsub(a01,a01,maximum_a,mask_a,MODE_ZEROING);
            vsub(b01,b01,maximum_b,mask_b,MODE_ZEROING);
            vsub(a02,a02,maximum_a,mask_a,MODE_ZEROING);
            vsub(b02,b02,maximum_b,mask_b,MODE_ZEROING);
            vsub(a03,a03,maximum_a,mask_a,MODE_ZEROING);
            vsub(b03,b03,maximum_b,mask_b,MODE_ZEROING);
            vexp(a00,a00,mask_a,MODE_ZEROING);
            vexp(b00,b00,mask_b,MODE_ZEROING);
            vexp(a01,a01,mask_a,MODE_ZEROING);
            vexp(b01,b01,mask_b,MODE_ZEROING);
            vexp(a02,a02,mask_a,MODE_ZEROING);
            vexp(b02,b02,mask_b,MODE_ZEROING);
            vexp(a03,a03,mask_a,MODE_ZEROING);
            vexp(b03,b03,mask_b,MODE_ZEROING);
            vadd(sum_a,a00,a01,mask_a,MODE_ZEROING);
            vadd(sum_b,b00,b01,mask_b,MODE_ZEROING);
            vadd(tail_a,a02,a03,mask_a,MODE_ZEROING);
            vadd(tail_b,b02,b03,mask_b,MODE_ZEROING);
            vadd(sum_a,sum_a,tail_a,mask_a,MODE_ZEROING);
            vadd(sum_b,sum_b,tail_b,mask_b,MODE_ZEROING);
            vdiv(a00,a00,sum_a,mask_a,MODE_ZEROING);
            vdiv(b00,b00,sum_b,mask_b,MODE_ZEROING);
            vdiv(a01,a01,sum_a,mask_a,MODE_ZEROING);
            vdiv(b01,b01,sum_b,mask_b,MODE_ZEROING);
            vdiv(a02,a02,sum_a,mask_a,MODE_ZEROING);
            vdiv(b02,b02,sum_b,mask_b,MODE_ZEROING);
            vdiv(a03,a03,sum_a,mask_a,MODE_ZEROING);
            vdiv(b03,b03,sum_b,mask_b,MODE_ZEROING);
            vadds(a00,a00,eps,mask_a,MODE_ZEROING);
            vadds(b00,b00,eps,mask_b,MODE_ZEROING);
            vadds(a01,a01,eps,mask_a,MODE_ZEROING);
            vadds(b01,b01,eps,mask_b,MODE_ZEROING);
            vadds(a02,a02,eps,mask_a,MODE_ZEROING);
            vadds(b02,b02,eps,mask_b,MODE_ZEROING);
            vadds(a03,a03,eps,mask_a,MODE_ZEROING);
            vadds(b03,b03,eps,mask_b,MODE_ZEROING);
            vmax(maximum_a,a10,a11,mask_a,MODE_ZEROING);
            vmax(maximum_b,b10,b11,mask_b,MODE_ZEROING);
            vmax(tail_a,a12,a13,mask_a,MODE_ZEROING);
            vmax(tail_b,b12,b13,mask_b,MODE_ZEROING);
            vmax(maximum_a,maximum_a,tail_a,mask_a,MODE_ZEROING);
            vmax(maximum_b,maximum_b,tail_b,mask_b,MODE_ZEROING);
            vsub(a10,a10,maximum_a,mask_a,MODE_ZEROING);
            vsub(b10,b10,maximum_b,mask_b,MODE_ZEROING);
            vsub(a11,a11,maximum_a,mask_a,MODE_ZEROING);
            vsub(b11,b11,maximum_b,mask_b,MODE_ZEROING);
            vsub(a12,a12,maximum_a,mask_a,MODE_ZEROING);
            vsub(b12,b12,maximum_b,mask_b,MODE_ZEROING);
            vsub(a13,a13,maximum_a,mask_a,MODE_ZEROING);
            vsub(b13,b13,maximum_b,mask_b,MODE_ZEROING);
            vexp(a10,a10,mask_a,MODE_ZEROING);
            vexp(b10,b10,mask_b,MODE_ZEROING);
            vexp(a11,a11,mask_a,MODE_ZEROING);
            vexp(b11,b11,mask_b,MODE_ZEROING);
            vexp(a12,a12,mask_a,MODE_ZEROING);
            vexp(b12,b12,mask_b,MODE_ZEROING);
            vexp(a13,a13,mask_a,MODE_ZEROING);
            vexp(b13,b13,mask_b,MODE_ZEROING);
            vadd(sum_a,a10,a11,mask_a,MODE_ZEROING);
            vadd(sum_b,b10,b11,mask_b,MODE_ZEROING);
            vadd(tail_a,a12,a13,mask_a,MODE_ZEROING);
            vadd(tail_b,b12,b13,mask_b,MODE_ZEROING);
            vadd(sum_a,sum_a,tail_a,mask_a,MODE_ZEROING);
            vadd(sum_b,sum_b,tail_b,mask_b,MODE_ZEROING);
            vdiv(a10,a10,sum_a,mask_a,MODE_ZEROING);
            vdiv(b10,b10,sum_b,mask_b,MODE_ZEROING);
            vdiv(a11,a11,sum_a,mask_a,MODE_ZEROING);
            vdiv(b11,b11,sum_b,mask_b,MODE_ZEROING);
            vdiv(a12,a12,sum_a,mask_a,MODE_ZEROING);
            vdiv(b12,b12,sum_b,mask_b,MODE_ZEROING);
            vdiv(a13,a13,sum_a,mask_a,MODE_ZEROING);
            vdiv(b13,b13,sum_b,mask_b,MODE_ZEROING);
            vadds(a10,a10,eps,mask_a,MODE_ZEROING);
            vadds(b10,b10,eps,mask_b,MODE_ZEROING);
            vadds(a11,a11,eps,mask_a,MODE_ZEROING);
            vadds(b11,b11,eps,mask_b,MODE_ZEROING);
            vadds(a12,a12,eps,mask_a,MODE_ZEROING);
            vadds(b12,b12,eps,mask_b,MODE_ZEROING);
            vadds(a13,a13,eps,mask_a,MODE_ZEROING);
            vadds(b13,b13,eps,mask_b,MODE_ZEROING);
            vmax(maximum_a,a20,a21,mask_a,MODE_ZEROING);
            vmax(maximum_b,b20,b21,mask_b,MODE_ZEROING);
            vmax(tail_a,a22,a23,mask_a,MODE_ZEROING);
            vmax(tail_b,b22,b23,mask_b,MODE_ZEROING);
            vmax(maximum_a,maximum_a,tail_a,mask_a,MODE_ZEROING);
            vmax(maximum_b,maximum_b,tail_b,mask_b,MODE_ZEROING);
            vsub(a20,a20,maximum_a,mask_a,MODE_ZEROING);
            vsub(b20,b20,maximum_b,mask_b,MODE_ZEROING);
            vsub(a21,a21,maximum_a,mask_a,MODE_ZEROING);
            vsub(b21,b21,maximum_b,mask_b,MODE_ZEROING);
