            // mem_bar(VST_VLD); // original PC 0x13b4c630: RV_SMEM_BAR
            vlds(r1, base_40000_4, -712, NORM); // original PC 0x13b4c634: RV_VLDI
            vmul(r0, r0, r1, p1); // original PC 0x13b4c638: RV_VMUL
            vsts(r9, base_18000_4, 0 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c63c: RV_VST
            vsts(r10, base_18000_4, 64 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c640: RV_VST
            vsts(r11, base_18000_4, 128 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c644: RV_VST
            vsts(r12, base_18000_4, 192 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c648: RV_VST
            vsts(r13, base_18000_4, 256 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c64c: RV_VST
            vsts(r14, base_18000_4, 320 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c650: RV_VST
            vsts(r15, base_18000_4, 384 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c654: RV_VST
            vsts(r16, base_18000_4, 448 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c658: RV_VST
            vsts(r17, base_20000_4, 0 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c65c: RV_VST
            vsts(r2, base_20000_4, 64 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c660: RV_VST
            vsts(r3, base_20000_4, 128 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c664: RV_VST
            vsts(r4, base_20000_4, 192 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c668: RV_VST
            vsts(r5, base_20000_4, 256 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c66c: RV_VST
            vsts(r6, base_20000_4, 320 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c670: RV_VST
            vsts(r7, base_20000_4, 384 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c674: RV_VST
            vsts(r0, base_20000_4, 448 + 512 * iteration, NORM_B32, p1); // original PC 0x13b4c678: RV_VST
        }
    }
}
extern "C" __global__ __aicore__ void swiglu_grad_kernel(
    __gm__ float *inputA, __gm__ float *inputB, __gm__ float *inputGrad,
    __gm__ float *outputDA, __gm__ float *outputDB)
{
    __ubuf__ float *memA = (__ubuf__ float *)get_imm(0x0);
    __ubuf__ float *memB = (__ubuf__ float *)get_imm(0x8000);
    __ubuf__ float *memGrad = (__ubuf__ float *)get_imm(0x10000);
    __ubuf__ float *memDA = (__ubuf__ float *)get_imm(0x18000);
    __ubuf__ float *memDB = (__ubuf__ float *)get_imm(0x20000);
    int repeat_times = 96;
    copy_gm_to_ubuf_align_v2(memA, inputA, 0, 1, repeat_times * 64 * 4, 0, 0, 0, 0, 0, 0);
    copy_gm_to_ubuf_align_v2(memB, inputB, 0, 1, repeat_times * 64 * 4, 0, 0, 0, 0, 0, 0);
    copy_gm_to_ubuf_align_v2(memGrad, inputGrad, 0, 1, repeat_times * 64 * 4, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    explicit_spill_vf();
    pipe_barrier(PIPE_ALL);
    copy_ubuf_to_gm_align_v2(outputDA, memDA, 0, 1, repeat_times * 64 * 4, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(outputDB, memDB, 0, 1, repeat_times * 64 * 4, 0, 0, 0);
    pipe_barrier(PIPE_ALL);
}
