    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf();
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)get_imm(49152), 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)get_imm(61440), 0, 1, 12288, 0, 0,
                             0);
    copy_ubuf_to_gm_align_v2(output + 24576, (__ubuf__ uint8_t*)get_imm(73728), 0, 1, 12288, 0, 0,
                             0);
}
