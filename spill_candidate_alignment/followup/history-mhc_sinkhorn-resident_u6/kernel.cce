/*
 * MHC VF 通用矩阵数测试：hc_mult 固定为 4，matrix_count 从 host 运行参数传入。
 * 总计 20 轮：初始化 softmax(0.5*mix+bias,行)+eps，再做列归一化；
 * 后续 19 轮依次做行除法、列除法，分母为对应和+eps，eps=1e-6。
 * element_major 额外先用 rms 做输入归一化；其结果原地紧凑写回 mix。
 * 输入记录步长 24 个 float，逐行输入行距 4 个 float，结果行距 8 个 float。
 * UB 缓冲区按矩阵数计算，只在缓冲区末尾留安全余量，不增加矩阵行填充。
 * resident 手动分组展开系数为 6；不足一组的矩阵走单矩阵尾循环。
 */
#define __aicore__ [aicore]
inline[aicore] void candidate_vf(__ubuf__ float* mix, __ubuf__ float* base, __ubuf__ float* result,
                                 float scale, float eps, uint16_t iters, uint16_t matrices) {
    __VEC_SCOPE__ {
        uint32_t remaining = 4;
        vector_bool mask = plt_b32(remaining, POST_UPDATE);
        vector_f32 x, b, maximum, total, column_sum;
        vector_align u_mix;
        __ubuf__ float* mix_origin = mix;
        __ubuf__ float* mix_addr = mix;
        vldas(u_mix, (__ubuf__ int32_t*)mix_addr);
        for (uint16_t matrix = 0; matrix < matrices; ++matrix) {
            vdup(column_sum, 0.0f, mask, MODE_ZEROING);
            for (uint16_t row = 0; row < 4; ++row) {
                mix_addr = mix_origin + 24 * matrix + 4 * row;
                vlds(b, base, 8 * row, NORM);
                vldus((vector_s32&)x, u_mix, (__ubuf__ int32_t*&)mix_addr, 64, POST_UPDATE);
                vmuls(x, x, scale, mask, MODE_ZEROING);
                vadd(x, x, b, mask, MODE_ZEROING);
                vcmax(maximum, x, mask, MODE_ZEROING);
                vdup(maximum, maximum, mask, POS_LOWEST, MODE_ZEROING);
                vsub(x, x, maximum, mask, MODE_ZEROING);
                vexp(x, x, mask, MODE_ZEROING);
                vcadd(total, x, mask, MODE_ZEROING);
                vdup(total, total, mask, POS_LOWEST, MODE_ZEROING);
                vdiv(x, x, total, mask, MODE_ZEROING);
                vadds(x, x, eps, mask, MODE_ZEROING);
                vadd(column_sum, column_sum, x, mask, MODE_ZEROING);
                vsts(x, result, 32 * matrix + 8 * row, NORM_B32, mask);
            }
            mem_bar(VST_VLD);
            vadds(column_sum, column_sum, eps, mask, MODE_ZEROING);
            for (uint16_t row = 0; row < 4; ++row) {
                vlds(x, result, 32 * matrix + 8 * row, NORM);
                vdiv(x, x, column_sum, mask, MODE_ZEROING);
                vsts(x, result, 32 * matrix + 8 * row, NORM_B32, mask);
            }
        }
        mem_bar(VST_VLD);
        uint16_t full_groups = matrices / 6;
        uint16_t tail_count = matrices % 6;
        uint16_t tail_start = matrices - tail_count;
        for (uint16_t group = 0; group < full_groups; ++group) {
            uint16_t matrix = group * 6;
            vector_f32 a0, a1, a2, a3, b0, b1, b2, b3, c0, c1, c2, c3, d0, d1, d2, d3, e0, e1, e2,
                e3, f0, f1, f2, f3;
            vector_f32 total_a, total_b, total_c, total_d, total_e, total_f, sum_a, sum_b, sum_c,
                sum_d, sum_e, sum_f;
            vlds(a0, result, 32 * (matrix + 0) + 0, NORM);
            vlds(b0, result, 32 * (matrix + 1) + 0, NORM);
            vlds(c0, result, 32 * (matrix + 2) + 0, NORM);
            vlds(d0, result, 32 * (matrix + 3) + 0, NORM);
            vlds(e0, result, 32 * (matrix + 4) + 0, NORM);
            vlds(f0, result, 32 * (matrix + 5) + 0, NORM);
            vlds(a1, result, 32 * (matrix + 0) + 8, NORM);
            vlds(b1, result, 32 * (matrix + 1) + 8, NORM);
            vlds(c1, result, 32 * (matrix + 2) + 8, NORM);
            vlds(d1, result, 32 * (matrix + 3) + 8, NORM);
            vlds(e1, result, 32 * (matrix + 4) + 8, NORM);
            vlds(f1, result, 32 * (matrix + 5) + 8, NORM);
            vlds(a2, result, 32 * (matrix + 0) + 16, NORM);
            vlds(b2, result, 32 * (matrix + 1) + 16, NORM);
            vlds(c2, result, 32 * (matrix + 2) + 16, NORM);
            vlds(d2, result, 32 * (matrix + 3) + 16, NORM);
            vlds(e2, result, 32 * (matrix + 4) + 16, NORM);
            vlds(f2, result, 32 * (matrix + 5) + 16, NORM);
            vlds(a3, result, 32 * (matrix + 0) + 24, NORM);
            vlds(b3, result, 32 * (matrix + 1) + 24, NORM);
            vlds(c3, result, 32 * (matrix + 2) + 24, NORM);
            vlds(d3, result, 32 * (matrix + 3) + 24, NORM);
            vlds(e3, result, 32 * (matrix + 4) + 24, NORM);
            vlds(f3, result, 32 * (matrix + 5) + 24, NORM);
            for (uint16_t iteration = 0; iteration < iters; ++iteration) {
                vdup(sum_a, 0.0f, mask, MODE_ZEROING);
                vcadd(total_a, a0, mask, MODE_ZEROING);
                vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                vdiv(a0, a0, total_a, mask, MODE_ZEROING);
                vadd(sum_a, sum_a, a0, mask, MODE_ZEROING);
                vcadd(total_a, a1, mask, MODE_ZEROING);
                vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                vdiv(a1, a1, total_a, mask, MODE_ZEROING);
                vadd(sum_a, sum_a, a1, mask, MODE_ZEROING);
                vcadd(total_a, a2, mask, MODE_ZEROING);
                vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                vdiv(a2, a2, total_a, mask, MODE_ZEROING);
                vadd(sum_a, sum_a, a2, mask, MODE_ZEROING);
                vcadd(total_a, a3, mask, MODE_ZEROING);
                vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                vdiv(a3, a3, total_a, mask, MODE_ZEROING);
                vadd(sum_a, sum_a, a3, mask, MODE_ZEROING);
                vadds(sum_a, sum_a, eps, mask, MODE_ZEROING);
                vdiv(a0, a0, sum_a, mask, MODE_ZEROING);
                vdiv(a1, a1, sum_a, mask, MODE_ZEROING);
                vdiv(a2, a2, sum_a, mask, MODE_ZEROING);
                vdiv(a3, a3, sum_a, mask, MODE_ZEROING);
                vdup(sum_b, 0.0f, mask, MODE_ZEROING);
                vcadd(total_b, b0, mask, MODE_ZEROING);
                vdup(total_b, total_b, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_b, total_b, eps, mask, MODE_ZEROING);
                vdiv(b0, b0, total_b, mask, MODE_ZEROING);
                vadd(sum_b, sum_b, b0, mask, MODE_ZEROING);
                vcadd(total_b, b1, mask, MODE_ZEROING);
                vdup(total_b, total_b, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_b, total_b, eps, mask, MODE_ZEROING);
                vdiv(b1, b1, total_b, mask, MODE_ZEROING);
                vadd(sum_b, sum_b, b1, mask, MODE_ZEROING);
                vcadd(total_b, b2, mask, MODE_ZEROING);
                vdup(total_b, total_b, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_b, total_b, eps, mask, MODE_ZEROING);
                vdiv(b2, b2, total_b, mask, MODE_ZEROING);
                vadd(sum_b, sum_b, b2, mask, MODE_ZEROING);
                vcadd(total_b, b3, mask, MODE_ZEROING);
                vdup(total_b, total_b, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_b, total_b, eps, mask, MODE_ZEROING);
                vdiv(b3, b3, total_b, mask, MODE_ZEROING);
                vadd(sum_b, sum_b, b3, mask, MODE_ZEROING);
                vadds(sum_b, sum_b, eps, mask, MODE_ZEROING);
                vdiv(b0, b0, sum_b, mask, MODE_ZEROING);
                vdiv(b1, b1, sum_b, mask, MODE_ZEROING);
                vdiv(b2, b2, sum_b, mask, MODE_ZEROING);
                vdiv(b3, b3, sum_b, mask, MODE_ZEROING);
                vdup(sum_c, 0.0f, mask, MODE_ZEROING);
                vcadd(total_c, c0, mask, MODE_ZEROING);
                vdup(total_c, total_c, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_c, total_c, eps, mask, MODE_ZEROING);
                vdiv(c0, c0, total_c, mask, MODE_ZEROING);
                vadd(sum_c, sum_c, c0, mask, MODE_ZEROING);
                vcadd(total_c, c1, mask, MODE_ZEROING);
                vdup(total_c, total_c, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_c, total_c, eps, mask, MODE_ZEROING);
                vdiv(c1, c1, total_c, mask, MODE_ZEROING);
                vadd(sum_c, sum_c, c1, mask, MODE_ZEROING);
                vcadd(total_c, c2, mask, MODE_ZEROING);
                vdup(total_c, total_c, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_c, total_c, eps, mask, MODE_ZEROING);
                vdiv(c2, c2, total_c, mask, MODE_ZEROING);
                vadd(sum_c, sum_c, c2, mask, MODE_ZEROING);
                vcadd(total_c, c3, mask, MODE_ZEROING);
                vdup(total_c, total_c, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_c, total_c, eps, mask, MODE_ZEROING);
                vdiv(c3, c3, total_c, mask, MODE_ZEROING);
                vadd(sum_c, sum_c, c3, mask, MODE_ZEROING);
                vadds(sum_c, sum_c, eps, mask, MODE_ZEROING);
                vdiv(c0, c0, sum_c, mask, MODE_ZEROING);
                vdiv(c1, c1, sum_c, mask, MODE_ZEROING);
                vdiv(c2, c2, sum_c, mask, MODE_ZEROING);
                vdiv(c3, c3, sum_c, mask, MODE_ZEROING);
                vdup(sum_d, 0.0f, mask, MODE_ZEROING);
                vcadd(total_d, d0, mask, MODE_ZEROING);
                vdup(total_d, total_d, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_d, total_d, eps, mask, MODE_ZEROING);
                vdiv(d0, d0, total_d, mask, MODE_ZEROING);
                vadd(sum_d, sum_d, d0, mask, MODE_ZEROING);
                vcadd(total_d, d1, mask, MODE_ZEROING);
                vdup(total_d, total_d, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_d, total_d, eps, mask, MODE_ZEROING);
                vdiv(d1, d1, total_d, mask, MODE_ZEROING);
                vadd(sum_d, sum_d, d1, mask, MODE_ZEROING);
                vcadd(total_d, d2, mask, MODE_ZEROING);
                vdup(total_d, total_d, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_d, total_d, eps, mask, MODE_ZEROING);
                vdiv(d2, d2, total_d, mask, MODE_ZEROING);
                vadd(sum_d, sum_d, d2, mask, MODE_ZEROING);
                vcadd(total_d, d3, mask, MODE_ZEROING);
                vdup(total_d, total_d, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_d, total_d, eps, mask, MODE_ZEROING);
                vdiv(d3, d3, total_d, mask, MODE_ZEROING);
                vadd(sum_d, sum_d, d3, mask, MODE_ZEROING);
                vadds(sum_d, sum_d, eps, mask, MODE_ZEROING);
                vdiv(d0, d0, sum_d, mask, MODE_ZEROING);
                vdiv(d1, d1, sum_d, mask, MODE_ZEROING);
                vdiv(d2, d2, sum_d, mask, MODE_ZEROING);
                vdiv(d3, d3, sum_d, mask, MODE_ZEROING);
                vdup(sum_e, 0.0f, mask, MODE_ZEROING);
                vcadd(total_e, e0, mask, MODE_ZEROING);
                vdup(total_e, total_e, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_e, total_e, eps, mask, MODE_ZEROING);
                vdiv(e0, e0, total_e, mask, MODE_ZEROING);
                vadd(sum_e, sum_e, e0, mask, MODE_ZEROING);
                vcadd(total_e, e1, mask, MODE_ZEROING);
                vdup(total_e, total_e, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_e, total_e, eps, mask, MODE_ZEROING);
                vdiv(e1, e1, total_e, mask, MODE_ZEROING);
                vadd(sum_e, sum_e, e1, mask, MODE_ZEROING);
                vcadd(total_e, e2, mask, MODE_ZEROING);
                vdup(total_e, total_e, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_e, total_e, eps, mask, MODE_ZEROING);
                vdiv(e2, e2, total_e, mask, MODE_ZEROING);
                vadd(sum_e, sum_e, e2, mask, MODE_ZEROING);
                vcadd(total_e, e3, mask, MODE_ZEROING);
                vdup(total_e, total_e, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_e, total_e, eps, mask, MODE_ZEROING);
                vdiv(e3, e3, total_e, mask, MODE_ZEROING);
                vadd(sum_e, sum_e, e3, mask, MODE_ZEROING);
                vadds(sum_e, sum_e, eps, mask, MODE_ZEROING);
                vdiv(e0, e0, sum_e, mask, MODE_ZEROING);
                vdiv(e1, e1, sum_e, mask, MODE_ZEROING);
                vdiv(e2, e2, sum_e, mask, MODE_ZEROING);
                vdiv(e3, e3, sum_e, mask, MODE_ZEROING);
                vdup(sum_f, 0.0f, mask, MODE_ZEROING);
                vcadd(total_f, f0, mask, MODE_ZEROING);
                vdup(total_f, total_f, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_f, total_f, eps, mask, MODE_ZEROING);
                vdiv(f0, f0, total_f, mask, MODE_ZEROING);
                vadd(sum_f, sum_f, f0, mask, MODE_ZEROING);
                vcadd(total_f, f1, mask, MODE_ZEROING);
                vdup(total_f, total_f, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_f, total_f, eps, mask, MODE_ZEROING);
                vdiv(f1, f1, total_f, mask, MODE_ZEROING);
                vadd(sum_f, sum_f, f1, mask, MODE_ZEROING);
                vcadd(total_f, f2, mask, MODE_ZEROING);
                vdup(total_f, total_f, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_f, total_f, eps, mask, MODE_ZEROING);
                vdiv(f2, f2, total_f, mask, MODE_ZEROING);
                vadd(sum_f, sum_f, f2, mask, MODE_ZEROING);
                vcadd(total_f, f3, mask, MODE_ZEROING);
                vdup(total_f, total_f, mask, POS_LOWEST, MODE_ZEROING);
                vadds(total_f, total_f, eps, mask, MODE_ZEROING);
                vdiv(f3, f3, total_f, mask, MODE_ZEROING);
                vadd(sum_f, sum_f, f3, mask, MODE_ZEROING);
                vadds(sum_f, sum_f, eps, mask, MODE_ZEROING);
                vdiv(f0, f0, sum_f, mask, MODE_ZEROING);
                vdiv(f1, f1, sum_f, mask, MODE_ZEROING);
                vdiv(f2, f2, sum_f, mask, MODE_ZEROING);
                vdiv(f3, f3, sum_f, mask, MODE_ZEROING);
            }
            vsts(a0, result, 32 * (matrix + 0) + 0, NORM_B32, mask);
            vsts(b0, result, 32 * (matrix + 1) + 0, NORM_B32, mask);
            vsts(c0, result, 32 * (matrix + 2) + 0, NORM_B32, mask);
            vsts(d0, result, 32 * (matrix + 3) + 0, NORM_B32, mask);
            vsts(e0, result, 32 * (matrix + 4) + 0, NORM_B32, mask);
            vsts(f0, result, 32 * (matrix + 5) + 0, NORM_B32, mask);
            vsts(a1, result, 32 * (matrix + 0) + 8, NORM_B32, mask);
            vsts(b1, result, 32 * (matrix + 1) + 8, NORM_B32, mask);
            vsts(c1, result, 32 * (matrix + 2) + 8, NORM_B32, mask);
            vsts(d1, result, 32 * (matrix + 3) + 8, NORM_B32, mask);
            vsts(e1, result, 32 * (matrix + 4) + 8, NORM_B32, mask);
            vsts(f1, result, 32 * (matrix + 5) + 8, NORM_B32, mask);
            vsts(a2, result, 32 * (matrix + 0) + 16, NORM_B32, mask);
            vsts(b2, result, 32 * (matrix + 1) + 16, NORM_B32, mask);
            vsts(c2, result, 32 * (matrix + 2) + 16, NORM_B32, mask);
            vsts(d2, result, 32 * (matrix + 3) + 16, NORM_B32, mask);
            vsts(e2, result, 32 * (matrix + 4) + 16, NORM_B32, mask);
            vsts(f2, result, 32 * (matrix + 5) + 16, NORM_B32, mask);
            vsts(a3, result, 32 * (matrix + 0) + 24, NORM_B32, mask);
            vsts(b3, result, 32 * (matrix + 1) + 24, NORM_B32, mask);
            vsts(c3, result, 32 * (matrix + 2) + 24, NORM_B32, mask);
            vsts(d3, result, 32 * (matrix + 3) + 24, NORM_B32, mask);
            vsts(e3, result, 32 * (matrix + 4) + 24, NORM_B32, mask);
            vsts(f3, result, 32 * (matrix + 5) + 24, NORM_B32, mask);
        }
        if (tail_count != 0) {
            for (uint16_t tail = 0; tail < tail_count; ++tail) {
                uint16_t matrix = tail_start + tail;
                vector_f32 a0, a1, a2, a3;
                vector_f32 total_a, sum_a;
                vlds(a0, result, 32 * (matrix + 0) + 0, NORM);
                vlds(a1, result, 32 * (matrix + 0) + 8, NORM);
                vlds(a2, result, 32 * (matrix + 0) + 16, NORM);
                vlds(a3, result, 32 * (matrix + 0) + 24, NORM);
                for (uint16_t iteration = 0; iteration < iters; ++iteration) {
                    vdup(sum_a, 0.0f, mask, MODE_ZEROING);
                    vcadd(total_a, a0, mask, MODE_ZEROING);
                    vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                    vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                    vdiv(a0, a0, total_a, mask, MODE_ZEROING);
                    vadd(sum_a, sum_a, a0, mask, MODE_ZEROING);
                    vcadd(total_a, a1, mask, MODE_ZEROING);
                    vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                    vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                    vdiv(a1, a1, total_a, mask, MODE_ZEROING);
                    vadd(sum_a, sum_a, a1, mask, MODE_ZEROING);
                    vcadd(total_a, a2, mask, MODE_ZEROING);
                    vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                    vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                    vdiv(a2, a2, total_a, mask, MODE_ZEROING);
                    vadd(sum_a, sum_a, a2, mask, MODE_ZEROING);
                    vcadd(total_a, a3, mask, MODE_ZEROING);
                    vdup(total_a, total_a, mask, POS_LOWEST, MODE_ZEROING);
                    vadds(total_a, total_a, eps, mask, MODE_ZEROING);
                    vdiv(a3, a3, total_a, mask, MODE_ZEROING);
                    vadd(sum_a, sum_a, a3, mask, MODE_ZEROING);
                    vadds(sum_a, sum_a, eps, mask, MODE_ZEROING);
                    vdiv(a0, a0, sum_a, mask, MODE_ZEROING);
                    vdiv(a1, a1, sum_a, mask, MODE_ZEROING);
                    vdiv(a2, a2, sum_a, mask, MODE_ZEROING);
                    vdiv(a3, a3, sum_a, mask, MODE_ZEROING);
                }
                vsts(a0, result, 32 * (matrix + 0) + 0, NORM_B32, mask);
                vsts(a1, result, 32 * (matrix + 0) + 8, NORM_B32, mask);
                vsts(a2, result, 32 * (matrix + 0) + 16, NORM_B32, mask);
                vsts(a3, result, 32 * (matrix + 0) + 24, NORM_B32, mask);
            }
        }
    }
}
inline[aicore] uint32_t align_up(uint32_t value, uint32_t alignment) {
    return (value + alignment - 1) / alignment * alignment;
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ float* input, __gm__ float* output,
                                                       uint32_t matrix_count) {
    if (matrix_count == 0 || matrix_count > 65535)
        return;
    uint32_t mix_bytes = align_up(matrix_count * 96 + 256, 32);
    uint32_t mix_offset = 0;
    uint32_t mix_gm = 0;
    uint32_t base_bytes = align_up(matrix_count * 0 + 384, 32);
    uint32_t base_offset = align_up(mix_offset + mix_bytes, 512);
    uint32_t base_gm = mix_gm + mix_bytes;
    uint32_t rms_bytes = align_up(matrix_count * 4 + 256, 32);
    uint32_t rms_offset = align_up(base_offset + base_bytes, 512);
    uint32_t rms_gm = base_gm + base_bytes;
    uint32_t result_bytes = align_up(matrix_count * 128 + 256, 32);
    uint32_t result_offset = align_up(rms_offset + rms_bytes, 512);
    uint32_t result_gm = rms_gm + rms_bytes;
    if (result_offset + result_bytes > 253952)
        return;
    uint16_t matrices = static_cast<uint16_t>(matrix_count);
    __ubuf__ float* mix = (__ubuf__ float*)(uint64_t)mix_offset;
    copy_gm_to_ubuf_align_v2(mix, input + mix_gm / 4, 0, 1, mix_bytes, 0, 0, 0, 0, 0, 0);
    __ubuf__ float* base = (__ubuf__ float*)(uint64_t)base_offset;
    copy_gm_to_ubuf_align_v2(base, input + base_gm / 4, 0, 1, base_bytes, 0, 0, 0, 0, 0, 0);
    __ubuf__ float* rms = (__ubuf__ float*)(uint64_t)rms_offset;
    copy_gm_to_ubuf_align_v2(rms, input + rms_gm / 4, 0, 1, rms_bytes, 0, 0, 0, 0, 0, 0);
    __ubuf__ float* result = (__ubuf__ float*)(uint64_t)result_offset;
    copy_gm_to_ubuf_align_v2(result, input + result_gm / 4, 0, 1, result_bytes, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(mix + 8, base, result, 0.5f, 1e-6f, 19, matrices);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output, result, 0, 1, result_bytes, 0, 0, 0);
}
