#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* srcAddr, __ubuf__ float* dstAddr) {
    uint32_t count = 3072, vlSize = 64;
    uint16_t loopNum = 48;
    constexpr float FP32_ZERO = 0.0f, FP32_ONE = 1.0f, FP32_TWO = 2.0f, FP32_NEG_ONE = -1.0f,
                    FP32_NEG_TWO = -2.0f;
    RegTensor<float> vregInput;
    RegTensor<float> vregInputNegNumerator;
    RegTensor<float> vregInputNegDenominator;
    RegTensor<float> vregInputNumerator;
    RegTensor<float> vregInputDenominator;

    RegTensor<float> vregOutput;
    MaskReg mask;
    MaskReg cmpMaskReg;

    RegTensor<float> vregInput16;
    RegTensor<float> vregOutput16;
    __VEC_SCOPE__ {
#pragma unroll 1
        for (uint16_t i = 0; i < loopNum; i++) {
            mask = UpdateMask<float>(count);
            // OpCopyIn

            DataCopy<float, LoadDist::DIST_NORM>(vregInput,
                                                 (__ubuf__ float*)(srcAddr + i * vlSize));

            Muls(vregInputNegNumerator, vregInput, FP32_NEG_ONE, mask);             // -x
            Muls(vregInputNegDenominator, vregInput, FP32_NEG_TWO, mask);           // -2x
            Exp(vregInputNegNumerator, vregInputNegNumerator, mask);                // e^-x
            Exp(vregInputNegDenominator, vregInputNegDenominator, mask);            // e^-2x
            Muls(vregInputNegNumerator, vregInputNegNumerator, FP32_TWO, mask);     // 2e^-x
            Adds(vregInputNegNumerator, vregInputNegNumerator, FP32_ONE, mask);     // 2e^-x + 1
            Muls(vregInputNegDenominator, vregInputNegDenominator, FP32_TWO, mask); // 2e^-2x
            Add(vregInputNegDenominator, vregInputNegNumerator, vregInputNegDenominator, mask);
            Div(vregOutput, vregInputNegNumerator, vregInputNegDenominator, mask);

            Muls(vregInputNumerator, vregInput, FP32_TWO, mask);            // 2x
            Exp(vregInputNumerator, vregInputNumerator, mask);              // e^2x
            Exp(vregInputDenominator, vregInput, mask);                     // e^x
            Axpy(vregInputNumerator, vregInputDenominator, FP32_TWO, mask); // e^2x + 2e^x
            Adds(vregInputDenominator, vregInputNumerator, FP32_TWO, mask); // e^2x + 2e^x + 2
            Div(vregInputNumerator, vregInputNumerator, vregInputDenominator, mask);

            CompareScalar<float, CMPMODE::LT>(cmpMaskReg, vregInput, FP32_ZERO, mask);
            Select(vregOutput, vregInputNumerator, vregOutput, cmpMaskReg);
            Mul(vregOutput, vregOutput, vregInput, mask);

            // OpCopyOut

            DataCopy<float, StoreDist::DIST_NORM_B32>((__ubuf__ float*)(dstAddr + i * vlSize),
                                                      vregOutput, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* srcAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dstAddr = (__ubuf__ float*)get_imm(12288);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12288, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(srcAddr, dstAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dstAddr, 0, 1, 12288, 0, 0, 0);
}
