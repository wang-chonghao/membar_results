#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* xPtr, __ubuf__ float* dyPtr,
                                    __ubuf__ float* gammaPtr, __ubuf__ float* betaPtr,
                                    __ubuf__ float* c1Ptr, __ubuf__ float* c2Ptr,
                                    __ubuf__ float* meanRstdPtr, __ubuf__ float* dxPtr) {
    uint32_t calCount = 6144, cGIdx = 0;
    constexpr uint32_t oneRepeatSizeB32 = 64, rstdValueOffset = 8;
    float swishScaleValue = 0.800000011920929f;
    __VEC_SCOPE__ {
        MaskReg maskFull0;
        MaskReg maskFull1;
        RegTensor<float> vGamma, vBeta, vC1, vC2, vRstd;
        RegTensor<float> vX0, vDy0, vYMul0, vY0, vDenScaled0, vDenExp0, vDen0;
        RegTensor<float> vDswish0, vDyNew0, vCorrectionMul0, vCorrection0, vDx0;
        RegTensor<float> vX1, vDy1, vYMul1, vY1, vDenScaled1, vDenExp1, vDen1;
        RegTensor<float> vDswish1, vDyNew1, vCorrectionMul1, vCorrection1, vDx1;
        uint32_t fullRepeatTimes = (calCount + oneRepeatSizeB32 - 1) / oneRepeatSizeB32;
        uint16_t pairRepeatTimes = static_cast<uint16_t>((fullRepeatTimes + 1) / 2);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(vGamma, gammaPtr + cGIdx);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(vBeta, betaPtr + cGIdx);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(vC1, c1Ptr);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(vC2, c2Ptr);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(vRstd, meanRstdPtr + rstdValueOffset);
#pragma unroll 1
        for (uint16_t i = 0; i < pairRepeatTimes; i++) {
            uint32_t offset0 = i * 2 * oneRepeatSizeB32;
            uint32_t offset1 = offset0 + oneRepeatSizeB32;
            maskFull0 = UpdateMask<float>(calCount);
            maskFull1 = UpdateMask<float>(calCount);
            LoadAlign(vX0, xPtr + offset0);
            LoadAlign(vDy0, dyPtr + offset0);
            LoadAlign(vX1, xPtr + offset1);
            LoadAlign(vDy1, dyPtr + offset1);
            Mul(vYMul0, vX0, vGamma, maskFull0);
            Mul(vYMul1, vX1, vGamma, maskFull1);
            Add(vY0, vYMul0, vBeta, maskFull0);
            Add(vY1, vYMul1, vBeta, maskFull1);
            Muls(vYMul0, vY0, swishScaleValue, maskFull0);
            Muls(vYMul1, vY1, swishScaleValue, maskFull1);
            Muls(vDenScaled0, vYMul0, float(-1.0), maskFull0);
            Muls(vDenScaled1, vYMul1, float(-1.0), maskFull1);
            Exp(vDenExp0, vDenScaled0, maskFull0);
            Exp(vDenExp1, vDenScaled1, maskFull1);
            Adds(vDen0, vDenExp0, float(1.0), maskFull0);
            Adds(vDen1, vDenExp1, float(1.0), maskFull1);
            Div(vDenScaled0, vYMul0, vDen0, maskFull0);
            Div(vDenScaled1, vYMul1, vDen1, maskFull1);
            Sub(vDenExp0, vYMul0, vDenScaled0, maskFull0);
            Sub(vDenExp1, vYMul1, vDenScaled1, maskFull1);
            Adds(vYMul0, vDenExp0, float(1.0), maskFull0);
            Adds(vYMul1, vDenExp1, float(1.0), maskFull1);
            Div(vDswish0, vYMul0, vDen0, maskFull0);
            Div(vDswish1, vYMul1, vDen1, maskFull1);
            Mul(vDyNew0, vDswish0, vDy0, maskFull0);
            Mul(vDyNew1, vDswish1, vDy1, maskFull1);
            Mul(vDswish0, vDyNew0, vGamma, maskFull0);
            Mul(vDswish1, vDyNew1, vGamma, maskFull1);
            Mul(vDyNew0, vDswish0, vRstd, maskFull0);
            Mul(vDyNew1, vDswish1, vRstd, maskFull1);
            Mul(vCorrectionMul0, vX0, vC2, maskFull0);
            Mul(vCorrectionMul1, vX1, vC2, maskFull1);
            Add(vCorrection0, vCorrectionMul0, vC1, maskFull0);
            Add(vCorrection1, vCorrectionMul1, vC1, maskFull1);
            Mul(vCorrectionMul0, vCorrection0, vRstd, maskFull0);
            Mul(vCorrectionMul1, vCorrection1, vRstd, maskFull1);
            Sub(vDx0, vDyNew0, vCorrectionMul0, maskFull0);
            Sub(vDx1, vDyNew1, vCorrectionMul1, maskFull1);
            StoreAlign(dxPtr + offset0, vDx0, maskFull0);
            StoreAlign(dxPtr + offset1, vDx1, maskFull1);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xPtr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dyPtr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* gammaPtr = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* betaPtr = (__ubuf__ float*)get_imm(49408);
    __ubuf__ float* c1Ptr = (__ubuf__ float*)get_imm(49664);
    __ubuf__ float* c2Ptr = (__ubuf__ float*)get_imm(49920);
    __ubuf__ float* meanRstdPtr = (__ubuf__ float*)get_imm(50176);
    __ubuf__ float* dxPtr = (__ubuf__ float*)get_imm(50432);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 50432, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xPtr, dyPtr, gammaPtr, betaPtr, c1Ptr, c2Ptr, meanRstdPtr, dxPtr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dxPtr, 0, 1, 24576, 0, 0, 0);
}
