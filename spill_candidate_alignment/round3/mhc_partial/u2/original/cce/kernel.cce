#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* mmPartial, __ubuf__ float* rmsPartial,
                                    __ubuf__ float* mmOut, __ubuf__ float* invRmsOut) {
    uint16_t rowCount = 48, fusionSize = 64, mmSegmentOffset = 0, mmSegmentSize = 64,
             rmsStride = 48, fourLoopCount = 1, tailLoopCount = 0;
    uint32_t mmGroupStride = 3072;
    float scaleMean = 0.25f, normEps = 1e-5f;
    __VEC_SCOPE__ {
        AscendC::MicroAPI::RegTensor<float> rms0;
        AscendC::MicroAPI::RegTensor<float> rms1;
        AscendC::MicroAPI::RegTensor<float> rms2;
        AscendC::MicroAPI::RegTensor<float> rms3;
        AscendC::MicroAPI::RegTensor<float> mm0;
        AscendC::MicroAPI::RegTensor<float> mm1;
        AscendC::MicroAPI::RegTensor<float> mm2;
        AscendC::MicroAPI::RegTensor<float> mm3;
        AscendC::MicroAPI::RegTensor<float> sumRms0;
        AscendC::MicroAPI::RegTensor<float> sumRms1;
        AscendC::MicroAPI::RegTensor<float> sumRms2;
        AscendC::MicroAPI::RegTensor<float> sumRms3;
        AscendC::MicroAPI::RegTensor<float> sumMm0;
        AscendC::MicroAPI::RegTensor<float> sumMm1;
        AscendC::MicroAPI::RegTensor<float> sumMm2;
        AscendC::MicroAPI::RegTensor<float> sumMm3;
        AscendC::MicroAPI::RegTensor<float> one;
        uint32_t rmsMaskSize = 1U;
        uint32_t mmMaskSize = mmSegmentSize;
        vector_bool rmsMask = plt_b32(rmsMaskSize, POST_UPDATE);
        vector_bool mmMask = plt_b32(mmMaskSize, POST_UPDATE);
        vdup(one, 1.0f, rmsMask, MODE_ZEROING);

        {
            AscendC::MicroAPI::RegTensor<float> mm0_u0;
            AscendC::MicroAPI::RegTensor<float> mm0_u1;
            AscendC::MicroAPI::RegTensor<float> mm1_u0;
            AscendC::MicroAPI::RegTensor<float> mm1_u1;
            AscendC::MicroAPI::RegTensor<float> mm2_u0;
            AscendC::MicroAPI::RegTensor<float> mm2_u1;
            AscendC::MicroAPI::RegTensor<float> mm3_u0;
            AscendC::MicroAPI::RegTensor<float> mm3_u1;
            AscendC::MicroAPI::RegTensor<float> rms0_u0;
            AscendC::MicroAPI::RegTensor<float> rms0_u1;
            AscendC::MicroAPI::RegTensor<float> rms1_u0;
            AscendC::MicroAPI::RegTensor<float> rms1_u1;
            AscendC::MicroAPI::RegTensor<float> rms2_u0;
            AscendC::MicroAPI::RegTensor<float> rms2_u1;
            AscendC::MicroAPI::RegTensor<float> rms3_u0;
            AscendC::MicroAPI::RegTensor<float> rms3_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u1;
#pragma unroll 1
            for (uint32_t row = 0; row < 48; row += 2) {
                vdup(sumRms0_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumMm0_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u1, 0.0f, mmMask, MODE_ZEROING);
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 0)), 0,
                         BRC_B32);
                    vlds(rms1_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vlds(rms2_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vlds(rms3_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vadd(sumRms0_u0, sumRms0_u0, rms0_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms1_u0, sumRms1_u0, rms1_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms2_u0, sumRms2_u0, rms2_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms3_u0, sumRms3_u0, rms3_u0, rmsMask, MODE_ZEROING);

                    AscendC::MicroAPI::Load<float>(
                        mm0_u0, mmPartial + static_cast<uint32_t>(kBase) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm1_u0, mmPartial + static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm2_u0, mmPartial + static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm3_u0, mmPartial + static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u0, sumMm0_u0, mm0_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm1_u0, sumMm1_u0, mm1_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm2_u0, sumMm2_u0, mm2_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm3_u0, sumMm3_u0, mm3_u0, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 1)), 0,
                         BRC_B32);
                    vlds(rms1_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vlds(rms2_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vlds(rms3_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vadd(sumRms0_u1, sumRms0_u1, rms0_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms1_u1, sumRms1_u1, rms1_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms2_u1, sumRms2_u1, rms2_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms3_u1, sumRms3_u1, rms3_u1, rmsMask, MODE_ZEROING);

                    AscendC::MicroAPI::Load<float>(
                        mm0_u1, mmPartial + static_cast<uint32_t>(kBase) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm1_u1, mmPartial + static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm2_u1, mmPartial + static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm3_u1, mmPartial + static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u1, sumMm0_u1, mm0_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm1_u1, sumMm1_u1, mm1_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm2_u1, sumMm2_u1, mm2_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm3_u1, sumMm3_u1, mm3_u1, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t tail = 0; tail < tailLoopCount; ++tail) {
                    uint16_t kIndex = fourLoopCount * 4U + tail;
                    vlds(rms0_u0,
                         rmsPartial + (static_cast<uint32_t>(kIndex) * rmsStride + (row + 0)), 0,
                         BRC_B32);
                    vadd(sumRms0_u0, sumRms0_u0, rms0_u0, rmsMask, MODE_ZEROING);
                    AscendC::MicroAPI::Load<float>(
                        mm0_u0, mmPartial + static_cast<uint32_t>(kIndex) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u0, sumMm0_u0, mm0_u0, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t tail = 0; tail < tailLoopCount; ++tail) {
                    uint16_t kIndex = fourLoopCount * 4U + tail;
                    vlds(rms0_u1,
                         rmsPartial + (static_cast<uint32_t>(kIndex) * rmsStride + (row + 1)), 0,
                         BRC_B32);
                    vadd(sumRms0_u1, sumRms0_u1, rms0_u1, rmsMask, MODE_ZEROING);
                    AscendC::MicroAPI::Load<float>(
                        mm0_u1, mmPartial + static_cast<uint32_t>(kIndex) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u1, sumMm0_u1, mm0_u1, mmMask, MODE_ZEROING);
                }
                vadd(sumRms0_u0, sumRms0_u0, sumRms3_u0, rmsMask, MODE_ZEROING);
                vadd(sumRms0_u1, sumRms0_u1, sumRms3_u1, rmsMask, MODE_ZEROING);
                vadd(sumRms1_u0, sumRms1_u0, sumRms2_u0, rmsMask, MODE_ZEROING);
                vadd(sumRms1_u1, sumRms1_u1, sumRms2_u1, rmsMask, MODE_ZEROING);
                vadd(sumRms0_u0, sumRms0_u0, sumRms1_u0, rmsMask, MODE_ZEROING);
                vadd(sumRms0_u1, sumRms0_u1, sumRms1_u1, rmsMask, MODE_ZEROING);
                vmuls(sumRms0_u0, sumRms0_u0, scaleMean, rmsMask, MODE_ZEROING);
                vmuls(sumRms0_u1, sumRms0_u1, scaleMean, rmsMask, MODE_ZEROING);
                vadds(sumRms0_u0, sumRms0_u0, normEps, rmsMask, MODE_ZEROING);
                vadds(sumRms0_u1, sumRms0_u1, normEps, rmsMask, MODE_ZEROING);
                vsqrt(sumRms0_u0, sumRms0_u0, rmsMask, MODE_ZEROING);
                vsqrt(sumRms0_u1, sumRms0_u1, rmsMask, MODE_ZEROING);
                vdiv(sumRms0_u0, one, sumRms0_u0, rmsMask, MODE_ZEROING);
                vdiv(sumRms0_u1, one, sumRms0_u1, rmsMask, MODE_ZEROING);
                vadd(sumMm0_u0, sumMm0_u0, sumMm3_u0, mmMask, MODE_ZEROING);
                vadd(sumMm0_u1, sumMm0_u1, sumMm3_u1, mmMask, MODE_ZEROING);
                vadd(sumMm1_u0, sumMm1_u0, sumMm2_u0, mmMask, MODE_ZEROING);
                vadd(sumMm1_u1, sumMm1_u1, sumMm2_u1, mmMask, MODE_ZEROING);
                vadd(sumMm0_u0, sumMm0_u0, sumMm1_u0, mmMask, MODE_ZEROING);
                vadd(sumMm0_u1, sumMm0_u1, sumMm1_u1, mmMask, MODE_ZEROING);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 0), sumRms0_u0, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 1), sumRms0_u1, 1U);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 0) * fusionSize + mmSegmentOffset,
                                                sumMm0_u0, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 1) * fusionSize + mmSegmentOffset,
                                                sumMm0_u1, mmSegmentSize);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* mmPartial = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* rmsPartial = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* mmOut = (__ubuf__ float*)get_imm(49920);
    __ubuf__ float* invRmsOut = (__ubuf__ float*)get_imm(62208);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 49920, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(mmPartial, rmsPartial, mmOut, invRmsOut);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)mmOut, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)invRmsOut, 0, 1, 192, 0, 0, 0);
}
