                vdiv(sumRms0_u7, one, sumRms0_u7, rmsMask, MODE_ZEROING);
                vadd(sumMm0_u0, sumMm0_u0, sumMm3_u0, mmMask, MODE_ZEROING);
                vadd(sumMm0_u1, sumMm0_u1, sumMm3_u1, mmMask, MODE_ZEROING);
                vadd(sumMm0_u2, sumMm0_u2, sumMm3_u2, mmMask, MODE_ZEROING);
                vadd(sumMm0_u3, sumMm0_u3, sumMm3_u3, mmMask, MODE_ZEROING);
                vadd(sumMm0_u4, sumMm0_u4, sumMm3_u4, mmMask, MODE_ZEROING);
                vadd(sumMm0_u5, sumMm0_u5, sumMm3_u5, mmMask, MODE_ZEROING);
                vadd(sumMm0_u6, sumMm0_u6, sumMm3_u6, mmMask, MODE_ZEROING);
                vadd(sumMm0_u7, sumMm0_u7, sumMm3_u7, mmMask, MODE_ZEROING);
                vadd(sumMm1_u0, sumMm1_u0, sumMm2_u0, mmMask, MODE_ZEROING);
                vadd(sumMm1_u1, sumMm1_u1, sumMm2_u1, mmMask, MODE_ZEROING);
                vadd(sumMm1_u2, sumMm1_u2, sumMm2_u2, mmMask, MODE_ZEROING);
                vadd(sumMm1_u3, sumMm1_u3, sumMm2_u3, mmMask, MODE_ZEROING);
                vadd(sumMm1_u4, sumMm1_u4, sumMm2_u4, mmMask, MODE_ZEROING);
                vadd(sumMm1_u5, sumMm1_u5, sumMm2_u5, mmMask, MODE_ZEROING);
                vadd(sumMm1_u6, sumMm1_u6, sumMm2_u6, mmMask, MODE_ZEROING);
                vadd(sumMm1_u7, sumMm1_u7, sumMm2_u7, mmMask, MODE_ZEROING);
                vadd(sumMm0_u0, sumMm0_u0, sumMm1_u0, mmMask, MODE_ZEROING);
                vadd(sumMm0_u1, sumMm0_u1, sumMm1_u1, mmMask, MODE_ZEROING);
                vadd(sumMm0_u2, sumMm0_u2, sumMm1_u2, mmMask, MODE_ZEROING);
                vadd(sumMm0_u3, sumMm0_u3, sumMm1_u3, mmMask, MODE_ZEROING);
                vadd(sumMm0_u4, sumMm0_u4, sumMm1_u4, mmMask, MODE_ZEROING);
                vadd(sumMm0_u5, sumMm0_u5, sumMm1_u5, mmMask, MODE_ZEROING);
                vadd(sumMm0_u6, sumMm0_u6, sumMm1_u6, mmMask, MODE_ZEROING);
                vadd(sumMm0_u7, sumMm0_u7, sumMm1_u7, mmMask, MODE_ZEROING);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 0), sumRms0_u0, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 1), sumRms0_u1, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 2), sumRms0_u2, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 3), sumRms0_u3, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 4), sumRms0_u4, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 5), sumRms0_u5, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 6), sumRms0_u6, 1U);
                AscendC::MicroAPI::Store<float>(invRmsOut + (row + 7), sumRms0_u7, 1U);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 0) * fusionSize + mmSegmentOffset,
                                                sumMm0_u0, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 1) * fusionSize + mmSegmentOffset,
                                                sumMm0_u1, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 2) * fusionSize + mmSegmentOffset,
                                                sumMm0_u2, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 3) * fusionSize + mmSegmentOffset,
                                                sumMm0_u3, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 4) * fusionSize + mmSegmentOffset,
                                                sumMm0_u4, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 5) * fusionSize + mmSegmentOffset,
                                                sumMm0_u5, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 6) * fusionSize + mmSegmentOffset,
                                                sumMm0_u6, mmSegmentSize);
                AscendC::MicroAPI::Store<float>(mmOut + (row + 7) * fusionSize + mmSegmentOffset,
                                                sumMm0_u7, mmSegmentSize);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* mmPartial = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* rmsPartial = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* mmOut = (__ubuf__ float*)get_imm(49920);
    __ubuf__ float* invRmsOut = (__ubuf__ float*)get_imm(62208);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 49920, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(mmPartial, rmsPartial, mmOut, invRmsOut);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)mmOut, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)invRmsOut, 0, 1, 192, 0, 0, 0);
}
