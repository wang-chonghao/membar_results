        AscendC::MicroAPI::RegTensor<float> sumRms2;
        AscendC::MicroAPI::RegTensor<float> sumRms3;
        AscendC::MicroAPI::RegTensor<float> sumMm0;
        AscendC::MicroAPI::RegTensor<float> sumMm1;
        AscendC::MicroAPI::RegTensor<float> sumMm2;
        AscendC::MicroAPI::RegTensor<float> sumMm3;
        AscendC::MicroAPI::RegTensor<float> one;
        uint32_t rmsMaskSize = 1U;
        uint32_t mmMaskSize = mmSegmentSize;
        vector_bool rmsMask = plt_b32(rmsMaskSize, POST_UPDATE);
        vector_bool mmMask = plt_b32(mmMaskSize, POST_UPDATE);
        vdup(one, 1.0f, rmsMask, MODE_ZEROING);

        {
            AscendC::MicroAPI::RegTensor<float> mm0_u0;
            AscendC::MicroAPI::RegTensor<float> mm0_u1;
            AscendC::MicroAPI::RegTensor<float> mm0_u2;
            AscendC::MicroAPI::RegTensor<float> mm0_u3;
            AscendC::MicroAPI::RegTensor<float> mm0_u4;
            AscendC::MicroAPI::RegTensor<float> mm0_u5;
            AscendC::MicroAPI::RegTensor<float> mm0_u6;
            AscendC::MicroAPI::RegTensor<float> mm0_u7;
            AscendC::MicroAPI::RegTensor<float> mm1_u0;
            AscendC::MicroAPI::RegTensor<float> mm1_u1;
            AscendC::MicroAPI::RegTensor<float> mm1_u2;
            AscendC::MicroAPI::RegTensor<float> mm1_u3;
            AscendC::MicroAPI::RegTensor<float> mm1_u4;
            AscendC::MicroAPI::RegTensor<float> mm1_u5;
            AscendC::MicroAPI::RegTensor<float> mm1_u6;
            AscendC::MicroAPI::RegTensor<float> mm1_u7;
            AscendC::MicroAPI::RegTensor<float> mm2_u0;
            AscendC::MicroAPI::RegTensor<float> mm2_u1;
            AscendC::MicroAPI::RegTensor<float> mm2_u2;
            AscendC::MicroAPI::RegTensor<float> mm2_u3;
            AscendC::MicroAPI::RegTensor<float> mm2_u4;
            AscendC::MicroAPI::RegTensor<float> mm2_u5;
            AscendC::MicroAPI::RegTensor<float> mm2_u6;
            AscendC::MicroAPI::RegTensor<float> mm2_u7;
            AscendC::MicroAPI::RegTensor<float> mm3_u0;
            AscendC::MicroAPI::RegTensor<float> mm3_u1;
            AscendC::MicroAPI::RegTensor<float> mm3_u2;
            AscendC::MicroAPI::RegTensor<float> mm3_u3;
            AscendC::MicroAPI::RegTensor<float> mm3_u4;
            AscendC::MicroAPI::RegTensor<float> mm3_u5;
            AscendC::MicroAPI::RegTensor<float> mm3_u6;
            AscendC::MicroAPI::RegTensor<float> mm3_u7;
            AscendC::MicroAPI::RegTensor<float> rms0_u0;
            AscendC::MicroAPI::RegTensor<float> rms0_u1;
            AscendC::MicroAPI::RegTensor<float> rms0_u2;
            AscendC::MicroAPI::RegTensor<float> rms0_u3;
            AscendC::MicroAPI::RegTensor<float> rms0_u4;
            AscendC::MicroAPI::RegTensor<float> rms0_u5;
            AscendC::MicroAPI::RegTensor<float> rms0_u6;
            AscendC::MicroAPI::RegTensor<float> rms0_u7;
            AscendC::MicroAPI::RegTensor<float> rms1_u0;
            AscendC::MicroAPI::RegTensor<float> rms1_u1;
            AscendC::MicroAPI::RegTensor<float> rms1_u2;
            AscendC::MicroAPI::RegTensor<float> rms1_u3;
            AscendC::MicroAPI::RegTensor<float> rms1_u4;
            AscendC::MicroAPI::RegTensor<float> rms1_u5;
            AscendC::MicroAPI::RegTensor<float> rms1_u6;
            AscendC::MicroAPI::RegTensor<float> rms1_u7;
            AscendC::MicroAPI::RegTensor<float> rms2_u0;
            AscendC::MicroAPI::RegTensor<float> rms2_u1;
            AscendC::MicroAPI::RegTensor<float> rms2_u2;
            AscendC::MicroAPI::RegTensor<float> rms2_u3;
            AscendC::MicroAPI::RegTensor<float> rms2_u4;
            AscendC::MicroAPI::RegTensor<float> rms2_u5;
            AscendC::MicroAPI::RegTensor<float> rms2_u6;
            AscendC::MicroAPI::RegTensor<float> rms2_u7;
            AscendC::MicroAPI::RegTensor<float> rms3_u0;
            AscendC::MicroAPI::RegTensor<float> rms3_u1;
            AscendC::MicroAPI::RegTensor<float> rms3_u2;
            AscendC::MicroAPI::RegTensor<float> rms3_u3;
            AscendC::MicroAPI::RegTensor<float> rms3_u4;
            AscendC::MicroAPI::RegTensor<float> rms3_u5;
            AscendC::MicroAPI::RegTensor<float> rms3_u6;
            AscendC::MicroAPI::RegTensor<float> rms3_u7;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u2;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u3;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u4;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u5;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u6;
            AscendC::MicroAPI::RegTensor<float> sumMm0_u7;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u2;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u3;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u4;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u5;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u6;
            AscendC::MicroAPI::RegTensor<float> sumMm1_u7;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u2;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u3;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u4;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u5;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u6;
            AscendC::MicroAPI::RegTensor<float> sumMm2_u7;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u0;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u1;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u2;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u3;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u4;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u5;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u6;
            AscendC::MicroAPI::RegTensor<float> sumMm3_u7;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u2;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u3;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u4;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u5;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u6;
            AscendC::MicroAPI::RegTensor<float> sumRms0_u7;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u2;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u3;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u4;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u5;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u6;
            AscendC::MicroAPI::RegTensor<float> sumRms1_u7;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u2;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u3;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u4;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u5;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u6;
            AscendC::MicroAPI::RegTensor<float> sumRms2_u7;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u0;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u1;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u2;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u3;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u4;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u5;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u6;
            AscendC::MicroAPI::RegTensor<float> sumRms3_u7;
#pragma unroll 1
            for (uint32_t row = 0; row < 48; row += 8) {
                vdup(sumRms0_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u2, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u3, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u4, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u5, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u6, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms0_u7, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u2, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u3, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u4, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u5, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u6, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms1_u7, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u2, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u3, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u4, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u5, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u6, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms2_u7, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u0, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u1, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u2, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u3, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u4, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u5, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u6, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumRms3_u7, 0.0f, rmsMask, MODE_ZEROING);
                vdup(sumMm0_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u2, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u3, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u4, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u5, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u6, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm0_u7, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u2, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u3, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u4, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u5, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u6, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm1_u7, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u2, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u3, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u4, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u5, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u6, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm2_u7, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u0, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u1, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u2, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u3, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u4, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u5, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u6, 0.0f, mmMask, MODE_ZEROING);
                vdup(sumMm3_u7, 0.0f, mmMask, MODE_ZEROING);
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 0)), 0,
                         BRC_B32);
                    vlds(rms1_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vlds(rms2_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vlds(rms3_u0,
                         rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + (row + 0)),
                         0, BRC_B32);
                    vadd(sumRms0_u0, sumRms0_u0, rms0_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms1_u0, sumRms1_u0, rms1_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms2_u0, sumRms2_u0, rms2_u0, rmsMask, MODE_ZEROING);
                    vadd(sumRms3_u0, sumRms3_u0, rms3_u0, rmsMask, MODE_ZEROING);

                    AscendC::MicroAPI::Load<float>(
                        mm0_u0, mmPartial + static_cast<uint32_t>(kBase) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm1_u0, mmPartial + static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm2_u0, mmPartial + static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm3_u0, mmPartial + static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                    (row + 0) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u0, sumMm0_u0, mm0_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm1_u0, sumMm1_u0, mm1_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm2_u0, sumMm2_u0, mm2_u0, mmMask, MODE_ZEROING);
                    vadd(sumMm3_u0, sumMm3_u0, mm3_u0, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 1)), 0,
                         BRC_B32);
                    vlds(rms1_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vlds(rms2_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vlds(rms3_u1,
                         rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + (row + 1)),
                         0, BRC_B32);
                    vadd(sumRms0_u1, sumRms0_u1, rms0_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms1_u1, sumRms1_u1, rms1_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms2_u1, sumRms2_u1, rms2_u1, rmsMask, MODE_ZEROING);
                    vadd(sumRms3_u1, sumRms3_u1, rms3_u1, rmsMask, MODE_ZEROING);

                    AscendC::MicroAPI::Load<float>(
                        mm0_u1, mmPartial + static_cast<uint32_t>(kBase) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm1_u1, mmPartial + static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm2_u1, mmPartial + static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm3_u1, mmPartial + static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                    (row + 1) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u1, sumMm0_u1, mm0_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm1_u1, sumMm1_u1, mm1_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm2_u1, sumMm2_u1, mm2_u1, mmMask, MODE_ZEROING);
                    vadd(sumMm3_u1, sumMm3_u1, mm3_u1, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u2,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 2)), 0,
                         BRC_B32);
                    vlds(rms1_u2,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 2)),
                         0, BRC_B32);
                    vlds(rms2_u2,
                         rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + (row + 2)),
                         0, BRC_B32);
                    vlds(rms3_u2,
                         rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + (row + 2)),
                         0, BRC_B32);
                    vadd(sumRms0_u2, sumRms0_u2, rms0_u2, rmsMask, MODE_ZEROING);
                    vadd(sumRms1_u2, sumRms1_u2, rms1_u2, rmsMask, MODE_ZEROING);
                    vadd(sumRms2_u2, sumRms2_u2, rms2_u2, rmsMask, MODE_ZEROING);
                    vadd(sumRms3_u2, sumRms3_u2, rms3_u2, rmsMask, MODE_ZEROING);

                    AscendC::MicroAPI::Load<float>(
                        mm0_u2, mmPartial + static_cast<uint32_t>(kBase) * mmGroupStride +
                                    (row + 2) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm1_u2, mmPartial + static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                    (row + 2) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm2_u2, mmPartial + static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                    (row + 2) * fusionSize + mmSegmentOffset);
                    AscendC::MicroAPI::Load<float>(
                        mm3_u2, mmPartial + static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                    (row + 2) * fusionSize + mmSegmentOffset);
                    vadd(sumMm0_u2, sumMm0_u2, mm0_u2, mmMask, MODE_ZEROING);
                    vadd(sumMm1_u2, sumMm1_u2, mm1_u2, mmMask, MODE_ZEROING);
                    vadd(sumMm2_u2, sumMm2_u2, mm2_u2, mmMask, MODE_ZEROING);
                    vadd(sumMm3_u2, sumMm3_u2, mm3_u2, mmMask, MODE_ZEROING);
                }
#pragma unroll 1

                for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                    uint16_t kBase = loop * 4U;
                    vlds(rms0_u3,
                         rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + (row + 3)), 0,
                         BRC_B32);
                    vlds(rms1_u3,
                         rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + (row + 3)),
                         0, BRC_B32);
                    vlds(rms2_u3,
