#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* mmPartial, __ubuf__ float* rmsPartial,
                                    __ubuf__ float* mmOut, __ubuf__ float* invRmsOut) {
    uint16_t rowCount = 48, fusionSize = 64, mmSegmentOffset = 0, mmSegmentSize = 64,
             rmsStride = 48, fourLoopCount = 1, tailLoopCount = 0;
    uint32_t mmGroupStride = 3072;
    float scaleMean = 0.25f, normEps = 1e-5f;
    __VEC_SCOPE__ {
        AscendC::MicroAPI::RegTensor<float> rms0;
        AscendC::MicroAPI::RegTensor<float> rms1;
        AscendC::MicroAPI::RegTensor<float> rms2;
        AscendC::MicroAPI::RegTensor<float> rms3;
        AscendC::MicroAPI::RegTensor<float> mm0;
        AscendC::MicroAPI::RegTensor<float> mm1;
        AscendC::MicroAPI::RegTensor<float> mm2;
        AscendC::MicroAPI::RegTensor<float> mm3;
        AscendC::MicroAPI::RegTensor<float> sumRms0;
