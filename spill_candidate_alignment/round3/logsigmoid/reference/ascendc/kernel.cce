#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* srcAddr, __ubuf__ float* dstAddr) {
    uint32_t count = 3072, vlSize = 64;
    uint16_t loopNum = 48;
    float valZero = 0.0f, valPosOne = 1.0f, valNegOne = -1.0f;
    __VEC_SCOPE__ {
        // init vars
        RegTensor<float> x;
        RegTensor<float> zeroReg;
        RegTensor<float> xAbs;
        RegTensor<float> xAbsNeg;
        RegTensor<float> expRes;
        RegTensor<float> expResPlusOne;
        RegTensor<float> expResPlusOneSubOne;
        RegTensor<float> logExpXPlus1;
        RegTensor<float> divRes;
        RegTensor<float> mulRes;
        RegTensor<float> minRes;
        RegTensor<float> selectRes;
        RegTensor<float> ans;

        MaskReg mask;
        MaskReg cmpLog1pPosMaskReg;

        Duplicate(zeroReg, valZero);

#pragma unroll 1

        for (uint16_t loopIdx = 0; loopIdx < loopNum; loopIdx++) {
            // regCopyIn
            mask = UpdateMask<float>(count);
            DataCopy(x, (__ubuf__ float*)(srcAddr + loopIdx * vlSize));
            Min(minRes, x, zeroReg, mask);        // x1 = min(x, 0)
            Abs(xAbs, x, mask);                   // x2 = abs(x)
            Muls(xAbsNeg, xAbs, valNegOne, mask); // x3 = -x2
            Exp(expRes, xAbsNeg, mask);           // x4 = e^x3
            // log1p
            Adds(expResPlusOne, expRes, valPosOne, mask);              // y1 = 1 + x4
            Adds(expResPlusOneSubOne, expResPlusOne, valNegOne, mask); // y2 = y1 - 1
            Div(divRes, expRes, expResPlusOneSubOne, mask);            // y3 = x4 / y2
            Log(logExpXPlus1, expResPlusOne, mask);                    // y4 = log(y1)
            Mul(mulRes, logExpXPlus1, divRes, mask);                   // y5 = y4 * y3
            CompareScalar<float, CMPMODE::NE>(cmpLog1pPosMaskReg, expResPlusOne, valPosOne, mask);
            Select(selectRes, mulRes, expRes, cmpLog1pPosMaskReg); // z1 = select(x4, y5)
            Sub(ans, minRes, selectRes, mask);                     // z2 = x1 - z1

            // regCopyOut
            DataCopy((__ubuf__ float*)(dstAddr + loopIdx * vlSize), ans, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* srcAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dstAddr = (__ubuf__ float*)get_imm(12288);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12288, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(srcAddr, dstAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dstAddr, 0, 1, 12288, 0, 0, 0);
}
