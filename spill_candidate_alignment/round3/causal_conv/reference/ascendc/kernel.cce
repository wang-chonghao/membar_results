#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
constexpr CastTrait castTraitB162B32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                        RoundMode::UNKNOWN};
constexpr CastTrait castTraitB322B16 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING,
                                        RoundMode::CAST_RINT};
__aicore__ inline void candidate_vf(__ubuf__ half* xAddr, __ubuf__ half* weightAddr,
                                    __ubuf__ half* yAddr) {
    uint32_t xLoopNum = 24, dimLen = 192;
    constexpr uint32_t B32_REP_SIZE = 64;
    __VEC_SCOPE__ {
        Reg::RegTensor<float> weight11B32, weight12B32, weight13B32, x11B32, x12B32, x13B32,
            mul11B32, mul12B32, mul13B32, y1B32;
        Reg::RegTensor<float> weight21B32, weight22B32, weight23B32, x21B32, x22B32, x23B32,
            mul21B32, mul22B32, mul23B32, y2B32;
        Reg::RegTensor<float> x31B32, x32B32, x33B32, mul31B32, mul32B32, mul33B32, y3B32;
        Reg::RegTensor<float> x41B32, x42B32, x43B32, mul41B32, mul42B32, mul43B32, y4B32;
        Reg::RegTensor<half> weight11B16, weight12B16, weight13B16, x11B16, x12B16, x13B16, y1B16;
        Reg::RegTensor<half> weight21B16, weight22B16, weight23B16, x21B16, x22B16, x23B16, y2B16;
        Reg::RegTensor<half> x31B16, x32B16, x33B16, y3B16;
        Reg::RegTensor<half> x41B16, x42B16, x43B16, y4B16;
        uint8_t dimLoopNum = dimLen / (B32_REP_SIZE * 2);
        uint8_t dimRem = dimLen - dimLoopNum * B32_REP_SIZE * 2;
        Reg::MaskReg maskB32 = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
        Reg::MaskReg maskRem;
        int32_t offset = 0;
#pragma unroll 1
        for (uint8_t dimLoop = 0; dimLoop < dimLoopNum; dimLoop++) {
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight11B16, weightAddr + offset);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight12B16,
                                                                 weightAddr + offset + dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight13B16,
                                                                 weightAddr + offset + 2 * dimLen);
            Reg::Cast<float, half, castTraitB162B32>(weight11B32, weight11B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(weight12B32, weight12B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(weight13B32, weight13B16, maskB32);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight21B16, weightAddr + offset +
                                                                                  B32_REP_SIZE);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                weight22B16, weightAddr + offset + B32_REP_SIZE + dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                weight23B16, weightAddr + offset + B32_REP_SIZE + 2 * dimLen);
            Reg::Cast<float, half, castTraitB162B32>(weight21B32, weight21B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(weight22B32, weight22B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(weight23B32, weight23B16, maskB32);
#pragma unroll 1
            for (uint32_t xLoop = 0; xLoop < xLoopNum; xLoop++) {
                Reg::Duplicate(y1B32, 0, maskB32);
                Reg::Duplicate(y2B32, 0, maskB32);
                Reg::Duplicate(y3B32, 0, maskB32);
                Reg::Duplicate(y4B32, 0, maskB32);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x11B16, xAddr + offset + 2 * xLoop * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x12B16, xAddr + offset + (2 * xLoop + 1) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x13B16, xAddr + offset + (2 * xLoop + 2) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x31B16, xAddr + offset + (2 * xLoop + 1) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x32B16, xAddr + offset + (2 * xLoop + 2) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x33B16, xAddr + offset + (2 * xLoop + 3) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x41B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x42B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen);
                Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                    x43B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 3) * dimLen);
                Reg::Cast<float, half, castTraitB162B32>(x11B32, x11B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x12B32, x12B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x13B32, x13B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x21B32, x21B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x22B32, x22B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x23B32, x23B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x31B32, x31B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x32B32, x32B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x33B32, x33B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x41B32, x41B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x42B32, x42B16, maskB32);
                Reg::Cast<float, half, castTraitB162B32>(x43B32, x43B16, maskB32);
                Reg::Mul(mul11B32, x11B32, weight11B32, maskB32);
                Reg::Mul(mul12B32, x12B32, weight12B32, maskB32);
                Reg::Mul(mul13B32, x13B32, weight13B32, maskB32);
                Reg::Mul(mul21B32, x21B32, weight21B32, maskB32);
                Reg::Mul(mul22B32, x22B32, weight22B32, maskB32);
                Reg::Mul(mul23B32, x23B32, weight23B32, maskB32);
                Reg::Mul(mul31B32, x31B32, weight11B32, maskB32);
                Reg::Mul(mul32B32, x32B32, weight12B32, maskB32);
                Reg::Mul(mul33B32, x33B32, weight13B32, maskB32);
                Reg::Mul(mul41B32, x41B32, weight21B32, maskB32);
                Reg::Mul(mul42B32, x42B32, weight22B32, maskB32);
                Reg::Mul(mul43B32, x43B32, weight23B32, maskB32);

                Reg::Add(y1B32, y1B32, mul11B32, maskB32);
                Reg::Add(y1B32, y1B32, mul12B32, maskB32);
                Reg::Add(y1B32, y1B32, mul13B32, maskB32);
                Reg::Add(y1B32, y1B32, x13B32, maskB32);
                Reg::Add(y2B32, y2B32, mul21B32, maskB32);
                Reg::Add(y2B32, y2B32, mul22B32, maskB32);
                Reg::Add(y2B32, y2B32, mul23B32, maskB32);
                Reg::Add(y2B32, y2B32, x23B32, maskB32);
                Reg::Add(y3B32, y3B32, mul31B32, maskB32);
                Reg::Add(y3B32, y3B32, mul32B32, maskB32);
                Reg::Add(y3B32, y3B32, mul33B32, maskB32);
                Reg::Add(y3B32, y3B32, x33B32, maskB32);
                Reg::Add(y4B32, y4B32, mul41B32, maskB32);
                Reg::Add(y4B32, y4B32, mul42B32, maskB32);
                Reg::Add(y4B32, y4B32, mul43B32, maskB32);
                Reg::Add(y4B32, y4B32, x43B32, maskB32);
                Reg::Cast<half, float, castTraitB322B16>(y1B16, y1B32, maskB32);
                Reg::Cast<half, float, castTraitB322B16>(y2B16, y2B32, maskB32);
                Reg::Cast<half, float, castTraitB322B16>(y3B16, y3B32, maskB32);
                Reg::Cast<half, float, castTraitB322B16>(y4B16, y4B32, maskB32);
                Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                    yAddr + offset + 2 * xLoop * dimLen, y1B16, maskB32);
                Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                    yAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen, y2B16, maskB32);
                Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                    yAddr + offset + (2 * xLoop + 1) * dimLen, y3B16, maskB32);
                Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                    yAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, y4B16, maskB32);
            }
            Reg::Duplicate(y1B32, 0, maskB32);
            Reg::Duplicate(y2B32, 0, maskB32);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(x11B16, xAddr + offset +
                                                                             2 * xLoopNum * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x12B16, xAddr + offset + (2 * xLoopNum + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x13B16, xAddr + offset + (2 * xLoopNum + 2) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoopNum * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 2) * dimLen);
            Reg::Cast<float, half, castTraitB162B32>(x11B32, x11B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x12B32, x12B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x13B32, x13B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x21B32, x21B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x22B32, x22B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x23B32, x23B16, maskB32);
            Reg::Mul(mul11B32, x11B32, weight11B32, maskB32);
            Reg::Mul(mul12B32, x12B32, weight12B32, maskB32);
            Reg::Mul(mul13B32, x13B32, weight13B32, maskB32);
            Reg::Mul(mul21B32, x21B32, weight21B32, maskB32);
            Reg::Mul(mul22B32, x22B32, weight22B32, maskB32);
            Reg::Mul(mul23B32, x23B32, weight23B32, maskB32);
            Reg::Add(y1B32, y1B32, mul11B32, maskB32);
            Reg::Add(y1B32, y1B32, mul12B32, maskB32);
            Reg::Add(y1B32, y1B32, mul13B32, maskB32);
            Reg::Add(y1B32, y1B32, x13B32, maskB32);
            Reg::Add(y2B32, y2B32, mul21B32, maskB32);
            Reg::Add(y2B32, y2B32, mul22B32, maskB32);
            Reg::Add(y2B32, y2B32, mul23B32, maskB32);
            Reg::Add(y2B32, y2B32, x23B32, maskB32);
            Reg::Cast<half, float, castTraitB322B16>(y1B16, y1B32, maskB32);
            Reg::Cast<half, float, castTraitB322B16>(y2B16, y2B32, maskB32);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + offset + 2 * xLoopNum * dimLen, y1B16, maskB32);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + offset + B32_REP_SIZE + 2 * xLoopNum * dimLen, y2B16, maskB32);

            offset += 2 * B32_REP_SIZE;
        }
        // 尾块双寄存器处理
        uint32_t sreg = dimRem - B32_REP_SIZE;
        maskRem = Reg::UpdateMask<float>(sreg);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight11B16, weightAddr + offset);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight12B16,
                                                             weightAddr + offset + dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight13B16,
                                                             weightAddr + offset + 2 * dimLen);
        Reg::Cast<float, half, castTraitB162B32>(weight11B32, weight11B16, maskB32);
        Reg::Cast<float, half, castTraitB162B32>(weight12B32, weight12B16, maskB32);
        Reg::Cast<float, half, castTraitB162B32>(weight13B32, weight13B16, maskB32);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(weight21B16,
                                                             weightAddr + offset + B32_REP_SIZE);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            weight22B16, weightAddr + offset + B32_REP_SIZE + dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            weight23B16, weightAddr + offset + B32_REP_SIZE + 2 * dimLen);
        Reg::Cast<float, half, castTraitB162B32>(weight21B32, weight21B16, maskRem);
        Reg::Cast<float, half, castTraitB162B32>(weight22B32, weight22B16, maskRem);
        Reg::Cast<float, half, castTraitB162B32>(weight23B32, weight23B16, maskRem);
#pragma unroll 1
        for (uint32_t xLoop = 0; xLoop < xLoopNum; xLoop++) {
            Reg::Duplicate(y1B32, 0, maskB32);
            Reg::Duplicate(y2B32, 0, maskRem);
            Reg::Duplicate(y3B32, 0, maskB32);
            Reg::Duplicate(y4B32, 0, maskRem);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(x11B16, xAddr + offset +
                                                                             2 * xLoop * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x12B16, xAddr + offset + (2 * xLoop + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x13B16, xAddr + offset + (2 * xLoop + 2) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x31B16, xAddr + offset + (2 * xLoop + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x32B16, xAddr + offset + (2 * xLoop + 2) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x33B16, xAddr + offset + (2 * xLoop + 3) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x41B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x42B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen);
            Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
                x43B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 3) * dimLen);
            Reg::Cast<float, half, castTraitB162B32>(x11B32, x11B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x12B32, x12B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x13B32, x13B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x21B32, x21B16, maskRem);
            Reg::Cast<float, half, castTraitB162B32>(x22B32, x22B16, maskRem);
            Reg::Cast<float, half, castTraitB162B32>(x23B32, x23B16, maskRem);
            Reg::Cast<float, half, castTraitB162B32>(x31B32, x31B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x32B32, x32B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x33B32, x33B16, maskB32);
            Reg::Cast<float, half, castTraitB162B32>(x41B32, x41B16, maskRem);
            Reg::Cast<float, half, castTraitB162B32>(x42B32, x42B16, maskRem);
            Reg::Cast<float, half, castTraitB162B32>(x43B32, x43B16, maskRem);
            Reg::Mul(mul11B32, x11B32, weight11B32, maskB32);
            Reg::Mul(mul12B32, x12B32, weight12B32, maskB32);
            Reg::Mul(mul13B32, x13B32, weight13B32, maskB32);
            Reg::Mul(mul21B32, x21B32, weight21B32, maskRem);
            Reg::Mul(mul22B32, x22B32, weight22B32, maskRem);
            Reg::Mul(mul23B32, x23B32, weight23B32, maskRem);
            Reg::Mul(mul31B32, x31B32, weight11B32, maskB32);
            Reg::Mul(mul32B32, x32B32, weight12B32, maskB32);
            Reg::Mul(mul33B32, x33B32, weight13B32, maskB32);
            Reg::Mul(mul41B32, x41B32, weight21B32, maskRem);
            Reg::Mul(mul42B32, x42B32, weight22B32, maskRem);
            Reg::Mul(mul43B32, x43B32, weight23B32, maskRem);
            Reg::Add(y1B32, y1B32, mul11B32, maskB32);
            Reg::Add(y1B32, y1B32, mul12B32, maskB32);
            Reg::Add(y1B32, y1B32, mul13B32, maskB32);
            Reg::Add(y1B32, y1B32, x13B32, maskB32);
            Reg::Add(y2B32, y2B32, mul21B32, maskRem);
            Reg::Add(y2B32, y2B32, mul22B32, maskRem);
            Reg::Add(y2B32, y2B32, mul23B32, maskRem);
            Reg::Add(y2B32, y2B32, x23B32, maskRem);
            Reg::Add(y3B32, y3B32, mul31B32, maskB32);
            Reg::Add(y3B32, y3B32, mul32B32, maskB32);
            Reg::Add(y3B32, y3B32, mul33B32, maskB32);
            Reg::Add(y3B32, y3B32, x33B32, maskB32);
            Reg::Add(y4B32, y4B32, mul41B32, maskRem);
            Reg::Add(y4B32, y4B32, mul42B32, maskRem);
            Reg::Add(y4B32, y4B32, mul43B32, maskRem);
            Reg::Add(y4B32, y4B32, x43B32, maskRem);
            Reg::Cast<half, float, castTraitB322B16>(y1B16, y1B32, maskB32);
            Reg::Cast<half, float, castTraitB322B16>(y2B16, y2B32, maskRem);
            Reg::Cast<half, float, castTraitB322B16>(y3B16, y3B32, maskB32);
            Reg::Cast<half, float, castTraitB322B16>(y4B16, y4B32, maskRem);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + dimLoopNum * B32_REP_SIZE * 2 + 2 * xLoop * dimLen, y1B16, maskB32);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + 2 * xLoop * dimLen, y2B16,
                maskRem);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + dimLoopNum * B32_REP_SIZE * 2 + (2 * xLoop + 1) * dimLen, y3B16, maskB32);
            Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
                yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + (2 * xLoop + 1) * dimLen,
                y4B16, maskRem);
        }
        Reg::Duplicate(y1B32, 0, maskB32);
        Reg::Duplicate(y2B32, 0, maskRem);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(x11B16, xAddr + offset +
                                                                         2 * xLoopNum * dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            x12B16, xAddr + offset + (2 * xLoopNum + 1) * dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            x13B16, xAddr + offset + (2 * xLoopNum + 2) * dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(x21B16, xAddr + offset + B32_REP_SIZE +
                                                                         2 * xLoopNum * dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 1) * dimLen);
        Reg::LoadAlign<half, Reg::LoadDist::DIST_UNPACK_B16>(
            x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 2) * dimLen);
        Reg::Cast<float, half, castTraitB162B32>(x11B32, x11B16, maskB32);
        Reg::Cast<float, half, castTraitB162B32>(x12B32, x12B16, maskB32);
        Reg::Cast<float, half, castTraitB162B32>(x13B32, x13B16, maskB32);
        Reg::Cast<float, half, castTraitB162B32>(x21B32, x21B16, maskRem);
        Reg::Cast<float, half, castTraitB162B32>(x22B32, x22B16, maskRem);
        Reg::Cast<float, half, castTraitB162B32>(x23B32, x23B16, maskRem);
        Reg::Mul(mul11B32, x11B32, weight11B32, maskB32);
        Reg::Mul(mul12B32, x12B32, weight12B32, maskB32);
        Reg::Mul(mul13B32, x13B32, weight13B32, maskB32);
        Reg::Mul(mul21B32, x21B32, weight21B32, maskRem);
        Reg::Mul(mul22B32, x22B32, weight22B32, maskRem);
        Reg::Mul(mul23B32, x23B32, weight23B32, maskRem);
        Reg::Add(y1B32, y1B32, mul11B32, maskB32);
        Reg::Add(y1B32, y1B32, mul12B32, maskB32);
        Reg::Add(y1B32, y1B32, mul13B32, maskB32);
        Reg::Add(y1B32, y1B32, x13B32, maskB32);
        Reg::Add(y2B32, y2B32, mul21B32, maskRem);
        Reg::Add(y2B32, y2B32, mul22B32, maskRem);
        Reg::Add(y2B32, y2B32, mul23B32, maskRem);
        Reg::Add(y2B32, y2B32, x23B32, maskRem);
        Reg::Cast<half, float, castTraitB322B16>(y1B16, y1B32, maskB32);
        Reg::Cast<half, float, castTraitB322B16>(y2B16, y2B32, maskRem);
        Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
            yAddr + dimLoopNum * B32_REP_SIZE * 2 + 2 * xLoopNum * dimLen, y1B16, maskB32);
        Reg::StoreAlign<half, Reg::StoreDist::DIST_PACK_B32>(
            yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + 2 * xLoopNum * dimLen, y2B16,
            maskRem);
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ half* xAddr = (__ubuf__ half*)get_imm(0);
    __ubuf__ half* weightAddr = (__ubuf__ half*)get_imm(19968);
    __ubuf__ half* yAddr = (__ubuf__ half*)get_imm(21504);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 21504, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, weightAddr, yAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)yAddr, 0, 1, 18816, 0, 0, 0);
}
