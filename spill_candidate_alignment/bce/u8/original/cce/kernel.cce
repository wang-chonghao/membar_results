                vadds(regOneAddExp_u6, regExpNegAbsX_u6, (float)1.0f, pregUp_u6, MODE_ZEROING);
                vadds(regOneAddExp_u7, regExpNegAbsX_u7, (float)1.0f, pregUp_u7, MODE_ZEROING);
                vln(regLog_u0, regOneAddExp_u0, pregUp_u0, MODE_ZEROING);
                vln(regLog_u1, regOneAddExp_u1, pregUp_u1, MODE_ZEROING);
                vln(regLog_u2, regOneAddExp_u2, pregUp_u2, MODE_ZEROING);
                vln(regLog_u3, regOneAddExp_u3, pregUp_u3, MODE_ZEROING);
                vln(regLog_u4, regOneAddExp_u4, pregUp_u4, MODE_ZEROING);
                vln(regLog_u5, regOneAddExp_u5, pregUp_u5, MODE_ZEROING);
                vln(regLog_u6, regOneAddExp_u6, pregUp_u6, MODE_ZEROING);
                vln(regLog_u7, regOneAddExp_u7, pregUp_u7, MODE_ZEROING);
                vsub(regLogSigmoid_u0, regMinVal_u0, regLog_u0, pregUp_u0, MODE_ZEROING);
                vsub(regLogSigmoid_u1, regMinVal_u1, regLog_u1, pregUp_u1, MODE_ZEROING);
                vsub(regLogSigmoid_u2, regMinVal_u2, regLog_u2, pregUp_u2, MODE_ZEROING);
                vsub(regLogSigmoid_u3, regMinVal_u3, regLog_u3, pregUp_u3, MODE_ZEROING);
                vsub(regLogSigmoid_u4, regMinVal_u4, regLog_u4, pregUp_u4, MODE_ZEROING);
                vsub(regLogSigmoid_u5, regMinVal_u5, regLog_u5, pregUp_u5, MODE_ZEROING);
                vsub(regLogSigmoid_u6, regMinVal_u6, regLog_u6, pregUp_u6, MODE_ZEROING);
                vsub(regLogSigmoid_u7, regMinVal_u7, regLog_u7, pregUp_u7, MODE_ZEROING);
                vsub(regPWSubOne_u0, regPosWeight_u0, regOne_u0, pregUp_u0, MODE_ZEROING);
                vsub(regPWSubOne_u1, regPosWeight_u1, regOne_u1, pregUp_u1, MODE_ZEROING);
                vsub(regPWSubOne_u2, regPosWeight_u2, regOne_u2, pregUp_u2, MODE_ZEROING);
                vsub(regPWSubOne_u3, regPosWeight_u3, regOne_u3, pregUp_u3, MODE_ZEROING);
                vsub(regPWSubOne_u4, regPosWeight_u4, regOne_u4, pregUp_u4, MODE_ZEROING);
                vsub(regPWSubOne_u5, regPosWeight_u5, regOne_u5, pregUp_u5, MODE_ZEROING);
                vsub(regPWSubOne_u6, regPosWeight_u6, regOne_u6, pregUp_u6, MODE_ZEROING);
                vsub(regPWSubOne_u7, regPosWeight_u7, regOne_u7, pregUp_u7, MODE_ZEROING);
                vmul(regPWSubOneMulY_u0, regPWSubOne_u0, regY_u0, pregUp_u0, MODE_ZEROING);
                vmul(regPWSubOneMulY_u1, regPWSubOne_u1, regY_u1, pregUp_u1, MODE_ZEROING);
                vmul(regPWSubOneMulY_u2, regPWSubOne_u2, regY_u2, pregUp_u2, MODE_ZEROING);
                vmul(regPWSubOneMulY_u3, regPWSubOne_u3, regY_u3, pregUp_u3, MODE_ZEROING);
                vmul(regPWSubOneMulY_u4, regPWSubOne_u4, regY_u4, pregUp_u4, MODE_ZEROING);
                vmul(regPWSubOneMulY_u5, regPWSubOne_u5, regY_u5, pregUp_u5, MODE_ZEROING);
                vmul(regPWSubOneMulY_u6, regPWSubOne_u6, regY_u6, pregUp_u6, MODE_ZEROING);
                vmul(regPWSubOneMulY_u7, regPWSubOne_u7, regY_u7, pregUp_u7, MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u0, regPWSubOneMulY_u0, (float)1.0f, pregUp_u0,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u1, regPWSubOneMulY_u1, (float)1.0f, pregUp_u1,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u2, regPWSubOneMulY_u2, (float)1.0f, pregUp_u2,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u3, regPWSubOneMulY_u3, (float)1.0f, pregUp_u3,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u4, regPWSubOneMulY_u4, (float)1.0f, pregUp_u4,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u5, regPWSubOneMulY_u5, (float)1.0f, pregUp_u5,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u6, regPWSubOneMulY_u6, (float)1.0f, pregUp_u6,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u7, regPWSubOneMulY_u7, (float)1.0f, pregUp_u7,
                      MODE_ZEROING);
                vmul(regLogSigmoid_u0, regLogSigmoid_u0, regPWSubOneMulYAddOne_u0, pregUp_u0,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u1, regLogSigmoid_u1, regPWSubOneMulYAddOne_u1, pregUp_u1,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u2, regLogSigmoid_u2, regPWSubOneMulYAddOne_u2, pregUp_u2,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u3, regLogSigmoid_u3, regPWSubOneMulYAddOne_u3, pregUp_u3,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u4, regLogSigmoid_u4, regPWSubOneMulYAddOne_u4, pregUp_u4,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u5, regLogSigmoid_u5, regPWSubOneMulYAddOne_u5, pregUp_u5,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u6, regLogSigmoid_u6, regPWSubOneMulYAddOne_u6, pregUp_u6,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u7, regLogSigmoid_u7, regPWSubOneMulYAddOne_u7, pregUp_u7,
                     MODE_ZEROING);
                vsub(regOneSubY_u0, regOne_u0, regY_u0, pregUp_u0, MODE_ZEROING);
                vsub(regOneSubY_u1, regOne_u1, regY_u1, pregUp_u1, MODE_ZEROING);
                vsub(regOneSubY_u2, regOne_u2, regY_u2, pregUp_u2, MODE_ZEROING);
                vsub(regOneSubY_u3, regOne_u3, regY_u3, pregUp_u3, MODE_ZEROING);
                vsub(regOneSubY_u4, regOne_u4, regY_u4, pregUp_u4, MODE_ZEROING);
                vsub(regOneSubY_u5, regOne_u5, regY_u5, pregUp_u5, MODE_ZEROING);
                vsub(regOneSubY_u6, regOne_u6, regY_u6, pregUp_u6, MODE_ZEROING);
                vsub(regOneSubY_u7, regOne_u7, regY_u7, pregUp_u7, MODE_ZEROING);
                vmul(regOneSubYMulX_u0, regOneSubY_u0, regX_u0, pregUp_u0, MODE_ZEROING);
                vmul(regOneSubYMulX_u1, regOneSubY_u1, regX_u1, pregUp_u1, MODE_ZEROING);
                vmul(regOneSubYMulX_u2, regOneSubY_u2, regX_u2, pregUp_u2, MODE_ZEROING);
                vmul(regOneSubYMulX_u3, regOneSubY_u3, regX_u3, pregUp_u3, MODE_ZEROING);
                vmul(regOneSubYMulX_u4, regOneSubY_u4, regX_u4, pregUp_u4, MODE_ZEROING);
                vmul(regOneSubYMulX_u5, regOneSubY_u5, regX_u5, pregUp_u5, MODE_ZEROING);
                vmul(regOneSubYMulX_u6, regOneSubY_u6, regX_u6, pregUp_u6, MODE_ZEROING);
                vmul(regOneSubYMulX_u7, regOneSubY_u7, regX_u7, pregUp_u7, MODE_ZEROING);
                vsub(regLoss_u0, regOneSubYMulX_u0, regLogSigmoid_u0, pregUp_u0, MODE_ZEROING);
                vsub(regLoss_u1, regOneSubYMulX_u1, regLogSigmoid_u1, pregUp_u1, MODE_ZEROING);
                vsub(regLoss_u2, regOneSubYMulX_u2, regLogSigmoid_u2, pregUp_u2, MODE_ZEROING);
                vsub(regLoss_u3, regOneSubYMulX_u3, regLogSigmoid_u3, pregUp_u3, MODE_ZEROING);
                vsub(regLoss_u4, regOneSubYMulX_u4, regLogSigmoid_u4, pregUp_u4, MODE_ZEROING);
                vsub(regLoss_u5, regOneSubYMulX_u5, regLogSigmoid_u5, pregUp_u5, MODE_ZEROING);
                vsub(regLoss_u6, regOneSubYMulX_u6, regLogSigmoid_u6, pregUp_u6, MODE_ZEROING);
                vsub(regLoss_u7, regOneSubYMulX_u7, regLogSigmoid_u7, pregUp_u7, MODE_ZEROING);
                vmul(regLoss_u0, regLoss_u0, regWeight_u0, pregUp_u0, MODE_ZEROING);
                vmul(regLoss_u1, regLoss_u1, regWeight_u1, pregUp_u1, MODE_ZEROING);
                vmul(regLoss_u2, regLoss_u2, regWeight_u2, pregUp_u2, MODE_ZEROING);
                vmul(regLoss_u3, regLoss_u3, regWeight_u3, pregUp_u3, MODE_ZEROING);
                vmul(regLoss_u4, regLoss_u4, regWeight_u4, pregUp_u4, MODE_ZEROING);
                vmul(regLoss_u5, regLoss_u5, regWeight_u5, pregUp_u5, MODE_ZEROING);
                vmul(regLoss_u6, regLoss_u6, regWeight_u6, pregUp_u6, MODE_ZEROING);
                vmul(regLoss_u7, regLoss_u7, regWeight_u7, pregUp_u7, MODE_ZEROING);
                vsts(regLoss_u0, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u0, POST_UPDATE);
                vsts(regLoss_u1, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u1, POST_UPDATE);
                vsts(regLoss_u2, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u2, POST_UPDATE);
                vsts(regLoss_u3, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u3, POST_UPDATE);
                vsts(regLoss_u4, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u4, POST_UPDATE);
                vsts(regLoss_u5, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u5, POST_UPDATE);
                vsts(regLoss_u6, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u6, POST_UPDATE);
                vsts(regLoss_u7, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u7, POST_UPDATE);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* yAddr = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* weightAddr = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* posWeightAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* lossAddr = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, yAddr, weightAddr, posWeightAddr, lossAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)lossAddr, 0, 1, 4096, 0, 0, 0);
}
