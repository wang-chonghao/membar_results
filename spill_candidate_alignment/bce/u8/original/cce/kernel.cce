                vabs(regAbsX_u3, regX_u3, pregUp_u3, MODE_ZEROING);
                vabs(regAbsX_u4, regX_u4, pregUp_u4, MODE_ZEROING);
                vabs(regAbsX_u5, regX_u5, pregUp_u5, MODE_ZEROING);
                vabs(regAbsX_u6, regX_u6, pregUp_u6, MODE_ZEROING);
                vabs(regAbsX_u7, regX_u7, pregUp_u7, MODE_ZEROING);
                vmuls(regNegAbsX_u0, regAbsX_u0, -1.0f, pregUp_u0, MODE_ZEROING);
