#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* g, __ubuf__ float* v, __ubuf__ float* m,
                                    __ubuf__ float* p, __ubuf__ float* lr, __ubuf__ float* b1,
                                    __ubuf__ float* b1m, __ubuf__ float* b2, __ubuf__ float* b2m,
                                    __ubuf__ float* decay, __ubuf__ float* eps,
                                    __ubuf__ float* vout, __ubuf__ float* mout,
                                    __ubuf__ float* pout) {
    uint32_t remaining = 1024;
    uint16_t loops = 16;
    __VEC_SCOPE__ {
        vector_bool mask;
        vector_f32 G, V, M, P, LR, B1, B1M, B2, B2M, DECAY, EPS, T0, T1, T2, T3, T4;
        uint32_t length = 1024;
        {
            vector_f32 B1_u0;
            vector_f32 B1_u1;
            vector_f32 B1M_u0;
            vector_f32 B1M_u1;
            vector_f32 B2_u0;
            vector_f32 B2_u1;
            vector_f32 B2M_u0;
            vector_f32 B2M_u1;
            vector_f32 DECAY_u0;
            vector_f32 DECAY_u1;
            vector_f32 EPS_u0;
            vector_f32 EPS_u1;
            vector_f32 G_u0;
            vector_f32 G_u1;
            vector_f32 LR_u0;
            vector_f32 LR_u1;
            vector_f32 M_u0;
            vector_f32 M_u1;
            vector_f32 P_u0;
            vector_f32 P_u1;
            vector_f32 T0_u0;
            vector_f32 T0_u1;
            vector_f32 T1_u0;
            vector_f32 T1_u1;
            vector_f32 T2_u0;
            vector_f32 T2_u1;
            vector_f32 T3_u0;
            vector_f32 T3_u1;
            vector_f32 T4_u0;
            vector_f32 T4_u1;
            vector_f32 V_u0;
            vector_f32 V_u1;
            vector_bool mask_u0;
            vector_bool mask_u1;
#pragma unroll 1
            for (uint16_t i = 0; i < 16; i += 2) {
                mask_u0 = plt_b32(length, POST_UPDATE);
                mask_u1 = plt_b32(length, POST_UPDATE);
                uint32_t off_u0 = (i + 0) * 64;
                uint32_t off_u1 = (i + 1) * 64;
                vlds(G_u0, g + off_u0, 0, NORM);
                vlds(G_u1, g + off_u1, 0, NORM);
                vlds(V_u0, v + off_u0, 0, NORM);
                vlds(V_u1, v + off_u1, 0, NORM);
                vlds(M_u0, m + off_u0, 0, NORM);
                vlds(M_u1, m + off_u1, 0, NORM);
                vlds(P_u0, p + off_u0, 0, NORM);
                vlds(P_u1, p + off_u1, 0, NORM);
                vlds(LR_u0, lr, 0, BRC_B32);
                vlds(LR_u1, lr, 0, BRC_B32);
                vlds(B1_u0, b1, 0, BRC_B32);
                vlds(B1_u1, b1, 0, BRC_B32);
                vlds(B1M_u0, b1m, 0, BRC_B32);
                vlds(B1M_u1, b1m, 0, BRC_B32);
                vlds(B2_u0, b2, 0, BRC_B32);
                vlds(B2_u1, b2, 0, BRC_B32);
                vlds(B2M_u0, b2m, 0, BRC_B32);
                vlds(B2M_u1, b2m, 0, BRC_B32);
                vlds(DECAY_u0, decay, 0, BRC_B32);
                vlds(DECAY_u1, decay, 0, BRC_B32);
                vlds(EPS_u0, eps, 0, BRC_B32);
                vlds(EPS_u1, eps, 0, BRC_B32);
                vmul(T0_u0, G_u0, G_u0, mask_u0, MODE_ZEROING);
                vmul(T0_u1, G_u1, G_u1, mask_u1, MODE_ZEROING);
                vmul(T0_u0, T0_u0, B2M_u0, mask_u0, MODE_ZEROING);
                vmul(T0_u1, T0_u1, B2M_u1, mask_u1, MODE_ZEROING);
                vmul(T1_u0, V_u0, B2_u0, mask_u0, MODE_ZEROING);
                vmul(T1_u1, V_u1, B2_u1, mask_u1, MODE_ZEROING);
                vadd(T0_u0, T0_u0, T1_u0, mask_u0, MODE_ZEROING);
                vadd(T0_u1, T0_u1, T1_u1, mask_u1, MODE_ZEROING);
                vmul(T1_u0, M_u0, B1_u0, mask_u0, MODE_ZEROING);
                vmul(T1_u1, M_u1, B1_u1, mask_u1, MODE_ZEROING);
                vmul(T2_u0, G_u0, B1M_u0, mask_u0, MODE_ZEROING);
                vmul(T2_u1, G_u1, B1M_u1, mask_u1, MODE_ZEROING);
                vadd(T1_u0, T1_u0, T2_u0, mask_u0, MODE_ZEROING);
                vadd(T1_u1, T1_u1, T2_u1, mask_u1, MODE_ZEROING);
                vmul(T2_u0, P_u0, DECAY_u0, mask_u0, MODE_ZEROING);
                vmul(T2_u1, P_u1, DECAY_u1, mask_u1, MODE_ZEROING);
                vsqrt(T3_u0, T0_u0, mask_u0, MODE_ZEROING);
                vsqrt(T3_u1, T0_u1, mask_u1, MODE_ZEROING);
                vadd(T3_u0, T3_u0, EPS_u0, mask_u0, MODE_ZEROING);
                vadd(T3_u1, T3_u1, EPS_u1, mask_u1, MODE_ZEROING);
                vdiv(T4_u0, T1_u0, T3_u0, mask_u0, MODE_ZEROING);
                vdiv(T4_u1, T1_u1, T3_u1, mask_u1, MODE_ZEROING);
                vadd(T4_u0, T4_u0, T2_u0, mask_u0, MODE_ZEROING);
                vadd(T4_u1, T4_u1, T2_u1, mask_u1, MODE_ZEROING);
                vmul(T4_u0, T4_u0, LR_u0, mask_u0, MODE_ZEROING);
                vmul(T4_u1, T4_u1, LR_u1, mask_u1, MODE_ZEROING);
                vsub(T4_u0, P_u0, T4_u0, mask_u0, MODE_ZEROING);
                vsub(T4_u1, P_u1, T4_u1, mask_u1, MODE_ZEROING);
                vsts(T0_u0, vout + off_u0, 0, NORM_B32, mask_u0);
                vsts(T0_u1, vout + off_u1, 0, NORM_B32, mask_u1);
                vsts(T1_u0, mout + off_u0, 0, NORM_B32, mask_u0);
                vsts(T1_u1, mout + off_u1, 0, NORM_B32, mask_u1);
                vsts(T4_u0, pout + off_u0, 0, NORM_B32, mask_u0);
                vsts(T4_u1, pout + off_u1, 0, NORM_B32, mask_u1);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* g = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* v = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* m = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* p = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* lr = (__ubuf__ float*)get_imm(16384);
    __ubuf__ float* b1 = (__ubuf__ float*)get_imm(16640);
    __ubuf__ float* b1m = (__ubuf__ float*)get_imm(16896);
    __ubuf__ float* b2 = (__ubuf__ float*)get_imm(17152);
    __ubuf__ float* b2m = (__ubuf__ float*)get_imm(17408);
    __ubuf__ float* decay = (__ubuf__ float*)get_imm(17664);
    __ubuf__ float* eps = (__ubuf__ float*)get_imm(17920);
    __ubuf__ float* vout = (__ubuf__ float*)get_imm(18176);
    __ubuf__ float* mout = (__ubuf__ float*)get_imm(22272);
    __ubuf__ float* pout = (__ubuf__ float*)get_imm(26368);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 18176, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(g, v, m, p, lr, b1, b1m, b2, b2m, decay, eps, vout, mout, pout);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)vout, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 4096, (__ubuf__ uint8_t*)mout, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 8192, (__ubuf__ uint8_t*)pout, 0, 1, 4096, 0, 0, 0);
}
