__aicore__ inline void candidate_vf(__ubuf__ half* actAddr, __ubuf__ half* gateAddr,
                                    __ubuf__ half* gradYAddr, __ubuf__ float* weightAddr,
                                    __ubuf__ half* gradXAddr) {
    constexpr uint32_t VF_LEN_FP32 = 64, DIGIT_TWO = 2;
    uint32_t oneBlockCountB16_ = 16;
    uint16_t dataLenAB = 1024, blockCount = 1;
    uint32_t rowWidth = 2048;
    float alpha_ = 1.702f, limit_ = 2.0f, bias_ = 1.0f;

    const uint32_t alignDim1In =
        ((dataLenAB + oneBlockCountB16_ - 1) / oneBlockCountB16_) * oneBlockCountB16_;
    const uint16_t dim1VfTimes = static_cast<uint16_t>(dataLenAB / VF_LEN_FP32);
    const uint32_t dim1Tail = dataLenAB % VF_LEN_FP32;
    const uint16_t dim1TailTimes = dim1Tail > 0 ? 1 : 0;
    const uint32_t validRowWidth = dataLenAB * DIGIT_TWO;
    uint32_t paddingLen = rowWidth - validRowWidth;

    __VEC_SCOPE__ {
        vector_f16 regHalf;
        vector_f32 regA;
        vector_f32 regB;
        vector_f32 regGrad;
        vector_f32 regWeight;
        vector_f32 regWeightInput;
        vector_f32 regSig;
        vector_f32 regTmp;
        vector_f32 regDa;
        vector_f32 regDb;
        vector_f32 regOne;
        vector_f32 regLimit;
        vector_f32 regNegLimit;
        vector_f32 regZero;
        vector_bool mask;
        vector_bool maskA;
        vector_bool maskB;
        vector_bool maskBn;

        vdup(regLimit, limit_, pset_b32(PAT_ALL), MODE_ZEROING);
        vdup(regNegLimit, -limit_, pset_b32(PAT_ALL), MODE_ZEROING);
        vdup(regZero, 0.0f, pset_b32(PAT_ALL), MODE_ZEROING);

        const uint16_t dim1LoopCount = static_cast<uint16_t>(dim1VfTimes + dim1TailTimes);
        for (uint16_t row = 0; row < blockCount; ++row) {

