                    vcvt(regB_u13, regHalf_u13, mask_u13, PART_EVEN, MODE_ZEROING);
                    vcvt(regB_u14, regHalf_u14, mask_u14, PART_EVEN, MODE_ZEROING);
                    vcvt(regB_u15, regHalf_u15, mask_u15, PART_EVEN, MODE_ZEROING);
