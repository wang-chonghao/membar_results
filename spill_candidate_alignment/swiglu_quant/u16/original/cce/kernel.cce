                    vmul(regGrad_u13, regGrad_u13, regWeight, mask_u13, MODE_ZEROING);
                    vmul(regGrad_u14, regGrad_u14, regWeight, mask_u14, MODE_ZEROING);
                    vmul(regGrad_u15, regGrad_u15, regWeight, mask_u15, MODE_ZEROING);
                    vcmp_le(maskA_u0, regA_u0, regLimit, mask_u0);
