                    vlds(regHalf_u1, gradYAddr, inOffset_u1, UNPK_B16);
                    vlds(regHalf_u2, gradYAddr, inOffset_u2, UNPK_B16);
                    vlds(regHalf_u3, gradYAddr, inOffset_u3, UNPK_B16);
                    vlds(regHalf_u4, gradYAddr, inOffset_u4, UNPK_B16);
                    vlds(regHalf_u5, gradYAddr, inOffset_u5, UNPK_B16);
                    vlds(regHalf_u6, gradYAddr, inOffset_u6, UNPK_B16);
                    vlds(regHalf_u7, gradYAddr, inOffset_u7, UNPK_B16);
                    vlds(regHalf_u8, gradYAddr, inOffset_u8, UNPK_B16);
                    vlds(regHalf_u9, gradYAddr, inOffset_u9, UNPK_B16);
                    vlds(regHalf_u10, gradYAddr, inOffset_u10, UNPK_B16);
                    vlds(regHalf_u11, gradYAddr, inOffset_u11, UNPK_B16);
