                    vcvt(regA_u7, regHalf_u7, mask_u7, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u8, regHalf_u8, mask_u8, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u9, regHalf_u9, mask_u9, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u10, regHalf_u10, mask_u10, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u11, regHalf_u11, mask_u11, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u12, regHalf_u12, mask_u12, PART_EVEN, MODE_ZEROING);
                    vcvt(regA_u13, regHalf_u13, mask_u13, PART_EVEN, MODE_ZEROING);
