#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ half* actAddr, __ubuf__ half* gateAddr,
                                    __ubuf__ half* gradYAddr, __ubuf__ float* weightAddr,
                                    __ubuf__ half* gradXAddr) {
    __ubuf__ uint8_t* arena = (__ubuf__ uint8_t*)get_imm(0);
    __VEC_SCOPE__ {
        vector_bool r0;
        vector_f32 r1;
        vector_f32 r2;
        vector_f32 r3;
        vector_f32 r4;
        vector_f16 r5;
        vector_f16 r6;
        vector_bool r7;
        vector_f32 r8;
        vector_f32 r9;
        vector_f32 r10;
        vector_f32 r11;
        vector_f32 r12;
        vector_f32 r13;
        vector_f32 r14;
        vector_bool r15;
        vector_f32 r16;
        vector_f32 r17;
        vector_f32 r18;
        vector_f32 r19;
        vector_f32 r20;
        vector_f32 r21;
        vector_f32 r22;
        vector_f32 r23;
        vector_f32 r24;
        vector_f32 r25;
        vector_f32 r26;
        vector_f32 r27;
        vector_f32 r28;
        vector_f32 r29;
        vector_f32 r30;
        vector_f16 r31;
        vector_f32 r32;
        vector_f16 r33;
        vector_f32 r34;
        vector_f32 r35;
        vector_f32 r36;
        vector_f16 r37;
        vector_f32 r38;
        vector_f32 r39;
        vector_f16 r40;
        vector_f32 r41;
        vector_f32 r42;
        vector_f32 r43;
        vector_f32 r44;
        vector_f32 r45;
        vector_f32 r46;
        vector_f32 r47;
        vector_f32 r48;
        vector_f32 r49;
        vector_f32 r50;
        vector_f32 r51;
        vector_f32 r52;
        vector_f32 r53;
        vector_f32 r54;
        vector_f32 r55;
        vector_f32 r56;
        vector_f32 r57;
        vector_f32 r58;
        vector_bool r59;
        vector_f32 r60;
        vector_f16 r61;
        vector_bool r62;
        vector_f32 r63;
        vector_f16 r64;
        vector_bool r65;
        vector_f32 r66;
        vector_bool r67;
        vector_f32 r68;
        vector_bool r69;
        vector_f32 r70;
        vector_f16 r71;
        vector_bool r72;
        vector_f32 r73;
        vector_f16 r74;
        r0 = pset_b32(PAT_ALL);
        vdup(r1, 0x1.0000000000000p+1f, r0, MODE_ZEROING);
        vdup(r2, -0x1.0000000000000p+1f, r0, MODE_ZEROING);
        vdup(r3, 0x0.0p+0f, r0, MODE_ZEROING);
        vlds(r4, (__ubuf__ float*)(arena + (6144)), 0, BRC_B32);
        uint32_t mask_remaining_s0_0 = 1024;
#pragma unroll 1
        for (uint16_t iter_s0_0 = 0; iter_s0_0 < 8; ++iter_s0_0) {
            vlds(r5, (__ubuf__ half*)(arena + (0 + 128 * (0 + 2 * iter_s0_0 + 0))), 0, UNPK_B16);
            vlds(r6, (__ubuf__ half*)(arena + (0 + 128 * (0 + 2 * iter_s0_0 + 1))), 0, UNPK_B16);
            r7 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            vcvt(r8, r5, r7, PART_EVEN, MODE_ZEROING);
            vmins(r9, r8, 0x1.0000000000000p+1f, r7, MODE_ZEROING);
            vmuls(r10, r9, -0x1.b3b6460000000p+0f, r7, MODE_ZEROING);
            vexp(r11, r10, r7, MODE_ZEROING);
            vadds(r12, r11, 0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vdup(r13, 0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vdiv(r14, r13, r12, r7, MODE_ZEROING);
            r15 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            vcvt(r16, r6, r15, PART_EVEN, MODE_ZEROING);
            vmins(r17, r16, 0x1.0000000000000p+1f, r15, MODE_ZEROING);
            vmuls(r18, r17, -0x1.b3b6460000000p+0f, r15, MODE_ZEROING);
            vexp(r19, r18, r15, MODE_ZEROING);
            vadds(r20, r19, 0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vdup(r21, 0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vdiv(r22, r21, r20, r15, MODE_ZEROING);
            vmuls(r23, r14, -0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vadds(r24, r23, 0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vmul(r25, r24, r9, r7, MODE_ZEROING);
            vmuls(r26, r22, -0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vadds(r27, r26, 0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vmul(r28, r27, r17, r15, MODE_ZEROING);
            vmuls(r29, r25, 0x1.b3b6460000000p+0f, r7, MODE_ZEROING);
            vmuls(r30, r28, 0x1.b3b6460000000p+0f, r15, MODE_ZEROING);
            vlds(r31, (__ubuf__ half*)(arena + (2048 + 128 * (0 + 2 * iter_s0_0 + 0))), 0,
                 UNPK_B16);
            vcvt(r32, r31, r7, PART_EVEN, MODE_ZEROING);
            vlds(r33, (__ubuf__ half*)(arena + (2048 + 128 * (0 + 2 * iter_s0_0 + 1))), 0,
                 UNPK_B16);
            vcvt(r34, r33, r15, PART_EVEN, MODE_ZEROING);
            vadds(r35, r29, 0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vadds(r36, r30, 0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vlds(r37, (__ubuf__ half*)(arena + (4096 + 128 * (0 + 2 * iter_s0_0 + 0))), 0,
                 UNPK_B16);
            vcvt(r38, r37, r7, PART_EVEN, MODE_ZEROING);
            vmul(r39, r38, r4, r7, MODE_ZEROING);
            vlds(r40, (__ubuf__ half*)(arena + (4096 + 128 * (0 + 2 * iter_s0_0 + 1))), 0,
                 UNPK_B16);
            vcvt(r41, r40, r15, PART_EVEN, MODE_ZEROING);
            vmul(r42, r41, r4, r15, MODE_ZEROING);
            vmul(r43, r35, r14, r7, MODE_ZEROING);
            vmul(r44, r36, r22, r15, MODE_ZEROING);
            vmul(r45, r39, r9, r7, MODE_ZEROING);
            vmul(r46, r45, r14, r7, MODE_ZEROING);
            vmul(r47, r42, r17, r15, MODE_ZEROING);
            vmul(r48, r47, r22, r15, MODE_ZEROING);
            vmins(r49, r32, 0x1.0000000000000p+1f, r7, MODE_ZEROING);
            vmaxs(r50, r49, -0x1.0000000000000p+1f, r7, MODE_ZEROING);
            vadds(r51, r50, 0x1.0000000000000p+0f, r7, MODE_ZEROING);
            vmul(r52, r43, r51, r7, MODE_ZEROING);
            vmul(r53, r52, r39, r7, MODE_ZEROING);
            vmins(r54, r34, 0x1.0000000000000p+1f, r15, MODE_ZEROING);
            vmaxs(r55, r54, -0x1.0000000000000p+1f, r15, MODE_ZEROING);
            vadds(r56, r55, 0x1.0000000000000p+0f, r15, MODE_ZEROING);
            vmul(r57, r44, r56, r15, MODE_ZEROING);
            vmul(r58, r57, r42, r15, MODE_ZEROING);
            vcmp_le(r59, r8, r1, r7);
            vsel(r60, r53, r3, r59);
            vcvt(r61, r60, r7, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(r61, (__ubuf__ half*)(arena + (6400 + 128 * (0 + 2 * iter_s0_0 + 0))), 0, PK_B32,
                 r7);
            vcmp_le(r62, r16, r1, r15);
            vsel(r63, r58, r3, r62);
            vcvt(r64, r63, r15, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(r64, (__ubuf__ half*)(arena + (6400 + 128 * (0 + 2 * iter_s0_0 + 1))), 0, PK_B32,
                 r15);
            vcmp_le(r65, r32, r1, r7);
            vsel(r66, r46, r3, r65);
            vcmp_le(r67, r34, r1, r15);
            vsel(r68, r48, r3, r67);
            vcmp_ge(r69, r32, r2, r7);
            vsel(r70, r66, r3, r69);
            vcvt(r71, r70, r7, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(r71, (__ubuf__ half*)(arena + (8448 + 128 * (0 + 2 * iter_s0_0 + 0))), 0, PK_B32,
                 r7);
            vcmp_ge(r72, r34, r2, r15);
            vsel(r73, r68, r3, r72);
            vcvt(r74, r73, r15, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(r74, (__ubuf__ half*)(arena + (8448 + 128 * (0 + 2 * iter_s0_0 + 1))), 0, PK_B32,
                 r15);
        }
    }
}

extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ half* actAddr = (__ubuf__ half*)get_imm(0);
    __ubuf__ half* gateAddr = (__ubuf__ half*)get_imm(2048);
    __ubuf__ half* gradYAddr = (__ubuf__ half*)get_imm(4096);
    __ubuf__ float* weightAddr = (__ubuf__ float*)get_imm(6144);
    __ubuf__ half* gradXAddr = (__ubuf__ half*)get_imm(6400);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 6400, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(actAddr, gateAddr, gradYAddr, weightAddr, gradXAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)gradXAddr, 0, 1, 4096, 0, 0, 0);
}
