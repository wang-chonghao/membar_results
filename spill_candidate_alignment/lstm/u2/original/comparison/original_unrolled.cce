#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* dcsUb, __ubuf__ float* ciUb,
                                    __ubuf__ float* iUb, __ubuf__ float* csPrevUb,
                                    __ubuf__ float* fUb, __ubuf__ float* diPreUb,
                                    __ubuf__ float* dciPreUb, __ubuf__ float* dfPreUb) {
    constexpr uint32_t REP_F32 = 64;
    uint32_t segElems = 1024;
    uint16_t repeatTime = 16;
    __VEC_SCOPE__ {
        constexpr bool IsFp32 = std::is_same_v<float, float>;
        vector_f32 dcsReg;
        vector_f32 ciReg;
        vector_f32 iReg;
        vector_f32 cspReg;
        vector_f32 fReg;
        vector_f32 t0Reg;
        vector_f32 t1Reg;
        vector_f32 oneReg;
        vector_bool mask;
        vdup(oneReg, 1.0f, pset_b32(PAT_ALL), MODE_ZEROING);
        uint32_t remaining = segElems;

        {
            vector_f32 ciReg_u0;
            vector_f32 ciReg_u1;
            vector_f32 cspReg_u0;
            vector_f32 cspReg_u1;
            vector_f32 dcsReg_u0;
            vector_f32 dcsReg_u1;
            vector_f32 fReg_u0;
            vector_f32 fReg_u1;
            vector_f32 iReg_u0;
            vector_f32 iReg_u1;
            vector_bool mask_u0;
            vector_bool mask_u1;
            vector_f32 t0Reg_u0;
            vector_f32 t0Reg_u1;
            vector_f32 t1Reg_u0;
            vector_f32 t1Reg_u1;
#pragma unroll 1
            for (uint16_t i = 0; i < 16; i += 2) {
                int32_t off_u0 = static_cast<int32_t>((i + 0)) * static_cast<int32_t>(REP_F32);
                int32_t off_u1 = static_cast<int32_t>((i + 1)) * static_cast<int32_t>(REP_F32);
                mask_u0 = plt_b32(remaining, POST_UPDATE);
                mask_u1 = plt_b32(remaining, POST_UPDATE);
                vlds(dcsReg_u0, dcsUb + off_u0, 0, NORM);
                vlds(dcsReg_u1, dcsUb + off_u1, 0, NORM);
                vlds(ciReg_u0, reinterpret_cast<__ubuf__ float*>(ciUb) + off_u0, 0, NORM);
                vlds(ciReg_u1, reinterpret_cast<__ubuf__ float*>(ciUb) + off_u1, 0, NORM);
                vlds(iReg_u0, reinterpret_cast<__ubuf__ float*>(iUb) + off_u0, 0, NORM);
                vlds(iReg_u1, reinterpret_cast<__ubuf__ float*>(iUb) + off_u1, 0, NORM);
                vlds(cspReg_u0, reinterpret_cast<__ubuf__ float*>(csPrevUb) + off_u0, 0, NORM);
                vlds(cspReg_u1, reinterpret_cast<__ubuf__ float*>(csPrevUb) + off_u1, 0, NORM);
                vlds(fReg_u0, reinterpret_cast<__ubuf__ float*>(fUb) + off_u0, 0, NORM);
                vlds(fReg_u1, reinterpret_cast<__ubuf__ float*>(fUb) + off_u1, 0, NORM);
                vsub(t1Reg_u0, oneReg, iReg_u0, mask_u0, MODE_ZEROING);
                vsub(t1Reg_u1, oneReg, iReg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, iReg_u0, t1Reg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, iReg_u1, t1Reg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t0Reg_u0, dcsReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t0Reg_u1, dcsReg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t0Reg_u0, ciReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t0Reg_u1, ciReg_u1, mask_u1, MODE_ZEROING);
                vsts(t0Reg_u0, diPreUb + off_u0, 0, NORM_B32, mask_u0);
                vsts(t0Reg_u1, diPreUb + off_u1, 0, NORM_B32, mask_u1);
                vmul(t1Reg_u0, ciReg_u0, ciReg_u0, mask_u0, MODE_ZEROING);
                vmul(t1Reg_u1, ciReg_u1, ciReg_u1, mask_u1, MODE_ZEROING);
                vsub(t1Reg_u0, oneReg, t1Reg_u0, mask_u0, MODE_ZEROING);
                vsub(t1Reg_u1, oneReg, t1Reg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t1Reg_u0, dcsReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t1Reg_u1, dcsReg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t0Reg_u0, iReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t0Reg_u1, iReg_u1, mask_u1, MODE_ZEROING);
                vsts(t0Reg_u0, dciPreUb + off_u0, 0, NORM_B32, mask_u0);
                vsts(t0Reg_u1, dciPreUb + off_u1, 0, NORM_B32, mask_u1);
                vsub(t1Reg_u0, oneReg, fReg_u0, mask_u0, MODE_ZEROING);
                vsub(t1Reg_u1, oneReg, fReg_u1, mask_u1, MODE_ZEROING);
                vmul(t1Reg_u0, fReg_u0, t1Reg_u0, mask_u0, MODE_ZEROING);
                vmul(t1Reg_u1, fReg_u1, t1Reg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t1Reg_u0, dcsReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t1Reg_u1, dcsReg_u1, mask_u1, MODE_ZEROING);
                vmul(t0Reg_u0, t0Reg_u0, cspReg_u0, mask_u0, MODE_ZEROING);
                vmul(t0Reg_u1, t0Reg_u1, cspReg_u1, mask_u1, MODE_ZEROING);
                vsts(t0Reg_u0, dfPreUb + off_u0, 0, NORM_B32, mask_u0);
                vsts(t0Reg_u1, dfPreUb + off_u1, 0, NORM_B32, mask_u1);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* dcsUb = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* ciUb = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* iUb = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* csPrevUb = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* fUb = (__ubuf__ float*)get_imm(16384);
    __ubuf__ float* diPreUb = (__ubuf__ float*)get_imm(20480);
    __ubuf__ float* dciPreUb = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* dfPreUb = (__ubuf__ float*)get_imm(28672);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 20480, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(dcsUb, ciUb, iUb, csPrevUb, fUb, diPreUb, dciPreUb, dfPreUb);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)diPreUb, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 4096, (__ubuf__ uint8_t*)dciPreUb, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 8192, (__ubuf__ uint8_t*)dfPreUb, 0, 1, 4096, 0, 0, 0);
}
