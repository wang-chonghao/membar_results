        // RV_PAND Dtype: B8  Pd[2], Pn[2], Pm[3], Pg[1], 
        pand(p2, p2, p3, p1);
        // PC=0x13b31264 dynamic_id=548 iteration=(('iter_13b3121c', 15),)
        // RV_VSEL Dtype: B32  Vd[5], Vn[5], Vm[0], Pg[2], 
        vsel(v5_f32, v5_f32, v0_f32, p2);
        // PC=0x13b31268 dynamic_id=550 iteration=(('iter_13b3121c', 15),)
        // RV_VCMP_EQ Dtype: F32  Pd[2], Vn[4], Vm[4], Pg[1], 
        vcmp_eq(p2, v4_f32, v4_f32, p1);
        // PC=0x13b3126c dynamic_id=551 iteration=(('iter_13b3121c', 15),)
        // RV_VSEL Dtype: B32  Vd[4], Vn[5], Vm[2], Pg[2], 
        vsel(v4_f32, v5_f32, v2_f32, p2);
        // PC=0x13b31270 dynamic_id=552 iteration=(('iter_13b3121c', 15),)
        // RV_VST Vd[4], Sn[12]=0x0, Sn2[13]=0x0, Am[0]=0xf00, Pg[1], dist:NORM_B32, 
        vsts(v4_f32, (__ubuf__ float*)0xf00, 0, NORM_B32, p1);
    }
}
