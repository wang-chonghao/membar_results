#include "kernel_operator.h"
#include "reference_original.h"
#include "atvoss/broadcast/broadcast_base_struct.h"
#include "atvoss/broadcast/broadcast_sch_one_dim.h"
#include "atvoss/elewise/elewise_sch.h"
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    AscendC::TPipe pipe;
    using Dag = SyncBatchNormBackwardElemt::SyncBatchNormBackwardElemtDag<float, float>::OpDag;
    Ops::Base::EleBaseTilingData tiling = {};
    tiling.ubFormer = 1024;
    tiling.blockNum = 1;
    tiling.blockFormer = 1024;
    tiling.ubLoopOfTailBlock = 1;
    tiling.ubTailOfTailBlock = 1024;
    tiling.ubLoopOfFormerBlock = 1;
    tiling.ubTailOfFormerBlock = 1024;
    Ops::Base::ElementwiseSch<0, Dag> sch(&tiling, &pipe);
    sch.Init((GM_ADDR)(input + 0), (GM_ADDR)(input + 4096), (GM_ADDR)(input + 8192),
             (GM_ADDR)(input + 12288), (GM_ADDR)(input + 16384), (GM_ADDR)(input + 20480),
             (GM_ADDR)(input + 24576), (GM_ADDR)(output + 0));
    sch.Process();
}
