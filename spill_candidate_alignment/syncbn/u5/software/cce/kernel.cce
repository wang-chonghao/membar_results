            vsts(r79, (__ubuf__ float*)(arena + (28672 + 256 * (0 + 5 * iter_s0_0 + 4))), 0,
                 NORM_B32, r64);
        }
        uint32_t mask_remaining_s0_1 = 64;
#pragma unroll 1
        for (uint16_t iter_s0_1 = 0; iter_s0_1 < 1; ++iter_s0_1) {
            r80 = plt_b32(mask_remaining_s0_1, POST_UPDATE);
            vlds(r81, (__ubuf__ float*)(arena + (0 + 256 * (15 + 1 * iter_s0_1 + 0))), 0, NORM);
            vlds(r82, (__ubuf__ float*)(arena + (4096 + 256 * (15 + 1 * iter_s0_1 + 0))), 0, NORM);
            vlds(r83, (__ubuf__ float*)(arena + (8192 + 256 * (15 + 1 * iter_s0_1 + 0))), 0, NORM);
