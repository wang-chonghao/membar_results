        vector_f32 r93;
        vector_f32 r94;
        vector_f32 r95;
        uint32_t mask_remaining_s0_0 = 1024;
#pragma unroll 1
        for (uint16_t iter_s0_0 = 0; iter_s0_0 < 3; ++iter_s0_0) {
            r0 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r1 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r2 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            r3 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
            vlds(r4, (__ubuf__ float*)(arena + (0 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r5, (__ubuf__ float*)(arena + (0 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r6, (__ubuf__ float*)(arena + (0 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r7, (__ubuf__ float*)(arena + (0 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r8, (__ubuf__ float*)(arena + (4096 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r9, (__ubuf__ float*)(arena + (4096 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r10, (__ubuf__ float*)(arena + (4096 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r11, (__ubuf__ float*)(arena + (4096 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r12, (__ubuf__ float*)(arena + (8192 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r13, (__ubuf__ float*)(arena + (8192 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r14, (__ubuf__ float*)(arena + (8192 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r15, (__ubuf__ float*)(arena + (8192 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r16, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r17, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r18, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r19, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r20, (__ubuf__ float*)(arena + (16384 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r21, (__ubuf__ float*)(arena + (16384 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r22, (__ubuf__ float*)(arena + (16384 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r23, (__ubuf__ float*)(arena + (16384 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r24, (__ubuf__ float*)(arena + (20480 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r25, (__ubuf__ float*)(arena + (20480 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r26, (__ubuf__ float*)(arena + (20480 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r27, (__ubuf__ float*)(arena + (20480 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vlds(r28, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 5 * iter_s0_0 + 0))), 0, NORM);
            vlds(r29, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 5 * iter_s0_0 + 1))), 0, NORM);
            vlds(r30, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 5 * iter_s0_0 + 2))), 0, NORM);
            vlds(r31, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 5 * iter_s0_0 + 3))), 0, NORM);
            vsub(r32, r4, r24, r0, MODE_ZEROING);
            vsub(r33, r5, r25, r1, MODE_ZEROING);
            vsub(r34, r6, r26, r2, MODE_ZEROING);
            vsub(r35, r7, r27, r3, MODE_ZEROING);
            vsub(r36, r8, r12, r0, MODE_ZEROING);
            vsub(r37, r9, r13, r1, MODE_ZEROING);
            vsub(r38, r10, r14, r2, MODE_ZEROING);
            vsub(r39, r11, r15, r3, MODE_ZEROING);
            vmul(r40, r16, r16, r0, MODE_ZEROING);
            vmul(r41, r17, r17, r1, MODE_ZEROING);
            vmul(r42, r18, r18, r2, MODE_ZEROING);
            vmul(r43, r19, r19, r3, MODE_ZEROING);
            vmul(r44, r28, r40, r0, MODE_ZEROING);
            vmul(r45, r29, r41, r1, MODE_ZEROING);
            vmul(r46, r30, r42, r2, MODE_ZEROING);
            vmul(r47, r31, r43, r3, MODE_ZEROING);
            vmul(r48, r36, r44, r0, MODE_ZEROING);
            vmul(r49, r37, r45, r1, MODE_ZEROING);
            vmul(r50, r38, r46, r2, MODE_ZEROING);
            vmul(r51, r39, r47, r3, MODE_ZEROING);
            vsub(r52, r32, r48, r0, MODE_ZEROING);
            vsub(r53, r33, r49, r1, MODE_ZEROING);
            vsub(r54, r34, r50, r2, MODE_ZEROING);
            vsub(r55, r35, r51, r3, MODE_ZEROING);
            vmul(r56, r16, r20, r0, MODE_ZEROING);
            vmul(r57, r17, r21, r1, MODE_ZEROING);
            vmul(r58, r18, r22, r2, MODE_ZEROING);
            vmul(r59, r19, r23, r3, MODE_ZEROING);
            vmul(r60, r52, r56, r0, MODE_ZEROING);
            vmul(r61, r53, r57, r1, MODE_ZEROING);
            vmul(r62, r54, r58, r2, MODE_ZEROING);
            vmul(r63, r55, r59, r3, MODE_ZEROING);
            vsts(r60, (__ubuf__ float*)(arena + (28672 + 256 * (0 + 5 * iter_s0_0 + 0))), 0,
