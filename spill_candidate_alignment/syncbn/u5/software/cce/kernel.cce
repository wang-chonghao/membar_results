                                    __ubuf__ float* meanDy, __ubuf__ float* meanDyXmu,
                                    __ubuf__ float* dx) {
    __ubuf__ uint8_t* arena = (__ubuf__ uint8_t*)get_imm(0);
    __VEC_SCOPE__ {
        vector_bool r0;
