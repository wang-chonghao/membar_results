#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* dy, __ubuf__ float* x, __ubuf__ float* mean,
                                    __ubuf__ float* invstd, __ubuf__ float* weight,
                                    __ubuf__ float* meanDy, __ubuf__ float* meanDyXmu,
                                    __ubuf__ float* dx) {
    uint32_t remaining = 1024;
    uint16_t loops = 16;
    __VEC_SCOPE__ {
        vector_bool mask;
        vector_f32 DY, X, MEAN, INV, W, MD, MDX, T0, T1, T2, T3, T4;
        uint32_t length = 1024;
        {
            vector_f32 DY_u0;
            vector_f32 DY_u1;
            vector_f32 INV_u0;
            vector_f32 INV_u1;
            vector_f32 MD_u0;
            vector_f32 MD_u1;
            vector_f32 MDX_u0;
            vector_f32 MDX_u1;
            vector_f32 MEAN_u0;
            vector_f32 MEAN_u1;
            vector_f32 T0_u0;
            vector_f32 T0_u1;
            vector_f32 T1_u0;
            vector_f32 T1_u1;
            vector_f32 T2_u0;
            vector_f32 T2_u1;
            vector_f32 T3_u0;
            vector_f32 T3_u1;
            vector_f32 T4_u0;
            vector_f32 T4_u1;
            vector_f32 W_u0;
            vector_f32 W_u1;
            vector_f32 X_u0;
            vector_f32 X_u1;
            vector_bool mask_u0;
            vector_bool mask_u1;
#pragma unroll 1
            for (uint16_t i = 0; i < 16; i += 2) {
                mask_u0 = plt_b32(length, POST_UPDATE);
                mask_u1 = plt_b32(length, POST_UPDATE);
                uint32_t off_u0 = (i + 0) * 64;
                uint32_t off_u1 = (i + 1) * 64;
                vlds(DY_u0, dy + off_u0, 0, NORM);
                vlds(DY_u1, dy + off_u1, 0, NORM);
                vlds(X_u0, x + off_u0, 0, NORM);
                vlds(X_u1, x + off_u1, 0, NORM);
                vlds(MEAN_u0, mean + off_u0, 0, NORM);
                vlds(MEAN_u1, mean + off_u1, 0, NORM);
                vlds(INV_u0, invstd + off_u0, 0, NORM);
                vlds(INV_u1, invstd + off_u1, 0, NORM);
                vlds(W_u0, weight + off_u0, 0, NORM);
                vlds(W_u1, weight + off_u1, 0, NORM);
                vlds(MD_u0, meanDy + off_u0, 0, NORM);
                vlds(MD_u1, meanDy + off_u1, 0, NORM);
                vlds(MDX_u0, meanDyXmu + off_u0, 0, NORM);
                vlds(MDX_u1, meanDyXmu + off_u1, 0, NORM);
                vsub(T0_u0, DY_u0, MD_u0, mask_u0, MODE_ZEROING);
                vsub(T0_u1, DY_u1, MD_u1, mask_u1, MODE_ZEROING);
                vsub(T1_u0, X_u0, MEAN_u0, mask_u0, MODE_ZEROING);
                vsub(T1_u1, X_u1, MEAN_u1, mask_u1, MODE_ZEROING);
                vmul(T2_u0, INV_u0, INV_u0, mask_u0, MODE_ZEROING);
                vmul(T2_u1, INV_u1, INV_u1, mask_u1, MODE_ZEROING);
                vmul(T2_u0, MDX_u0, T2_u0, mask_u0, MODE_ZEROING);
                vmul(T2_u1, MDX_u1, T2_u1, mask_u1, MODE_ZEROING);
                vmul(T1_u0, T1_u0, T2_u0, mask_u0, MODE_ZEROING);
                vmul(T1_u1, T1_u1, T2_u1, mask_u1, MODE_ZEROING);
                vsub(T3_u0, T0_u0, T1_u0, mask_u0, MODE_ZEROING);
                vsub(T3_u1, T0_u1, T1_u1, mask_u1, MODE_ZEROING);
                vmul(T4_u0, INV_u0, W_u0, mask_u0, MODE_ZEROING);
                vmul(T4_u1, INV_u1, W_u1, mask_u1, MODE_ZEROING);
                vmul(T3_u0, T3_u0, T4_u0, mask_u0, MODE_ZEROING);
                vmul(T3_u1, T3_u1, T4_u1, mask_u1, MODE_ZEROING);
                vsts(T3_u0, dx + off_u0, 0, NORM_B32, mask_u0);
                vsts(T3_u1, dx + off_u1, 0, NORM_B32, mask_u1);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* dy = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* x = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* mean = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* invstd = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* weight = (__ubuf__ float*)get_imm(16384);
    __ubuf__ float* meanDy = (__ubuf__ float*)get_imm(20480);
    __ubuf__ float* meanDyXmu = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* dx = (__ubuf__ float*)get_imm(28672);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 28672, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(dy, x, mean, invstd, weight, meanDy, meanDyXmu, dx);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dx, 0, 1, 4096, 0, 0, 0);
}
