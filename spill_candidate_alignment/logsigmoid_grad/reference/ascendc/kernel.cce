#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* src0Addr, __ubuf__ float* src1Addr,
                                    __ubuf__ float* dstAddr) {
    uint32_t count = 3072, vlSize = 64;
    uint16_t loopNum = 48;
    RegTensor<float> DataOne;
    RegTensor<float> DataZero;
    RegTensor<float> vregInputGradOut;
    RegTensor<float> vregInputSelf;
    RegTensor<float> SelfAbs;
    RegTensor<float> SelfAbsNeg;
    RegTensor<float> SelfAbsNegExp;
    RegTensor<float> SelfAbsNegExpAdd;
    RegTensor<float> vregSelect;
    RegTensor<float> Answer;
    RegTensor<float> LastAnswer;
    MaskReg mask, cmpMask;

    __VEC_SCOPE__ {
        Duplicate(DataOne, (float)1.0);
        Duplicate(DataZero, (float)0.0);
#pragma unroll 1
        for (uint16_t i = 0; i < loopNum; i++) {
            mask = UpdateMask<float>(count);
            // OpCopyIn
            LoadAlign(vregInputGradOut, (__ubuf__ float*)(src0Addr + i * vlSize));
            LoadAlign(vregInputSelf, (__ubuf__ float*)(src1Addr + i * vlSize));
            // compute
            Abs(SelfAbs, vregInputSelf, mask);
            Muls(SelfAbsNeg, SelfAbs, (float)-1.0, mask);
            Exp(SelfAbsNegExp, SelfAbsNeg, mask);
            Adds(SelfAbsNegExpAdd, SelfAbsNegExp, (float)1.0, mask);

            Compare<float, CMPMODE::LT>(cmpMask, vregInputSelf, DataZero, mask);
            Select(vregSelect, DataOne, SelfAbsNegExp, cmpMask);
            Div(Answer, vregSelect, SelfAbsNegExpAdd, mask);
            Mul(LastAnswer, Answer, vregInputGradOut, mask);

            // OpCopyOut
            StoreAlign((__ubuf__ float*)(dstAddr + i * vlSize), LastAnswer, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* src0Addr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* src1Addr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dstAddr = (__ubuf__ float*)get_imm(24576);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 24576, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(src0Addr, src1Addr, dstAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dstAddr, 0, 1, 12288, 0, 0, 0);
}
