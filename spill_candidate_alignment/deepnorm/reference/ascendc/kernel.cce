#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* dyPtr, __ubuf__ float* xPtr,
                                    __ubuf__ float* gxPtr, __ubuf__ float* gammaPtr,
                                    __ubuf__ float* meanPtr, __ubuf__ float* rstdPtr,
                                    __ubuf__ float* avgTmpPtr, __ubuf__ float* avgTmpNormPtr,
                                    __ubuf__ float* dgxPtr, __ubuf__ float* dxPtr) {
    constexpr uint32_t VL_FP32 = 64;
    uint16_t loops = 16;
    uint32_t remaining = 1024;
    float alpha = 0.5f;
    __VEC_SCOPE__ {
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        RegTensor<float> dyReg;
        RegTensor<float> xReg;
        RegTensor<float> gxReg;
        RegTensor<float> gammaReg;
        RegTensor<float> meanReg;
        RegTensor<float> rstdReg;
        RegTensor<float> avgTmpReg;
        RegTensor<float> avgTmpNormReg;
        RegTensor<float> tmpReg;
        RegTensor<float> normReg;
        RegTensor<float> dgxReg;
        RegTensor<float> dxReg;
        MaskReg mask;
        DataCopy<float, LoadDist::DIST_BRC_B32>(meanReg, meanPtr);
        DataCopy<float, LoadDist::DIST_BRC_B32>(rstdReg, rstdPtr);
        DataCopy<float, LoadDist::DIST_BRC_B32>(avgTmpReg, avgTmpPtr);
        DataCopy<float, LoadDist::DIST_BRC_B32>(avgTmpNormReg, avgTmpNormPtr);
        for (uint16_t i = 0; i < loops; ++i) {
            uint32_t valid = (remaining < VL_FP32 ? remaining : VL_FP32);
            remaining -= valid;
            mask = UpdateMask<float>(valid);
            uint32_t offset = static_cast<uint32_t>(i) * VL_FP32;
            LoadAlign(dyReg, dyPtr + offset);
            LoadAlign(gammaReg, gammaPtr + offset);
            LoadAlign(xReg, xPtr + offset);
            LoadAlign(gxReg, gxPtr + offset);
            Mul(tmpReg, dyReg, gammaReg, mask);
            Muls(xReg, xReg, alpha, mask);
            Add(normReg, xReg, gxReg, mask);
            Sub(normReg, normReg, meanReg, mask);
            Mul(dgxReg, tmpReg, rstdReg, mask);
            Mul(normReg, normReg, avgTmpReg, mask);
            Add(dgxReg, dgxReg, normReg, mask);
            Add(dgxReg, dgxReg, avgTmpNormReg, mask);
            Muls(dxReg, dgxReg, alpha, mask);
            StoreAlign(dgxPtr + offset, dgxReg, mask);
            StoreAlign(dxPtr + offset, dxReg, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* dyPtr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* xPtr = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* gxPtr = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* gammaPtr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* meanPtr = (__ubuf__ float*)get_imm(16384);
    __ubuf__ float* rstdPtr = (__ubuf__ float*)get_imm(16640);
    __ubuf__ float* avgTmpPtr = (__ubuf__ float*)get_imm(16896);
    __ubuf__ float* avgTmpNormPtr = (__ubuf__ float*)get_imm(17152);
    __ubuf__ float* dgxPtr = (__ubuf__ float*)get_imm(17408);
    __ubuf__ float* dxPtr = (__ubuf__ float*)get_imm(21504);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 17408, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(dyPtr, xPtr, gxPtr, gammaPtr, meanPtr, rstdPtr, avgTmpPtr, avgTmpNormPtr, dgxPtr,
                 dxPtr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dgxPtr, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 4096, (__ubuf__ uint8_t*)dxPtr, 0, 1, 4096, 0, 0, 0);
}
