#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* dyPtr, __ubuf__ float* xPtr,
                                    __ubuf__ float* gxPtr, __ubuf__ float* gammaPtr,
                                    __ubuf__ float* meanPtr, __ubuf__ float* rstdPtr,
                                    __ubuf__ float* avgTmpPtr, __ubuf__ float* avgTmpNormPtr,
                                    __ubuf__ float* dgxPtr, __ubuf__ float* dxPtr) {
    constexpr uint32_t VL_FP32 = 64;
    uint16_t loops = 16;
    uint32_t remaining = 1024;
    float alpha = 0.5f;
    __VEC_SCOPE__ {
        mem_bar(VST_VLD);
        vector_f32 dyReg;
        vector_f32 xReg;
        vector_f32 gxReg;
        vector_f32 gammaReg;
        vector_f32 meanReg;
        vector_f32 rstdReg;
        vector_f32 avgTmpReg;
        vector_f32 avgTmpNormReg;
        vector_f32 tmpReg;
        vector_f32 normReg;
        vector_f32 dgxReg;
        vector_f32 dxReg;
        vector_bool mask;
        vlds(meanReg, meanPtr, 0, BRC_B32);
        vlds(rstdReg, rstdPtr, 0, BRC_B32);
        vlds(avgTmpReg, avgTmpPtr, 0, BRC_B32);
        vlds(avgTmpNormReg, avgTmpNormPtr, 0, BRC_B32);
        {
            vector_f32 dgxReg_u0;
            vector_f32 dgxReg_u1;
            vector_f32 dxReg_u0;
            vector_f32 dxReg_u1;
            vector_f32 dyReg_u0;
            vector_f32 dyReg_u1;
            vector_f32 gammaReg_u0;
            vector_f32 gammaReg_u1;
            vector_f32 gxReg_u0;
            vector_f32 gxReg_u1;
            vector_bool mask_u0;
            vector_bool mask_u1;
            vector_f32 normReg_u0;
            vector_f32 normReg_u1;
            vector_f32 tmpReg_u0;
            vector_f32 tmpReg_u1;
            vector_f32 xReg_u0;
            vector_f32 xReg_u1;
#pragma unroll 1
            for (uint16_t i = 0; i < 16; i += 2) {
                uint32_t valid_u0 = (remaining < VL_FP32 ? remaining : VL_FP32);
                uint32_t valid_u1 = (remaining < VL_FP32 ? remaining : VL_FP32);
                remaining -= valid_u0;
                remaining -= valid_u1;
                mask_u0 = plt_b32(valid_u0, POST_UPDATE);
                mask_u1 = plt_b32(valid_u1, POST_UPDATE);
                uint32_t offset_u0 = static_cast<uint32_t>((i + 0)) * VL_FP32;
                uint32_t offset_u1 = static_cast<uint32_t>((i + 1)) * VL_FP32;
                vlds(dyReg_u0, dyPtr + offset_u0, 0, NORM);
                vlds(dyReg_u1, dyPtr + offset_u1, 0, NORM);
                vlds(gammaReg_u0, gammaPtr + offset_u0, 0, NORM);
                vlds(gammaReg_u1, gammaPtr + offset_u1, 0, NORM);
                vlds(xReg_u0, xPtr + offset_u0, 0, NORM);
                vlds(xReg_u1, xPtr + offset_u1, 0, NORM);
                vlds(gxReg_u0, gxPtr + offset_u0, 0, NORM);
                vlds(gxReg_u1, gxPtr + offset_u1, 0, NORM);
                vmul(tmpReg_u0, dyReg_u0, gammaReg_u0, mask_u0, MODE_ZEROING);
                vmul(tmpReg_u1, dyReg_u1, gammaReg_u1, mask_u1, MODE_ZEROING);
                vmuls(xReg_u0, xReg_u0, alpha, mask_u0, MODE_ZEROING);
                vmuls(xReg_u1, xReg_u1, alpha, mask_u1, MODE_ZEROING);
                vadd(normReg_u0, xReg_u0, gxReg_u0, mask_u0, MODE_ZEROING);
                vadd(normReg_u1, xReg_u1, gxReg_u1, mask_u1, MODE_ZEROING);
                vsub(normReg_u0, normReg_u0, meanReg, mask_u0, MODE_ZEROING);
                vsub(normReg_u1, normReg_u1, meanReg, mask_u1, MODE_ZEROING);
                vmul(dgxReg_u0, tmpReg_u0, rstdReg, mask_u0, MODE_ZEROING);
                vmul(dgxReg_u1, tmpReg_u1, rstdReg, mask_u1, MODE_ZEROING);
                vmul(normReg_u0, normReg_u0, avgTmpReg, mask_u0, MODE_ZEROING);
                vmul(normReg_u1, normReg_u1, avgTmpReg, mask_u1, MODE_ZEROING);
                vadd(dgxReg_u0, dgxReg_u0, normReg_u0, mask_u0, MODE_ZEROING);
                vadd(dgxReg_u1, dgxReg_u1, normReg_u1, mask_u1, MODE_ZEROING);
                vadd(dgxReg_u0, dgxReg_u0, avgTmpNormReg, mask_u0, MODE_ZEROING);
                vadd(dgxReg_u1, dgxReg_u1, avgTmpNormReg, mask_u1, MODE_ZEROING);
                vmuls(dxReg_u0, dgxReg_u0, alpha, mask_u0, MODE_ZEROING);
                vmuls(dxReg_u1, dgxReg_u1, alpha, mask_u1, MODE_ZEROING);
                vsts(dgxReg_u0, dgxPtr + offset_u0, 0, NORM_B32, mask_u0);
                vsts(dgxReg_u1, dgxPtr + offset_u1, 0, NORM_B32, mask_u1);
                vsts(dxReg_u0, dxPtr + offset_u0, 0, NORM_B32, mask_u0);
                vsts(dxReg_u1, dxPtr + offset_u1, 0, NORM_B32, mask_u1);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* dyPtr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* xPtr = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* gxPtr = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* gammaPtr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* meanPtr = (__ubuf__ float*)get_imm(16384);
    __ubuf__ float* rstdPtr = (__ubuf__ float*)get_imm(16640);
    __ubuf__ float* avgTmpPtr = (__ubuf__ float*)get_imm(16896);
    __ubuf__ float* avgTmpNormPtr = (__ubuf__ float*)get_imm(17152);
    __ubuf__ float* dgxPtr = (__ubuf__ float*)get_imm(17408);
    __ubuf__ float* dxPtr = (__ubuf__ float*)get_imm(21504);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 17408, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(dyPtr, xPtr, gxPtr, gammaPtr, meanPtr, rstdPtr, avgTmpPtr, avgTmpNormPtr, dgxPtr,
                 dxPtr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dgxPtr, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 4096, (__ubuf__ uint8_t*)dxPtr, 0, 1, 4096, 0, 0, 0);
}
