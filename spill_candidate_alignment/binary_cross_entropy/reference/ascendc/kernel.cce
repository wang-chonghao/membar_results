#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__simd_callee__ inline void CalcYLogX(RegTensor<float>& regYLogX, RegTensor<float>& regX,
                                      RegTensor<float>& regY, MaskReg& pregUp) {
    RegTensor<float> regLogX;
    RegTensor<float> regClipLogX;
    Log(regLogX, regX, pregUp);
    Maxs(regClipLogX, regLogX, (float)-100.0, pregUp);
    Mul(regYLogX, regClipLogX, regY, pregUp);
}
__aicore__ inline void candidate_vf(__ubuf__ float* xAddr, __ubuf__ float* yAddr,
                                    __ubuf__ float* yLogXTAddr) {
    uint32_t totalLen = 3072, oneRepeat = 64, repeatTimes = 48;
    __VEC_SCOPE__ {
        MaskReg pregUp;
        RegTensor<float> regX;
        RegTensor<float> regY;
        RegTensor<float> regTensorOne;
        RegTensor<float> regOneSubX;
        RegTensor<float> regOneSubY;
        RegTensor<float> regOneSubYLogX;
        RegTensor<float> regYLogX;
        RegTensor<float> regDataSum;
        RegTensor<float> regBinaryYLogX;

#pragma unroll 1

        for (uint16_t i = 0; i < (uint16_t)repeatTimes; i++) {
            pregUp = UpdateMask<float>(totalLen);
            DataCopy<float, PostLiteral::POST_MODE_UPDATE>(regX, xAddr, (int32_t)oneRepeat);
            DataCopy<float, PostLiteral::POST_MODE_UPDATE>(regY, yAddr, (int32_t)oneRepeat);

            CalcYLogX(regYLogX, regX, regY, pregUp);
            Duplicate(regTensorOne, (float)1.0f, pregUp);
            Sub(regOneSubX, regTensorOne, regX, pregUp);
            Sub(regOneSubY, regTensorOne, regY, pregUp);
            CalcYLogX(regOneSubYLogX, regOneSubX, regOneSubY, pregUp);
            Add(regDataSum, regYLogX, regOneSubYLogX, pregUp);
            Muls(regBinaryYLogX, regDataSum, (float)-1.0f, pregUp);

            DataCopy<float, PostLiteral::POST_MODE_UPDATE>(yLogXTAddr, regBinaryYLogX,
                                                           (int32_t)oneRepeat, pregUp);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* yAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* yLogXTAddr = (__ubuf__ float*)get_imm(24576);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 24576, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, yAddr, yLogXTAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)yLogXTAddr, 0, 1, 12288, 0, 0, 0);
}
