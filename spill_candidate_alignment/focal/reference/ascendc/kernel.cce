#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
namespace AscendC {
namespace Reg = MicroAPI;
}
using namespace AscendC;
using namespace AscendC::MicroAPI;
__aicore__ inline void candidate_vf(__ubuf__ float* pSrc, __ubuf__ float* pFloorSrc,
                                    __ubuf__ float* qGammaSrc, __ubuf__ float* qGamma1Src,
                                    __ubuf__ float* dst) {
    float alpha = 0.25f, gamma = 2.0f;
    uint32_t count = 1024;
    uint16_t repeatTimes = 16;
    __VEC_SCOPE__ {
        constexpr uint32_t kVl = 256 / sizeof(float);
        constexpr float kMinNormal = 1.17549435e-38f;
        constexpr float kMaxFloat = 3.402823466e+38f;
        AscendC::Reg::RegTensor<float> p, q, pFloor, qGamma, qGamma1, logP, reconstructed,
            corrected, original, lhs, rhs;
        AscendC::Reg::RegTensor<float> absOriginal, absLhs, absRhs, maxTerm, cancellationLimit;
        AscendC::Reg::MaskReg mask, cancellation, nonzeroTerms, qNormal, qGamma1Normal,
            qGamma1Finite;
        uint32_t remaining = count;
        for (uint16_t i = 0; i < repeatTimes; ++i) {
            const int32_t off = static_cast<int32_t>(i) * kVl;
            mask = AscendC::Reg::UpdateMask<float>(remaining);
            AscendC::Reg::LoadAlign(p, pSrc + off);
            AscendC::Reg::LoadAlign(pFloor, pFloorSrc + off);
            AscendC::Reg::LoadAlign(qGamma, qGammaSrc + off);
            AscendC::Reg::LoadAlign(qGamma1, qGamma1Src + off);
            AscendC::Reg::Ln(logP, pFloor, mask);
            AscendC::Reg::Neg(q, p, mask);
            AscendC::Reg::Adds(q, q, 1.0f, mask);
            AscendC::Reg::Mul(lhs, qGamma, logP, mask);
            AscendC::Reg::Mul(lhs, lhs, p, mask);
            AscendC::Reg::Muls(lhs, lhs, gamma * alpha, mask);
            AscendC::Reg::Muls(rhs, qGamma1, alpha, mask);
            AscendC::Reg::Sub(original, lhs, rhs, mask);
            AscendC::Reg::Div(reconstructed, qGamma1, q, mask);
            AscendC::Reg::Mul(corrected, reconstructed, logP, mask);
            AscendC::Reg::Mul(corrected, corrected, p, mask);
            AscendC::Reg::Muls(corrected, corrected, gamma * alpha, mask);
            AscendC::Reg::Sub(corrected, corrected, rhs, mask);
            AscendC::Reg::Abs(absOriginal, original, mask);
            AscendC::Reg::Abs(absLhs, lhs, mask);
            AscendC::Reg::Abs(absRhs, rhs, mask);
            AscendC::Reg::Max(maxTerm, absLhs, absRhs, mask);
            AscendC::Reg::Muls(cancellationLimit, maxTerm, 0.015625f, mask);
            AscendC::Reg::Compare<float, AscendC::CMPMODE::LE>(cancellation, absOriginal,
                                                               cancellationLimit, mask);
            AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(nonzeroTerms, maxTerm, kMinNormal,
                                                                mask);
            AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(qNormal, q, kMinNormal, mask);
            AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(qGamma1Normal, qGamma1, kMinNormal,
                                                                mask);
            AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(qGamma1Finite, qGamma1, kMaxFloat,
                                                                mask);
            AscendC::Reg::Select<float>(corrected, corrected, original, cancellation);
            AscendC::Reg::Select<float>(corrected, corrected, original, nonzeroTerms);
            AscendC::Reg::Select<float>(corrected, corrected, original, qNormal);
            AscendC::Reg::Select<float>(corrected, corrected, original, qGamma1Normal);
            AscendC::Reg::Select<float>(corrected, corrected, original, qGamma1Finite);
            AscendC::Reg::StoreAlign(dst + off, corrected, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* pSrc = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* pFloorSrc = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* qGammaSrc = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* qGamma1Src = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(pSrc, pFloorSrc, qGammaSrc, qGamma1Src, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dst, 0, 1, 4096, 0, 0, 0);
}
