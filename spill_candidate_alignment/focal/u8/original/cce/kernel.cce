#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* pSrc, __ubuf__ float* pFloorSrc,
                                    __ubuf__ float* qGammaSrc, __ubuf__ float* qGamma1Src,
                                    __ubuf__ float* dst) {
    float alpha = 0.25f, gamma = 2.0f;
    uint32_t count = 1024;
    uint16_t repeatTimes = 16;
    __VEC_SCOPE__ {
        constexpr uint32_t kVl = 256 / sizeof(float);
        constexpr float kMinNormal = 1.17549435e-38f;
        constexpr float kMaxFloat = 3.402823466e+38f;
        vector_f32 p, q, pFloor, qGamma, qGamma1, logP, reconstructed, corrected, original, lhs,
            rhs;
        vector_f32 absOriginal, absLhs, absRhs, maxTerm, cancellationLimit;
        vector_bool mask, cancellation, nonzeroTerms, qNormal, qGamma1Normal, qGamma1Finite;
        uint32_t remaining = count;
        {
            vector_f32 absLhs_u0;
            vector_f32 absLhs_u1;
            vector_f32 absLhs_u2;
            vector_f32 absLhs_u3;
            vector_f32 absLhs_u4;
            vector_f32 absLhs_u5;
            vector_f32 absLhs_u6;
            vector_f32 absLhs_u7;
            vector_f32 absOriginal_u0;
            vector_f32 absOriginal_u1;
            vector_f32 absOriginal_u2;
            vector_f32 absOriginal_u3;
            vector_f32 absOriginal_u4;
            vector_f32 absOriginal_u5;
            vector_f32 absOriginal_u6;
            vector_f32 absOriginal_u7;
            vector_f32 absRhs_u0;
            vector_f32 absRhs_u1;
            vector_f32 absRhs_u2;
            vector_f32 absRhs_u3;
            vector_f32 absRhs_u4;
            vector_f32 absRhs_u5;
            vector_f32 absRhs_u6;
            vector_f32 absRhs_u7;
            vector_bool cancellation_u0;
            vector_bool cancellation_u1;
            vector_bool cancellation_u2;
            vector_bool cancellation_u3;
            vector_bool cancellation_u4;
            vector_bool cancellation_u5;
            vector_bool cancellation_u6;
            vector_bool cancellation_u7;
            vector_f32 cancellationLimit_u0;
            vector_f32 cancellationLimit_u1;
            vector_f32 cancellationLimit_u2;
            vector_f32 cancellationLimit_u3;
            vector_f32 cancellationLimit_u4;
            vector_f32 cancellationLimit_u5;
            vector_f32 cancellationLimit_u6;
            vector_f32 cancellationLimit_u7;
            vector_f32 corrected_u0;
            vector_f32 corrected_u1;
            vector_f32 corrected_u2;
            vector_f32 corrected_u3;
            vector_f32 corrected_u4;
            vector_f32 corrected_u5;
            vector_f32 corrected_u6;
            vector_f32 corrected_u7;
            vector_f32 lhs_u0;
            vector_f32 lhs_u1;
            vector_f32 lhs_u2;
            vector_f32 lhs_u3;
            vector_f32 lhs_u4;
            vector_f32 lhs_u5;
            vector_f32 lhs_u6;
            vector_f32 lhs_u7;
            vector_f32 logP_u0;
            vector_f32 logP_u1;
            vector_f32 logP_u2;
            vector_f32 logP_u3;
            vector_f32 logP_u4;
            vector_f32 logP_u5;
            vector_f32 logP_u6;
            vector_f32 logP_u7;
            vector_bool mask_u0;
            vector_bool mask_u1;
            vector_bool mask_u2;
            vector_bool mask_u3;
            vector_bool mask_u4;
            vector_bool mask_u5;
            vector_bool mask_u6;
            vector_bool mask_u7;
            vector_f32 maxTerm_u0;
            vector_f32 maxTerm_u1;
            vector_f32 maxTerm_u2;
            vector_f32 maxTerm_u3;
            vector_f32 maxTerm_u4;
            vector_f32 maxTerm_u5;
            vector_f32 maxTerm_u6;
            vector_f32 maxTerm_u7;
            vector_bool nonzeroTerms_u0;
            vector_bool nonzeroTerms_u1;
            vector_bool nonzeroTerms_u2;
            vector_bool nonzeroTerms_u3;
            vector_bool nonzeroTerms_u4;
            vector_bool nonzeroTerms_u5;
            vector_bool nonzeroTerms_u6;
            vector_bool nonzeroTerms_u7;
            vector_f32 original_u0;
            vector_f32 original_u1;
            vector_f32 original_u2;
            vector_f32 original_u3;
            vector_f32 original_u4;
            vector_f32 original_u5;
            vector_f32 original_u6;
            vector_f32 original_u7;
            vector_f32 p_u0;
            vector_f32 p_u1;
            vector_f32 p_u2;
            vector_f32 p_u3;
            vector_f32 p_u4;
            vector_f32 p_u5;
            vector_f32 p_u6;
            vector_f32 p_u7;
            vector_f32 pFloor_u0;
            vector_f32 pFloor_u1;
            vector_f32 pFloor_u2;
            vector_f32 pFloor_u3;
            vector_f32 pFloor_u4;
            vector_f32 pFloor_u5;
            vector_f32 pFloor_u6;
            vector_f32 pFloor_u7;
            vector_f32 q_u0;
            vector_f32 q_u1;
            vector_f32 q_u2;
            vector_f32 q_u3;
            vector_f32 q_u4;
            vector_f32 q_u5;
            vector_f32 q_u6;
            vector_f32 q_u7;
            vector_f32 qGamma_u0;
            vector_f32 qGamma_u1;
            vector_f32 qGamma_u2;
            vector_f32 qGamma_u3;
            vector_f32 qGamma_u4;
            vector_f32 qGamma_u5;
            vector_f32 qGamma_u6;
            vector_f32 qGamma_u7;
            vector_f32 qGamma1_u0;
            vector_f32 qGamma1_u1;
            vector_f32 qGamma1_u2;
            vector_f32 qGamma1_u3;
            vector_f32 qGamma1_u4;
            vector_f32 qGamma1_u5;
            vector_f32 qGamma1_u6;
            vector_f32 qGamma1_u7;
            vector_bool qGamma1Finite_u0;
            vector_bool qGamma1Finite_u1;
            vector_bool qGamma1Finite_u2;
            vector_bool qGamma1Finite_u3;
            vector_bool qGamma1Finite_u4;
            vector_bool qGamma1Finite_u5;
            vector_bool qGamma1Finite_u6;
            vector_bool qGamma1Finite_u7;
            vector_bool qGamma1Normal_u0;
            vector_bool qGamma1Normal_u1;
            vector_bool qGamma1Normal_u2;
            vector_bool qGamma1Normal_u3;
            vector_bool qGamma1Normal_u4;
            vector_bool qGamma1Normal_u5;
            vector_bool qGamma1Normal_u6;
            vector_bool qGamma1Normal_u7;
            vector_bool qNormal_u0;
            vector_bool qNormal_u1;
            vector_bool qNormal_u2;
            vector_bool qNormal_u3;
            vector_bool qNormal_u4;
            vector_bool qNormal_u5;
            vector_bool qNormal_u6;
            vector_bool qNormal_u7;
            vector_f32 reconstructed_u0;
            vector_f32 reconstructed_u1;
            vector_f32 reconstructed_u2;
            vector_f32 reconstructed_u3;
            vector_f32 reconstructed_u4;
            vector_f32 reconstructed_u5;
            vector_f32 reconstructed_u6;
            vector_f32 reconstructed_u7;
            vector_f32 rhs_u0;
            vector_f32 rhs_u1;
            vector_f32 rhs_u2;
            vector_f32 rhs_u3;
            vector_f32 rhs_u4;
            vector_f32 rhs_u5;
            vector_f32 rhs_u6;
            vector_f32 rhs_u7;
#pragma unroll 1
            for (uint16_t i = 0; i < 16; i += 8) {
                const int32_t off_u0 = static_cast<int32_t>((i + 0)) * kVl;
                const int32_t off_u1 = static_cast<int32_t>((i + 1)) * kVl;
                const int32_t off_u2 = static_cast<int32_t>((i + 2)) * kVl;
                const int32_t off_u3 = static_cast<int32_t>((i + 3)) * kVl;
                const int32_t off_u4 = static_cast<int32_t>((i + 4)) * kVl;
                const int32_t off_u5 = static_cast<int32_t>((i + 5)) * kVl;
                const int32_t off_u6 = static_cast<int32_t>((i + 6)) * kVl;
                const int32_t off_u7 = static_cast<int32_t>((i + 7)) * kVl;
                mask_u0 = plt_b32(remaining, POST_UPDATE);
                mask_u1 = plt_b32(remaining, POST_UPDATE);
                mask_u2 = plt_b32(remaining, POST_UPDATE);
                mask_u3 = plt_b32(remaining, POST_UPDATE);
                mask_u4 = plt_b32(remaining, POST_UPDATE);
                mask_u5 = plt_b32(remaining, POST_UPDATE);
                mask_u6 = plt_b32(remaining, POST_UPDATE);
                mask_u7 = plt_b32(remaining, POST_UPDATE);
                vlds(p_u0, pSrc + off_u0, 0, NORM);
                vlds(p_u1, pSrc + off_u1, 0, NORM);
                vlds(p_u2, pSrc + off_u2, 0, NORM);
                vlds(p_u3, pSrc + off_u3, 0, NORM);
                vlds(p_u4, pSrc + off_u4, 0, NORM);
                vlds(p_u5, pSrc + off_u5, 0, NORM);
                vlds(p_u6, pSrc + off_u6, 0, NORM);
                vlds(p_u7, pSrc + off_u7, 0, NORM);
                vlds(pFloor_u0, pFloorSrc + off_u0, 0, NORM);
                vlds(pFloor_u1, pFloorSrc + off_u1, 0, NORM);
                vlds(pFloor_u2, pFloorSrc + off_u2, 0, NORM);
                vlds(pFloor_u3, pFloorSrc + off_u3, 0, NORM);
                vlds(pFloor_u4, pFloorSrc + off_u4, 0, NORM);
                vlds(pFloor_u5, pFloorSrc + off_u5, 0, NORM);
                vlds(pFloor_u6, pFloorSrc + off_u6, 0, NORM);
                vlds(pFloor_u7, pFloorSrc + off_u7, 0, NORM);
                vlds(qGamma_u0, qGammaSrc + off_u0, 0, NORM);
                vlds(qGamma_u1, qGammaSrc + off_u1, 0, NORM);
                vlds(qGamma_u2, qGammaSrc + off_u2, 0, NORM);
                vlds(qGamma_u3, qGammaSrc + off_u3, 0, NORM);
                vlds(qGamma_u4, qGammaSrc + off_u4, 0, NORM);
                vlds(qGamma_u5, qGammaSrc + off_u5, 0, NORM);
                vlds(qGamma_u6, qGammaSrc + off_u6, 0, NORM);
                vlds(qGamma_u7, qGammaSrc + off_u7, 0, NORM);
                vlds(qGamma1_u0, qGamma1Src + off_u0, 0, NORM);
                vlds(qGamma1_u1, qGamma1Src + off_u1, 0, NORM);
                vlds(qGamma1_u2, qGamma1Src + off_u2, 0, NORM);
                vlds(qGamma1_u3, qGamma1Src + off_u3, 0, NORM);
                vlds(qGamma1_u4, qGamma1Src + off_u4, 0, NORM);
                vlds(qGamma1_u5, qGamma1Src + off_u5, 0, NORM);
                vlds(qGamma1_u6, qGamma1Src + off_u6, 0, NORM);
                vlds(qGamma1_u7, qGamma1Src + off_u7, 0, NORM);
                vln(logP_u0, pFloor_u0, mask_u0, MODE_ZEROING);
                vln(logP_u1, pFloor_u1, mask_u1, MODE_ZEROING);
                vln(logP_u2, pFloor_u2, mask_u2, MODE_ZEROING);
                vln(logP_u3, pFloor_u3, mask_u3, MODE_ZEROING);
                vln(logP_u4, pFloor_u4, mask_u4, MODE_ZEROING);
                vln(logP_u5, pFloor_u5, mask_u5, MODE_ZEROING);
                vln(logP_u6, pFloor_u6, mask_u6, MODE_ZEROING);
                vln(logP_u7, pFloor_u7, mask_u7, MODE_ZEROING);
                vmuls(q_u0, p_u0, -1.0f, mask_u0, MODE_ZEROING);
                vmuls(q_u1, p_u1, -1.0f, mask_u1, MODE_ZEROING);
                vmuls(q_u2, p_u2, -1.0f, mask_u2, MODE_ZEROING);
                vmuls(q_u3, p_u3, -1.0f, mask_u3, MODE_ZEROING);
                vmuls(q_u4, p_u4, -1.0f, mask_u4, MODE_ZEROING);
                vmuls(q_u5, p_u5, -1.0f, mask_u5, MODE_ZEROING);
                vmuls(q_u6, p_u6, -1.0f, mask_u6, MODE_ZEROING);
                vmuls(q_u7, p_u7, -1.0f, mask_u7, MODE_ZEROING);
                vadds(q_u0, q_u0, 1.0f, mask_u0, MODE_ZEROING);
                vadds(q_u1, q_u1, 1.0f, mask_u1, MODE_ZEROING);
                vadds(q_u2, q_u2, 1.0f, mask_u2, MODE_ZEROING);
                vadds(q_u3, q_u3, 1.0f, mask_u3, MODE_ZEROING);
                vadds(q_u4, q_u4, 1.0f, mask_u4, MODE_ZEROING);
                vadds(q_u5, q_u5, 1.0f, mask_u5, MODE_ZEROING);
                vadds(q_u6, q_u6, 1.0f, mask_u6, MODE_ZEROING);
                vadds(q_u7, q_u7, 1.0f, mask_u7, MODE_ZEROING);
                vmul(lhs_u0, qGamma_u0, logP_u0, mask_u0, MODE_ZEROING);
                vmul(lhs_u1, qGamma_u1, logP_u1, mask_u1, MODE_ZEROING);
                vmul(lhs_u2, qGamma_u2, logP_u2, mask_u2, MODE_ZEROING);
                vmul(lhs_u3, qGamma_u3, logP_u3, mask_u3, MODE_ZEROING);
                vmul(lhs_u4, qGamma_u4, logP_u4, mask_u4, MODE_ZEROING);
                vmul(lhs_u5, qGamma_u5, logP_u5, mask_u5, MODE_ZEROING);
                vmul(lhs_u6, qGamma_u6, logP_u6, mask_u6, MODE_ZEROING);
                vmul(lhs_u7, qGamma_u7, logP_u7, mask_u7, MODE_ZEROING);
                vmul(lhs_u0, lhs_u0, p_u0, mask_u0, MODE_ZEROING);
                vmul(lhs_u1, lhs_u1, p_u1, mask_u1, MODE_ZEROING);
                vmul(lhs_u2, lhs_u2, p_u2, mask_u2, MODE_ZEROING);
                vmul(lhs_u3, lhs_u3, p_u3, mask_u3, MODE_ZEROING);
                vmul(lhs_u4, lhs_u4, p_u4, mask_u4, MODE_ZEROING);
                vmul(lhs_u5, lhs_u5, p_u5, mask_u5, MODE_ZEROING);
                vmul(lhs_u6, lhs_u6, p_u6, mask_u6, MODE_ZEROING);
                vmul(lhs_u7, lhs_u7, p_u7, mask_u7, MODE_ZEROING);
                vmuls(lhs_u0, lhs_u0, gamma * alpha, mask_u0, MODE_ZEROING);
                vmuls(lhs_u1, lhs_u1, gamma * alpha, mask_u1, MODE_ZEROING);
                vmuls(lhs_u2, lhs_u2, gamma * alpha, mask_u2, MODE_ZEROING);
                vmuls(lhs_u3, lhs_u3, gamma * alpha, mask_u3, MODE_ZEROING);
                vmuls(lhs_u4, lhs_u4, gamma * alpha, mask_u4, MODE_ZEROING);
                vmuls(lhs_u5, lhs_u5, gamma * alpha, mask_u5, MODE_ZEROING);
                vmuls(lhs_u6, lhs_u6, gamma * alpha, mask_u6, MODE_ZEROING);
                vmuls(lhs_u7, lhs_u7, gamma * alpha, mask_u7, MODE_ZEROING);
                vmuls(rhs_u0, qGamma1_u0, alpha, mask_u0, MODE_ZEROING);
                vmuls(rhs_u1, qGamma1_u1, alpha, mask_u1, MODE_ZEROING);
                vmuls(rhs_u2, qGamma1_u2, alpha, mask_u2, MODE_ZEROING);
                vmuls(rhs_u3, qGamma1_u3, alpha, mask_u3, MODE_ZEROING);
                vmuls(rhs_u4, qGamma1_u4, alpha, mask_u4, MODE_ZEROING);
                vmuls(rhs_u5, qGamma1_u5, alpha, mask_u5, MODE_ZEROING);
                vmuls(rhs_u6, qGamma1_u6, alpha, mask_u6, MODE_ZEROING);
                vmuls(rhs_u7, qGamma1_u7, alpha, mask_u7, MODE_ZEROING);
                vsub(original_u0, lhs_u0, rhs_u0, mask_u0, MODE_ZEROING);
                vsub(original_u1, lhs_u1, rhs_u1, mask_u1, MODE_ZEROING);
                vsub(original_u2, lhs_u2, rhs_u2, mask_u2, MODE_ZEROING);
                vsub(original_u3, lhs_u3, rhs_u3, mask_u3, MODE_ZEROING);
                vsub(original_u4, lhs_u4, rhs_u4, mask_u4, MODE_ZEROING);
                vsub(original_u5, lhs_u5, rhs_u5, mask_u5, MODE_ZEROING);
                vsub(original_u6, lhs_u6, rhs_u6, mask_u6, MODE_ZEROING);
                vsub(original_u7, lhs_u7, rhs_u7, mask_u7, MODE_ZEROING);
                vdiv(reconstructed_u0, qGamma1_u0, q_u0, mask_u0, MODE_ZEROING);
                vdiv(reconstructed_u1, qGamma1_u1, q_u1, mask_u1, MODE_ZEROING);
                vdiv(reconstructed_u2, qGamma1_u2, q_u2, mask_u2, MODE_ZEROING);
                vdiv(reconstructed_u3, qGamma1_u3, q_u3, mask_u3, MODE_ZEROING);
                vdiv(reconstructed_u4, qGamma1_u4, q_u4, mask_u4, MODE_ZEROING);
                vdiv(reconstructed_u5, qGamma1_u5, q_u5, mask_u5, MODE_ZEROING);
                vdiv(reconstructed_u6, qGamma1_u6, q_u6, mask_u6, MODE_ZEROING);
                vdiv(reconstructed_u7, qGamma1_u7, q_u7, mask_u7, MODE_ZEROING);
                vmul(corrected_u0, reconstructed_u0, logP_u0, mask_u0, MODE_ZEROING);
                vmul(corrected_u1, reconstructed_u1, logP_u1, mask_u1, MODE_ZEROING);
                vmul(corrected_u2, reconstructed_u2, logP_u2, mask_u2, MODE_ZEROING);
                vmul(corrected_u3, reconstructed_u3, logP_u3, mask_u3, MODE_ZEROING);
                vmul(corrected_u4, reconstructed_u4, logP_u4, mask_u4, MODE_ZEROING);
                vmul(corrected_u5, reconstructed_u5, logP_u5, mask_u5, MODE_ZEROING);
                vmul(corrected_u6, reconstructed_u6, logP_u6, mask_u6, MODE_ZEROING);
                vmul(corrected_u7, reconstructed_u7, logP_u7, mask_u7, MODE_ZEROING);
                vmul(corrected_u0, corrected_u0, p_u0, mask_u0, MODE_ZEROING);
                vmul(corrected_u1, corrected_u1, p_u1, mask_u1, MODE_ZEROING);
                vmul(corrected_u2, corrected_u2, p_u2, mask_u2, MODE_ZEROING);
                vmul(corrected_u3, corrected_u3, p_u3, mask_u3, MODE_ZEROING);
                vmul(corrected_u4, corrected_u4, p_u4, mask_u4, MODE_ZEROING);
                vmul(corrected_u5, corrected_u5, p_u5, mask_u5, MODE_ZEROING);
                vmul(corrected_u6, corrected_u6, p_u6, mask_u6, MODE_ZEROING);
                vmul(corrected_u7, corrected_u7, p_u7, mask_u7, MODE_ZEROING);
                vmuls(corrected_u0, corrected_u0, gamma * alpha, mask_u0, MODE_ZEROING);
                vmuls(corrected_u1, corrected_u1, gamma * alpha, mask_u1, MODE_ZEROING);
                vmuls(corrected_u2, corrected_u2, gamma * alpha, mask_u2, MODE_ZEROING);
                vmuls(corrected_u3, corrected_u3, gamma * alpha, mask_u3, MODE_ZEROING);
                vmuls(corrected_u4, corrected_u4, gamma * alpha, mask_u4, MODE_ZEROING);
                vmuls(corrected_u5, corrected_u5, gamma * alpha, mask_u5, MODE_ZEROING);
                vmuls(corrected_u6, corrected_u6, gamma * alpha, mask_u6, MODE_ZEROING);
                vmuls(corrected_u7, corrected_u7, gamma * alpha, mask_u7, MODE_ZEROING);
                vsub(corrected_u0, corrected_u0, rhs_u0, mask_u0, MODE_ZEROING);
                vsub(corrected_u1, corrected_u1, rhs_u1, mask_u1, MODE_ZEROING);
                vsub(corrected_u2, corrected_u2, rhs_u2, mask_u2, MODE_ZEROING);
                vsub(corrected_u3, corrected_u3, rhs_u3, mask_u3, MODE_ZEROING);
                vsub(corrected_u4, corrected_u4, rhs_u4, mask_u4, MODE_ZEROING);
                vsub(corrected_u5, corrected_u5, rhs_u5, mask_u5, MODE_ZEROING);
                vsub(corrected_u6, corrected_u6, rhs_u6, mask_u6, MODE_ZEROING);
                vsub(corrected_u7, corrected_u7, rhs_u7, mask_u7, MODE_ZEROING);
                vabs(absOriginal_u0, original_u0, mask_u0, MODE_ZEROING);
                vabs(absOriginal_u1, original_u1, mask_u1, MODE_ZEROING);
                vabs(absOriginal_u2, original_u2, mask_u2, MODE_ZEROING);
                vabs(absOriginal_u3, original_u3, mask_u3, MODE_ZEROING);
                vabs(absOriginal_u4, original_u4, mask_u4, MODE_ZEROING);
                vabs(absOriginal_u5, original_u5, mask_u5, MODE_ZEROING);
                vabs(absOriginal_u6, original_u6, mask_u6, MODE_ZEROING);
                vabs(absOriginal_u7, original_u7, mask_u7, MODE_ZEROING);
                vabs(absLhs_u0, lhs_u0, mask_u0, MODE_ZEROING);
                vabs(absLhs_u1, lhs_u1, mask_u1, MODE_ZEROING);
                vabs(absLhs_u2, lhs_u2, mask_u2, MODE_ZEROING);
                vabs(absLhs_u3, lhs_u3, mask_u3, MODE_ZEROING);
                vabs(absLhs_u4, lhs_u4, mask_u4, MODE_ZEROING);
                vabs(absLhs_u5, lhs_u5, mask_u5, MODE_ZEROING);
                vabs(absLhs_u6, lhs_u6, mask_u6, MODE_ZEROING);
                vabs(absLhs_u7, lhs_u7, mask_u7, MODE_ZEROING);
                vabs(absRhs_u0, rhs_u0, mask_u0, MODE_ZEROING);
                vabs(absRhs_u1, rhs_u1, mask_u1, MODE_ZEROING);
                vabs(absRhs_u2, rhs_u2, mask_u2, MODE_ZEROING);
                vabs(absRhs_u3, rhs_u3, mask_u3, MODE_ZEROING);
                vabs(absRhs_u4, rhs_u4, mask_u4, MODE_ZEROING);
                vabs(absRhs_u5, rhs_u5, mask_u5, MODE_ZEROING);
                vabs(absRhs_u6, rhs_u6, mask_u6, MODE_ZEROING);
                vabs(absRhs_u7, rhs_u7, mask_u7, MODE_ZEROING);
                vmax(maxTerm_u0, absLhs_u0, absRhs_u0, mask_u0, MODE_ZEROING);
                vmax(maxTerm_u1, absLhs_u1, absRhs_u1, mask_u1, MODE_ZEROING);
                vmax(maxTerm_u2, absLhs_u2, absRhs_u2, mask_u2, MODE_ZEROING);
                vmax(maxTerm_u3, absLhs_u3, absRhs_u3, mask_u3, MODE_ZEROING);
                vmax(maxTerm_u4, absLhs_u4, absRhs_u4, mask_u4, MODE_ZEROING);
                vmax(maxTerm_u5, absLhs_u5, absRhs_u5, mask_u5, MODE_ZEROING);
                vmax(maxTerm_u6, absLhs_u6, absRhs_u6, mask_u6, MODE_ZEROING);
                vmax(maxTerm_u7, absLhs_u7, absRhs_u7, mask_u7, MODE_ZEROING);
                vmuls(cancellationLimit_u0, maxTerm_u0, 0.015625f, mask_u0, MODE_ZEROING);
                vmuls(cancellationLimit_u1, maxTerm_u1, 0.015625f, mask_u1, MODE_ZEROING);
                vmuls(cancellationLimit_u2, maxTerm_u2, 0.015625f, mask_u2, MODE_ZEROING);
                vmuls(cancellationLimit_u3, maxTerm_u3, 0.015625f, mask_u3, MODE_ZEROING);
                vmuls(cancellationLimit_u4, maxTerm_u4, 0.015625f, mask_u4, MODE_ZEROING);
                vmuls(cancellationLimit_u5, maxTerm_u5, 0.015625f, mask_u5, MODE_ZEROING);
                vmuls(cancellationLimit_u6, maxTerm_u6, 0.015625f, mask_u6, MODE_ZEROING);
                vmuls(cancellationLimit_u7, maxTerm_u7, 0.015625f, mask_u7, MODE_ZEROING);
                vcmp_le(cancellation_u0, absOriginal_u0, cancellationLimit_u0, mask_u0);
                vcmp_le(cancellation_u1, absOriginal_u1, cancellationLimit_u1, mask_u1);
                vcmp_le(cancellation_u2, absOriginal_u2, cancellationLimit_u2, mask_u2);
                vcmp_le(cancellation_u3, absOriginal_u3, cancellationLimit_u3, mask_u3);
                vcmp_le(cancellation_u4, absOriginal_u4, cancellationLimit_u4, mask_u4);
                vcmp_le(cancellation_u5, absOriginal_u5, cancellationLimit_u5, mask_u5);
                vcmp_le(cancellation_u6, absOriginal_u6, cancellationLimit_u6, mask_u6);
                vcmp_le(cancellation_u7, absOriginal_u7, cancellationLimit_u7, mask_u7);
                vcmps_gt(nonzeroTerms_u0, maxTerm_u0, kMinNormal, mask_u0);
                vcmps_gt(nonzeroTerms_u1, maxTerm_u1, kMinNormal, mask_u1);
                vcmps_gt(nonzeroTerms_u2, maxTerm_u2, kMinNormal, mask_u2);
                vcmps_gt(nonzeroTerms_u3, maxTerm_u3, kMinNormal, mask_u3);
                vcmps_gt(nonzeroTerms_u4, maxTerm_u4, kMinNormal, mask_u4);
                vcmps_gt(nonzeroTerms_u5, maxTerm_u5, kMinNormal, mask_u5);
                vcmps_gt(nonzeroTerms_u6, maxTerm_u6, kMinNormal, mask_u6);
                vcmps_gt(nonzeroTerms_u7, maxTerm_u7, kMinNormal, mask_u7);
                vcmps_gt(qNormal_u0, q_u0, kMinNormal, mask_u0);
                vcmps_gt(qNormal_u1, q_u1, kMinNormal, mask_u1);
                vcmps_gt(qNormal_u2, q_u2, kMinNormal, mask_u2);
                vcmps_gt(qNormal_u3, q_u3, kMinNormal, mask_u3);
                vcmps_gt(qNormal_u4, q_u4, kMinNormal, mask_u4);
                vcmps_gt(qNormal_u5, q_u5, kMinNormal, mask_u5);
                vcmps_gt(qNormal_u6, q_u6, kMinNormal, mask_u6);
                vcmps_gt(qNormal_u7, q_u7, kMinNormal, mask_u7);
                vcmps_gt(qGamma1Normal_u0, qGamma1_u0, kMinNormal, mask_u0);
                vcmps_gt(qGamma1Normal_u1, qGamma1_u1, kMinNormal, mask_u1);
                vcmps_gt(qGamma1Normal_u2, qGamma1_u2, kMinNormal, mask_u2);
                vcmps_gt(qGamma1Normal_u3, qGamma1_u3, kMinNormal, mask_u3);
                vcmps_gt(qGamma1Normal_u4, qGamma1_u4, kMinNormal, mask_u4);
                vcmps_gt(qGamma1Normal_u5, qGamma1_u5, kMinNormal, mask_u5);
                vcmps_gt(qGamma1Normal_u6, qGamma1_u6, kMinNormal, mask_u6);
                vcmps_gt(qGamma1Normal_u7, qGamma1_u7, kMinNormal, mask_u7);
                vcmps_le(qGamma1Finite_u0, qGamma1_u0, kMaxFloat, mask_u0);
                vcmps_le(qGamma1Finite_u1, qGamma1_u1, kMaxFloat, mask_u1);
                vcmps_le(qGamma1Finite_u2, qGamma1_u2, kMaxFloat, mask_u2);
                vcmps_le(qGamma1Finite_u3, qGamma1_u3, kMaxFloat, mask_u3);
                vcmps_le(qGamma1Finite_u4, qGamma1_u4, kMaxFloat, mask_u4);
                vcmps_le(qGamma1Finite_u5, qGamma1_u5, kMaxFloat, mask_u5);
                vcmps_le(qGamma1Finite_u6, qGamma1_u6, kMaxFloat, mask_u6);
                vcmps_le(qGamma1Finite_u7, qGamma1_u7, kMaxFloat, mask_u7);
                vsel(corrected_u0, corrected_u0, original_u0, cancellation_u0);
                vsel(corrected_u1, corrected_u1, original_u1, cancellation_u1);
                vsel(corrected_u2, corrected_u2, original_u2, cancellation_u2);
                vsel(corrected_u3, corrected_u3, original_u3, cancellation_u3);
                vsel(corrected_u4, corrected_u4, original_u4, cancellation_u4);
                vsel(corrected_u5, corrected_u5, original_u5, cancellation_u5);
                vsel(corrected_u6, corrected_u6, original_u6, cancellation_u6);
                vsel(corrected_u7, corrected_u7, original_u7, cancellation_u7);
                vsel(corrected_u0, corrected_u0, original_u0, nonzeroTerms_u0);
                vsel(corrected_u1, corrected_u1, original_u1, nonzeroTerms_u1);
                vsel(corrected_u2, corrected_u2, original_u2, nonzeroTerms_u2);
                vsel(corrected_u3, corrected_u3, original_u3, nonzeroTerms_u3);
                vsel(corrected_u4, corrected_u4, original_u4, nonzeroTerms_u4);
                vsel(corrected_u5, corrected_u5, original_u5, nonzeroTerms_u5);
                vsel(corrected_u6, corrected_u6, original_u6, nonzeroTerms_u6);
                vsel(corrected_u7, corrected_u7, original_u7, nonzeroTerms_u7);
                vsel(corrected_u0, corrected_u0, original_u0, qNormal_u0);
                vsel(corrected_u1, corrected_u1, original_u1, qNormal_u1);
                vsel(corrected_u2, corrected_u2, original_u2, qNormal_u2);
                vsel(corrected_u3, corrected_u3, original_u3, qNormal_u3);
                vsel(corrected_u4, corrected_u4, original_u4, qNormal_u4);
                vsel(corrected_u5, corrected_u5, original_u5, qNormal_u5);
                vsel(corrected_u6, corrected_u6, original_u6, qNormal_u6);
                vsel(corrected_u7, corrected_u7, original_u7, qNormal_u7);
                vsel(corrected_u0, corrected_u0, original_u0, qGamma1Normal_u0);
                vsel(corrected_u1, corrected_u1, original_u1, qGamma1Normal_u1);
                vsel(corrected_u2, corrected_u2, original_u2, qGamma1Normal_u2);
                vsel(corrected_u3, corrected_u3, original_u3, qGamma1Normal_u3);
                vsel(corrected_u4, corrected_u4, original_u4, qGamma1Normal_u4);
                vsel(corrected_u5, corrected_u5, original_u5, qGamma1Normal_u5);
                vsel(corrected_u6, corrected_u6, original_u6, qGamma1Normal_u6);
                vsel(corrected_u7, corrected_u7, original_u7, qGamma1Normal_u7);
                vsel(corrected_u0, corrected_u0, original_u0, qGamma1Finite_u0);
                vsel(corrected_u1, corrected_u1, original_u1, qGamma1Finite_u1);
                vsel(corrected_u2, corrected_u2, original_u2, qGamma1Finite_u2);
                vsel(corrected_u3, corrected_u3, original_u3, qGamma1Finite_u3);
                vsel(corrected_u4, corrected_u4, original_u4, qGamma1Finite_u4);
                vsel(corrected_u5, corrected_u5, original_u5, qGamma1Finite_u5);
                vsel(corrected_u6, corrected_u6, original_u6, qGamma1Finite_u6);
                vsel(corrected_u7, corrected_u7, original_u7, qGamma1Finite_u7);
                vsts(corrected_u0, dst + off_u0, 0, NORM_B32, mask_u0);
                vsts(corrected_u1, dst + off_u1, 0, NORM_B32, mask_u1);
                vsts(corrected_u2, dst + off_u2, 0, NORM_B32, mask_u2);
                vsts(corrected_u3, dst + off_u3, 0, NORM_B32, mask_u3);
                vsts(corrected_u4, dst + off_u4, 0, NORM_B32, mask_u4);
                vsts(corrected_u5, dst + off_u5, 0, NORM_B32, mask_u5);
                vsts(corrected_u6, dst + off_u6, 0, NORM_B32, mask_u6);
                vsts(corrected_u7, dst + off_u7, 0, NORM_B32, mask_u7);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* pSrc = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* pFloorSrc = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* qGammaSrc = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* qGamma1Src = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(pSrc, pFloorSrc, qGammaSrc, qGamma1Src, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dst, 0, 1, 4096, 0, 0, 0);
}
